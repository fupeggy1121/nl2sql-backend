# ══════════════════════════════════════════════
# 生产环境：自托管 PostgreSQL
# 切换命令: cp .env.prod .env
# ══════════════════════════════════════════════

# ── 数据库后端选择 ──────────────────────────────
DB_BACKEND=postgres

# ── 语义层：本体映射文件 ────────────────────────
# 创建生产库对应的映射文件后，填写文件名（放在 app/ontology/data/ 目录下）
MAPPING_FILE=mapping_prod.json

# ── 生产库直连（psycopg2，DB_BACKEND=postgres 时使用）──
# 格式: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://root:YOUR_PASSWORD@YOUR_PROD_HOST:5432/YOUR_DB

# ── Supabase（生产环境不用，留空即可）───────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ── LLM ────────────────────────────────────────
DEEPSEEK_API_KEY=sk-eeeddf2376b0404c88071ee33221ad1d
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=deepseek

GLM_API_KEY=e2bff749433649bf891bdae85f2290a5.LvZy7BCl1QRIDzd2
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# ── 应用 ────────────────────────────────────────
FLASK_ENV=production
FLASK_APP=run.py
DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_KEY
PORT=8000
