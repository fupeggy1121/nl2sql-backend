  "relation_mappings": [
    {
      "logic_relation": "semi:belongsToLot",
      "description": "Wafer 属于哪个 Lot(批次)",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "wafers",
        "source_key": "batch_id",
        "target_table": "batches",
        "target_key": "id"
      }
    },
    {
      "logic_relation": "semi:belongsToSublot",
      "description": "Wafer 属于哪个 Sublot(子批次)，通过桥接表",
      "strategy": "JoinTable",
      "join_logic": {
        "bridge_table": "wafer_carrier_contents",
        "source_key": "wafer_id",
        "target_key": "sub_batch_id",
        "source_table": "wafers",
        "source_pk": "id",
        "target_table": "sub_batches",
        "target_pk": "id"
      }
    },
    {
      "logic_relation": "semi:locatedInSlot",
      "description": "Wafer 位于哪个载具槽位，通过桥接表",
      "strategy": "JoinTable",
      "join_logic": {
        "bridge_table": "wafer_carrier_contents",
        "source_key": "wafer_id",
        "target_key": "carrier_id",
        "source_table": "wafers",
        "source_pk": "id",
        "target_table": "carriers",
        "target_pk": "id"
      }
    },
    {
      "logic_relation": "semi:atStation",
      "description": "Wafer 当前所处工序 — 通过 sub_batches 的 current_station_id",
      "strategy": "Indirect",
      "join_logic": {
        "path": [
          {"from_table": "wafers", "from_key": "batch_id", "to_table": "batches", "to_key": "id"},
          {"from_table": "batches", "from_key": "id", "to_table": "sub_batches", "to_key": "batch_id"},
          {"from_table": "sub_batches", "from_key": "current_station_id", "to_table": "stations", "to_key": "id"}
        ]
      }
    },
    {
      "logic_relation": "semi:basedOnOrder",
      "description": "Lot(批次) 基于哪个 ProductionOrder(工单)",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "batches",
        "source_key": "product_code",
        "target_table": "production_orders",
        "target_key": "product_ref_id",
        "note": "逻辑外键：batches 通过 product_code 与 production_orders 关联"
      }
    },
    {
      "logic_relation": "semi:containsSublot",
      "description": "Lot(批次) 包含哪些 Sublot(子批次)",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "batches",
        "source_key": "id",
        "target_table": "sub_batches",
        "target_key": "batch_id"
      }
    },
    {
      "logic_relation": "semi:isCarriedBy",
      "description": "Sublot 由哪个载具承载",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "sub_batches",
        "source_key": "current_carrier_id",
        "target_table": "carriers",
        "target_key": "id"
      }
    },
    {
      "logic_relation": "semi:usesRoute",
      "description": "ProductModel 使用哪条工艺路线",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "products",
        "source_key": "main_process_route_id",
        "target_table": "process_routes",
        "target_key": "id"
      }
    },
    {
      "logic_relation": "semi:consistsOfStation",
      "description": "Route 包含哪些工序节点（有序）",
      "strategy": "JoinTable",
      "join_logic": {
        "bridge_table": "process_route_stations",
        "source_key": "route_id",
        "target_key": "station_id",
        "source_table": "process_routes",
        "source_pk": "id",
        "target_table": "stations",
        "target_pk": "id",
        "order_by": "sequence"
      }
    },
    {
      "logic_relation": "semi:definesRequirementFor",
      "description": "ProductionOrder 定义了哪个产品的规格需求",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "production_orders",
        "source_key": "product_ref_id",
        "target_table": "products",
        "target_key": "supabase_id"
      }
    },
    {
      "logic_relation": "semi:hasParentLot",
      "description": "Lot 的父批次（递归追溯）",
      "strategy": "Recursive",
      "join_logic": {
        "table": "batches",
        "self_key": "id",
        "parent_key": "parent_batch_id",
        "max_depth": 20,
        "note": "需要 WITH RECURSIVE CTE；parent_batch_id 字段可能需要确认是否存在"
      }
    },
    {
      "logic_relation": "semi:requiresEquipment",
      "description": "ProcessStation 要求哪些设备",
      "strategy": "Denormalized",
      "join_logic": {
        "source_table": "stations",
        "jsonb_column": "equipment_group_ids",
        "target_table": "equipment",
        "target_key": "equipment_group_id",
        "note": "stations.equipment_group_ids 是 jsonb 数组，存储 equipment_group 的 ID"
      }
    }
  ],

