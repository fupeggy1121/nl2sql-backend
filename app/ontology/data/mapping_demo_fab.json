{
  "version": "2026-V3",
  "customer": "Demo_Fab",
  "description": "半导体CIM本体→Supabase物理表映射字典（TTL-first，v3全量对齐semi-cim-ontology.ttl）",
  "object_mappings": [
    {
      "logic_class": "semi:Wafer",
      "physical_table": "wafers",
      "primary_key": "id",
      "label_cn": "晶圆",
      "display_column": "wafer_id_code",
      "properties": {
        "semi:hasState": null
      },
      "key_columns": [
        "id",
        "wafer_id_code",
        "batch_id",
        "initial_product_version",
        "created_at",
        "updated_at"
      ],
      "note": "最小物理实体标识。wafers.batch_id→batches.id 是核心锚点。slot/carrier位置信息在 wafer_carrier_contents 桥接表中。"
    },
    {
      "logic_class": "semi:ProductionLot",
      "physical_table": "batches",
      "primary_key": "id",
      "label_cn": "生产批次",
      "display_column": "batch_code",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "batch_code",
        "product_code",
        "product_name",
        "total_qty",
        "good_qty",
        "defect_qty",
        "status",
        "current_station_code",
        "current_station_name",
        "equipment_code",
        "equipment_name",
        "work_order_id"
      ]
    },
    {
      "logic_class": "semi:Sublot",
      "physical_table": "sub_batches",
      "primary_key": "id",
      "label_cn": "子批次",
      "display_column": "sub_batch_code",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "batch_id",
        "sub_batch_code",
        "current_carrier_id",
        "current_station_id",
        "total_qty",
        "good_qty",
        "defect_qty",
        "status",
        "created_at",
        "updated_at"
      ]
    },
    {
      "logic_class": "semi:ProcessStation",
      "physical_table": "stations",
      "primary_key": "id",
      "label_cn": "工艺站点(工序)",
      "display_column": "name",
      "properties": {},
      "key_columns": [
        "id",
        "code",
        "name",
        "description",
        "workshop",
        "station_type",
        "equipment_group",
        "tool_group",
        "linked_processing_station_id",
        "auto_entry",
        "auto_exit"
      ]
    },
    {
      "logic_class": "semi:Equipment",
      "physical_table": "equipment",
      "primary_key": "id",
      "label_cn": "设备",
      "display_column": "name",
      "properties": {
        "semi:hasState": null,
        "semi:isQualified": null
      },
      "key_columns": [
        "id",
        "name",
        "code",
        "equipment_group_id",
        "description",
        "recipe_id",
        "created_at",
        "updated_at"
      ]
    },
    {
      "logic_class": "semi:Carrier",
      "physical_table": "carriers",
      "primary_key": "id",
      "label_cn": "载具",
      "display_column": "carrier_code",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "carrier_code",
        "capacity",
        "status",
        "created_at",
        "updated_at"
      ]
    },
    {
      "logic_class": "semi:Route",
      "physical_table": "process_routes",
      "primary_key": "id",
      "label_cn": "工艺路径",
      "display_column": "name",
      "properties": {},
      "key_columns": [
        "id",
        "code",
        "name",
        "description",
        "version",
        "status",
        "path_type",
        "created_at",
        "updated_at"
      ]
    },
    {
      "logic_class": "semi:ProductModel",
      "physical_table": "products",
      "primary_key": "supabase_id",
      "label_cn": "产品模型",
      "display_column": "product_name",
      "properties": {},
      "key_columns": [
        "supabase_id",
        "id",
        "product_code",
        "product_name",
        "product_category",
        "product_type",
        "customer_name",
        "status",
        "main_process_route_id",
        "process_stations",
        "specifications"
      ]
    },
    {
      "logic_class": "semi:ProductionOrder",
      "physical_table": "production_orders",
      "primary_key": "id",
      "label_cn": "生产工单",
      "display_column": "order_number",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "order_type",
        "order_number",
        "plan_name",
        "product_ref_id",
        "product_name",
        "target_quantity",
        "current_progress",
        "status",
        "priority",
        "start_date",
        "end_date"
      ]
    },
    {
      "logic_class": "semi:BOM",
      "physical_table": "product_boms",
      "primary_key": "id",
      "label_cn": "物料清单(BOM)",
      "display_column": "template_name",
      "properties": {},
      "key_columns": [
        "id",
        "template_name",
        "template_code",
        "product_type",
        "version",
        "status",
        "bom_items",
        "total_amount",
        "created_at"
      ]
    },
    {
      "logic_class": "semi:Recipe",
      "physical_table": null,
      "primary_key": null,
      "label_cn": "配方",
      "display_column": null,
      "virtual": true,
      "properties": {},
      "note": "无独立物理表。配方以ID/code形式引用：equipment.recipe_id、stations工序绑定配方组。工艺参数存在 parameter_groups/parameters 中。",
      "key_columns": []
    },
    {
      "logic_class": "semi:Material",
      "physical_table": null,
      "primary_key": null,
      "label_cn": "物料(抽象父类)",
      "display_column": null,
      "virtual": true,
      "properties": {},
      "embedded_in": "product_boms.bom_items",
      "note": "Supabase 无独立物料主数据表。物料信息嵌入在 product_boms.bom_items (jsonb) 中，以 item_name/item_code 字段标识。",
      "key_columns": []
    },
    {
      "logic_class": "semi:RawMaterial",
      "physical_table": null,
      "primary_key": null,
      "label_cn": "原料",
      "display_column": null,
      "virtual": true,
      "embedded_in": "product_boms.bom_items",
      "note": "子类：原料（如 Bare Wafer）。嵌入在 product_boms.bom_items jsonb，通过 item_type='raw' 区分。",
      "properties": {},
      "key_columns": []
    },
    {
      "logic_class": "semi:Auxiliary",
      "physical_table": null,
      "primary_key": null,
      "label_cn": "辅料",
      "display_column": null,
      "virtual": true,
      "embedded_in": "product_boms.bom_items",
      "note": "子类：辅料（化学药液、特气等）。嵌入在 product_boms.bom_items jsonb，通过 item_type='auxiliary' 区分。",
      "properties": {},
      "key_columns": []
    },
    {
      "logic_class": "semi:SparePart",
      "physical_table": null,
      "primary_key": null,
      "label_cn": "备件",
      "display_column": null,
      "virtual": true,
      "properties": {},
      "note": "Supabase 无备件主数据表。设备维护备件信息暂不在本库维护。",
      "key_columns": []
    },
    {
      "logic_class": "semi:Product",
      "physical_table": null,
      "primary_key": null,
      "label_cn": "产品(物料子类)",
      "display_column": null,
      "virtual": true,
      "properties": {},
      "note": "semi:Product 是 semi:Material 的子类。Supabase 中产品由 products 表（即 semi:ProductModel）统一管理，不另设独立 Product 实例表。",
      "key_columns": []
    },
    {
      "logic_class": "semi:ProcessConstraint",
      "physical_table": null,
      "primary_key": null,
      "label_cn": "工艺约束",
      "display_column": null,
      "virtual": true,
      "properties": {},
      "note": "中间类。约束信息以 jsonb 嵌入：products.process_stations（工序约束列表）、products.specifications（规格约束）。",
      "key_columns": []
    },
    {
      "logic_class": "semi:Action",
      "physical_table": "production_events",
      "primary_key": "id",
      "label_cn": "生产动作/事件",
      "display_column": "event_type",
      "properties": {},
      "key_columns": [
        "id",
        "event_type",
        "batch_id",
        "station_id",
        "equipment_id",
        "payload",
        "created_at"
      ],
      "note": "生产事件表，记录批次进站/出站/拆批/并批等所有操作历史。追加写入，不可变。"
    }
  ],
  "relation_mappings": [
    {
      "logic_relation": "semi:belongsToLot",
      "description": "Wafer 属于哪个 ProductionLot(批次)",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "wafers",
        "source_key": "batch_id",
        "target_table": "batches",
        "target_key": "id"
      }
    },
    {
      "logic_relation": "semi:belongsToSublot",
      "description": "Wafer 属于哪个 Sublot(子批次) — 通过 wafer_carrier_contents 桥接",
      "strategy": "JoinTable",
      "join_logic": {
        "bridge_table": "wafer_carrier_contents",
        "source_key": "wafer_id",
        "target_key": "sub_batch_id",
        "source_table": "wafers",
        "source_pk": "id",
        "target_table": "sub_batches",
        "target_pk": "id",
        "note": "wafer_carrier_contents 记录载具-晶圆-子批次三方位置信息"
      }
    },
    {
      "logic_relation": "semi:locatedInSlot",
      "description": "Wafer 位于哪个 Carrier 的哪个槽位",
      "strategy": "JoinTable",
      "join_logic": {
        "bridge_table": "wafer_carrier_contents",
        "source_key": "wafer_id",
        "target_key": "carrier_id",
        "source_table": "wafers",
        "source_pk": "id",
        "target_table": "carriers",
        "target_pk": "id",
        "additional_columns": [
          "slot_number"
        ],
        "note": "wafer_carrier_contents.slot_number 记录具体槽位"
      }
    },
    {
      "logic_relation": "semi:atStation",
      "description": "Wafer 当前所处工序 — 通过 batch→sub_batch.current_station_id",
      "strategy": "Indirect",
      "join_logic": {
        "path": [
          {
            "from_table": "wafers",
            "from_key": "batch_id",
            "to_table": "batches",
            "to_key": "id"
          },
          {
            "from_table": "batches",
            "from_key": "id",
            "to_table": "sub_batches",
            "to_key": "batch_id"
          },
          {
            "from_table": "sub_batches",
            "from_key": "current_station_id",
            "to_table": "stations",
            "to_key": "id"
          }
        ],
        "denormalized_shortcut": "batches.current_station_code = stations.code（批次表冗余当前站点code，可直接查询）"
      }
    },
    {
      "logic_relation": "semi:currentlyFollowsModel",
      "description": "Wafer 当前遵循的 ProductModel — 通过 batch→products",
      "strategy": "Indirect",
      "join_logic": {
        "path": [
          {
            "from_table": "wafers",
            "from_key": "batch_id",
            "to_table": "batches",
            "to_key": "id"
          },
          {
            "from_table": "batches",
            "from_key": "product_code",
            "to_table": "products",
            "to_key": "product_code"
          }
        ],
        "note": "batches.product_code 与 products.product_code 关联"
      }
    },
    {
      "logic_relation": "semi:currentlyOnRoute",
      "description": "Wafer 当前所走工艺路径 — 通过 batch→products→main_process_route_id",
      "strategy": "Indirect",
      "join_logic": {
        "path": [
          {
            "from_table": "wafers",
            "from_key": "batch_id",
            "to_table": "batches",
            "to_key": "id"
          },
          {
            "from_table": "batches",
            "from_key": "product_code",
            "to_table": "products",
            "to_key": "product_code"
          },
          {
            "from_table": "products",
            "from_key": "main_process_route_id",
            "to_table": "process_routes",
            "to_key": "id"
          }
        ]
      }
    },
    {
      "logic_relation": "semi:basedOnOrder",
      "description": "ProductionLot(批次) 基于哪个 ProductionOrder(工单) 创建",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "batches",
        "source_key": "work_order_id",
        "target_table": "production_orders",
        "target_key": "id",
        "note": "batches.work_order_id → production_orders.id 直接外键"
      }
    },
    {
      "logic_relation": "semi:definesRequirementFor",
      "description": "ProductionOrder 定义了哪个 ProductModel(产品规格需求)",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "production_orders",
        "source_key": "product_ref_id",
        "target_table": "products",
        "target_key": "supabase_id"
      }
    },
    {
      "logic_relation": "semi:containsSublot",
      "description": "ProductionLot(批次) 包含哪些 Sublot(子批次)",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "batches",
        "source_key": "id",
        "target_table": "sub_batches",
        "target_key": "batch_id"
      }
    },
    {
      "logic_relation": "semi:isCarriedBy",
      "description": "Sublot 由哪个 Carrier(载具) 承载",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "sub_batches",
        "source_key": "current_carrier_id",
        "target_table": "carriers",
        "target_key": "id"
      }
    },
    {
      "logic_relation": "semi:usesRoute",
      "description": "ProductModel 使用哪条 Route(工艺路径模板)",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "products",
        "source_key": "main_process_route_id",
        "target_table": "process_routes",
        "target_key": "id"
      }
    },
    {
      "logic_relation": "semi:consistsOfStation",
      "description": "Route 包含哪些 ProcessStation(工序节点)，有序",
      "strategy": "JoinTable",
      "join_logic": {
        "bridge_table": "process_route_stations",
        "source_key": "route_id",
        "target_key": "station_id",
        "source_table": "process_routes",
        "source_pk": "id",
        "target_table": "stations",
        "target_pk": "id",
        "order_by": "sequence"
      }
    },
    {
      "logic_relation": "semi:requiresEquipment",
      "description": "ProcessStation 要求哪些 Equipment(设备) 执行",
      "strategy": "JoinTable",
      "join_logic": {
        "bridge_table": "equipment_groups",
        "source_table": "stations",
        "source_key": "equipment_group",
        "target_table": "equipment",
        "target_key": "equipment_group_id",
        "note": "stations.equipment_group → equipment_groups.id → equipment.equipment_group_id"
      }
    },
    {
      "logic_relation": "semi:hostsRecipe",
      "description": "Equipment 物理驻留哪个 Recipe(配方)",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "equipment",
        "source_key": "recipe_id",
        "target_table": "parameter_groups",
        "target_key": "id",
        "note": "Recipe在Supabase中以参数组(parameter_groups)形式存在。equipment.recipe_id → parameter_groups.id"
      }
    },
    {
      "logic_relation": "semi:hasBOM",
      "description": "ProductModel 关联哪个 BOM 定义",
      "strategy": "Denormalized",
      "join_logic": {
        "source_table": "products",
        "source_key": "product_type",
        "target_table": "product_boms",
        "target_key": "product_type",
        "note": "JOIN ON products.product_type = product_boms.product_type，同时过滤 product_boms.status='active'"
      }
    },
    {
      "logic_relation": "semi:consumesRawMaterial",
      "description": "BOM 消耗哪些原料(RawMaterial) — 嵌入在 bom_items",
      "strategy": "EmbeddedJSON",
      "join_logic": {
        "source_table": "product_boms",
        "jsonb_column": "bom_items",
        "filter_condition": "item_type = 'raw'",
        "note": "product_boms.bom_items jsonb数组，原料通过 item_type='raw' 筛选"
      }
    },
    {
      "logic_relation": "semi:consumesAuxiliary",
      "description": "BOM 消耗哪些辅料(Auxiliary) — 嵌入在 bom_items",
      "strategy": "EmbeddedJSON",
      "join_logic": {
        "source_table": "product_boms",
        "jsonb_column": "bom_items",
        "filter_condition": "item_type = 'auxiliary'",
        "note": "product_boms.bom_items jsonb数组，辅料通过 item_type='auxiliary' 筛选"
      }
    },
    {
      "logic_relation": "semi:requiresSparePart",
      "description": "Equipment 需要哪些备件(SparePart) — 虚拟关系",
      "strategy": "Virtual",
      "join_logic": {
        "note": "Supabase 无备件主数据表，该关系暂无物理实现。"
      }
    },
    {
      "logic_relation": "semi:hasConstraint",
      "description": "ProductModel 注入 ProcessConstraint — 嵌入在 products.process_stations",
      "strategy": "EmbeddedJSON",
      "join_logic": {
        "source_table": "products",
        "jsonb_column": "process_stations",
        "note": "products.process_stations jsonb数组，每项记录一道工序的约束配置。ProcessConstraint是虚拟中间类。"
      }
    },
    {
      "logic_relation": "semi:appliesAtStation",
      "description": "ProcessConstraint 应用于哪个 ProcessStation",
      "strategy": "EmbeddedJSON",
      "join_logic": {
        "source_table": "products",
        "jsonb_column": "process_stations",
        "inner_key": "station_code",
        "target_table": "stations",
        "target_key": "code",
        "note": "process_stations jsonb 中每项含 station_code，通过 stations.code 关联"
      }
    },
    {
      "logic_relation": "semi:specifiesRecipe",
      "description": "ProcessConstraint 在该工序指定 Recipe",
      "strategy": "EmbeddedJSON",
      "join_logic": {
        "source_table": "products",
        "jsonb_column": "process_stations",
        "inner_key": "recipe_id",
        "target_table": "parameter_groups",
        "target_key": "id",
        "note": "process_stations jsonb 中每项可含 recipe_id，指向 parameter_groups"
      }
    },
    {
      "logic_relation": "semi:isDefinedBy",
      "description": "Product(产品实例) 由 ProductModel 定义 — 虚拟关系",
      "strategy": "Virtual",
      "join_logic": {
        "note": "Supabase中Product实例与ProductModel合并在products表管理，无需跨表JOIN。"
      }
    },
    {
      "logic_relation": "semi:anchoredAtStation",
      "description": "BOM 物料消耗锚定到哪个 ProcessStation",
      "strategy": "EmbeddedJSON",
      "join_logic": {
        "source_table": "product_boms",
        "jsonb_column": "bom_items",
        "inner_key": "station_code",
        "target_table": "stations",
        "target_key": "code",
        "note": "bom_items数组中每条物料可携带 station_code 字段，指定该物料在哪道工序消耗"
      }
    },
    {
      "logic_relation": "semi:hasInput",
      "description": "Action(生产事件) 的输入对象 — 批次",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "production_events",
        "source_key": "batch_id",
        "target_table": "batches",
        "target_key": "id",
        "note": "production_events.batch_id 记录操作动作的输入批次对象"
      }
    },
    {
      "logic_relation": "semi:hasOutput",
      "description": "Action(生产事件) 的输出结果 — 批次状态变更",
      "strategy": "Denormalized",
      "join_logic": {
        "source_table": "production_events",
        "output_field": "payload",
        "note": "production_events.payload (jsonb) 记录动作输出结果，如新批次状态、拆批产生的子批次ID等"
      }
    },
    {
      "logic_relation": "semi:modifiesStateVector",
      "description": "Action(生产事件) 修改 Wafer 状态向量",
      "strategy": "Indirect",
      "join_logic": {
        "path": [
          {
            "from_table": "production_events",
            "from_key": "batch_id",
            "to_table": "batches",
            "to_key": "id"
          },
          {
            "from_table": "batches",
            "from_key": "id",
            "to_table": "wafers",
            "to_key": "batch_id"
          }
        ],
        "note": "进站/出站事件隐式修改 batches.current_station_code，进而影响所有关联wafers的atStation状态"
      }
    },
    {
      "logic_relation": "semi:hasParentLot",
      "description": "ProductionLot 的父批次(溯源递归)",
      "strategy": "Recursive",
      "join_logic": {
        "table": "batches",
        "self_key": "id",
        "parent_key": "parent_batch_id",
        "max_depth": 20,
        "note": "需要 WITH RECURSIVE CTE; parent_batch_id 为自引用外键（如不存在则此关系虚拟）"
      }
    }
  ],
  "value_mappings": {
    "semi:WaferState": {
      "WIP": {
        "description": "在制品—尚未完成生产的晶圆实例",
        "physical_condition": "sub_batches.status != 'completed'",
        "applies_to_table": "sub_batches",
        "applies_to_column": "status",
        "count_target_table": "wafers",
        "count_target_column": "id",
        "join_path": "wafers.batch_id=batches.id → batches.id=sub_batches.batch_id",
