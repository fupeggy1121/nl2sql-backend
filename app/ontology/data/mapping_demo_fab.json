  "business_rules": [
    {
      "id": "wip_quality",
      "name": "在制品WIP + 良品/不良品综合统计",
      "description": "同时查询WIP在制品数量与良品/不良品数量时使用。按站点统计当前在制批次的WIP数（DISTINCT wafers.id）、良品数(good_qty)、不良品数(defect_qty)、总产量及良率。HAVING过滤掉合计产量为0的站点（即真正有WIP且有产量数据的站点）。JOIN路径: stations→sub_batches(current_station_id)→batches→wafers。优先级高于 wip_count 规则。",
      "semantic_pattern": "WIP + QUALITY + Station",
      "trigger_keywords": ["良品", "不良品", "良品数", "不良品数", "good_qty", "defect_qty"],
      "physical_sql_template": "SELECT s.id AS station_id, s.name AS station_name, COUNT(DISTINCT w.id) AS wip_count, SUM(COALESCE(sb.good_qty, 0)) AS good_qty, SUM(COALESCE(sb.defect_qty, 0)) AS defect_qty, SUM(COALESCE(sb.total_qty, 0)) AS total_qty, CASE WHEN SUM(COALESCE(sb.total_qty, 0)) > 0 THEN ROUND(SUM(COALESCE(sb.good_qty, 0)) * 100.0 / SUM(COALESCE(sb.total_qty, 0)), 2) ELSE 0 END AS good_rate_percent FROM stations s JOIN sub_batches sb ON sb.current_station_id = s.id JOIN batches b ON sb.batch_id = b.id JOIN wafers w ON w.batch_id = b.id WHERE sb.status != 'completed' {station_filter}GROUP BY s.id, s.name HAVING SUM(COALESCE(sb.total_qty, 0)) > 0 ORDER BY wip_count DESC",
      "involved_tables": ["stations", "sub_batches", "batches", "wafers"],
      "involved_relations": ["semi:atStation", "semi:belongsToLot", "semi:containsSublot"]
    },
    {
      "id": "wip_count",
      "name": "在制品(WIP)数量统计",
      "description": "WIP统计的是Wafer(晶圆)实例数量，不是sub_batches数量。WIP状态通过sub_batches.status != 'completed'过滤，COUNT对象必须是DISTINCT wafers.id（因batch→sub_batch一对多会导致wafer行重复）。JOIN路径: wafers→batches(batch_id=id)→sub_batches(batch_id)→stations(current_station_id=id)",
      "semantic_pattern": "COUNT + WIP + Station",
      "trigger_keywords": ["在制", "WIP", "wip", "在制数量", "在制品", "在途"],
      "physical_sql_template": "SELECT s.name AS station_name, COUNT(DISTINCT w.id) AS wip_count FROM wafers w JOIN batches b ON w.batch_id = b.id JOIN sub_batches sb ON sb.batch_id = b.id JOIN stations s ON sb.current_station_id = s.id WHERE sb.status != 'completed' {station_filter}GROUP BY s.name ORDER BY wip_count DESC",
      "involved_tables": ["wafers", "batches", "sub_batches", "stations"],
      "involved_relations": ["semi:belongsToLot", "semi:containsSublot", "semi:atStation"]
    },
    {
      "id": "yield_rate",
      "name": "良率(合格率)统计",
      "description": "站点良率通过 sub_batches 表的 good_qty/total_qty 计算。ROUND(SUM(good_qty)/NULLIF(SUM(total_qty),0)*100, 2) 防止除零。需 JOIN stations 表按站点中文名过滤。sub_batches.status 可不过滤（在制/已完成批次都参与良率统计）。",
      "semantic_pattern": "YIELD + Station",
      "trigger_keywords": ["良率", "良品率", "合格率"],
      "physical_sql_template": "SELECT s.name AS station_name, ROUND(SUM(sb.good_qty)::numeric / NULLIF(SUM(sb.total_qty), 0) * 100, 2) AS yield_rate FROM sub_batches sb JOIN stations s ON sb.current_station_id = s.id WHERE sb.total_qty > 0 {station_filter}GROUP BY s.name ORDER BY yield_rate DESC",
      "involved_tables": ["sub_batches", "stations"],
      "involved_relations": ["semi:atStation"]
    },
    {
      "id": "chinese_name_filter",
      "name": "中文名过滤规则",
      "description": "对工站、设备按中文名过滤时，使用 name 字段（中文显示名），而不是 code 字段（英文编码）",
      "applies_to": ["stations.name", "equipment.name", "products.product_name"]
    },
    {
      "id": "batch_station_denormalized",
      "name": "批次-工站反范式",
      "description": "batches 表直接存储了 current_station_code 和 current_station_name（反范式），查询批次当前工站时可直接取字段而无需 JOIN stations",
      "applies_to": ["batches.current_station_code", "batches.current_station_name"]
    },
    {
      "id": "route_vs_wip",
      "name": "工艺路线定义表 vs WIP数据",
      "description": "process_route_stations 是工艺路线定义表（定义了路线包含哪些工序及顺序），NOT WIP数据。查询在制品数量不应使用此表。",
      "warning_tables": ["process_route_stations"]
    },
    {
      "id": "equipment_utilization",
      "name": "设备稼动率统计",
      "description": "统计设备利用率时，按 equipment.status 中 running 状态占比计算。分组维度通常为 equipment_group_id 或按关联工站分组。",
      "semantic_pattern": "设备利用率 + Equipment",
      "involved_tables": ["equipment"],
      "involved_relations": ["semi:requiresEquipment"]
    },
    {
      "id": "order_priority_filter",
      "name": "工单优先级过滤",
      "description": "工单优先级字段为 production_orders.priority，取值范围含 high/medium/low/urgent。紧急工单对应 priority IN ('high','urgent')。",
      "semantic_pattern": "紧急 + 工单",
      "involved_tables": ["production_orders"]
    },
    {
      "id": "recursive_parent_lot",
      "name": "批次树追溯",
      "description": "批次有层级关系（母批次/子批次），通过 batches.parent_batch_id 自关联。追溯完整批次树需使用 WITH RECURSIVE CTE。",
      "semantic_pattern": "父批次 + 追溯 + 批次树",
      "involved_tables": ["batches"],
      "involved_relations": ["semi:hasParentLot"]
    }
  ]
}
