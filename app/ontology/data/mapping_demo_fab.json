  "business_rules": [
    {
      "rule_id": "BR-001",
      "name": "WIP统计口径",
      "description": "统计在制品(WIP)数量时，COUNT目标为wafers表的id（晶圆实例），而非sub_batches。通过wafers→batches→sub_batches路径获取状态过滤。避免batch→sub_batch一对多导致重复计数。",
      "applies_to_classes": [
        "semi:Wafer",
        "semi:Sublot"
      ]
    },
    {
      "rule_id": "BR-002",
      "name": "批次当前站点双路径",
      "description": "查询批次当前站点有两条路径：(1)快捷路径：batches.current_station_code直接关联stations.code（冗余字段）；(2)规范路径：batches→sub_batches.current_station_id→stations.id（通过子批次实时状态）。",
      "applies_to_classes": [
        "semi:ProductionLot",
        "semi:ProcessStation"
      ]
    },
    {
      "rule_id": "BR-003",
      "name": "BOM与ProductModel关联",
      "description": "product_boms通过product_type字段与products关联（非直接外键），查询时需JOIN ON products.product_type=product_boms.product_type并过滤product_boms.status='active'确保取生效版本。",
      "applies_to_classes": [
        "semi:ProductModel",
        "semi:BOM"
      ]
    }
  ]
