@prefix semi: <http://www.semanticweb.org/semi-mes/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### ==========================================
### 1. 核心类定义 (Classes)
### ==========================================

semi:Wafer a owl:Class ; 
    rdfs:label "晶圆(Wafer)" ;
    rdfs:comment "不可变的最小物理实体标识，全生命周期身份稳定的核心锚点。" .

semi:Material a owl:Class ; 
    rdfs:label "物料" ;
    rdfs:comment "价值的物理载体，包括原料、辅料、备件、产品。" .

semi:Product a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "产品" ;
    rdfs:comment "状态演化的终点产物，受产品模型定义约束。" .

semi:RawMaterial a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "原料" ;
    rdfs:comment "生产投入的初始实物（如 Bare Wafer）。" .

semi:Auxiliary a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "辅料" ;
    rdfs:comment "加工过程中的消耗性资源（如化学药液、特气）。" .

semi:SparePart a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "备件" ;
    rdfs:comment "用于设备维护和状态恢复的更换件。" .


semi:ProductModel a owl:Class ; 
    rdfs:label "产品模型" ;
    rdfs:comment "目标状态(What)与转换约束(How)的规则总成。" .

semi:BOM a owl:Class ; 
    rdfs:label "物料清单(BOM)" ;
    rdfs:comment "物料资源的结构逻辑，定义用什么做。" .

semi:Route a owl:Class ; 
    rdfs:label "工艺路径" ;
    rdfs:comment "制造导航地图，定义物料流转的受控路径。" .

semi:ProcessStation a owl:Class ; 
    rdfs:label "工艺站点(工序)" ;
    rdfs:comment "最小生产控制单元，物料状态转换的场所。" .

semi:ProcessConstraint a owl:Class ;
    rdfs:label "工艺约束（工艺导航节点）" ;
    rdfs:comment "某产品模型在特定工序下的完整工艺管控规格节点。物理存储：EmbeddedJSON，嵌入 product_model.main_route 字段，路径 $.processes[*]（每个数组元素对应一个工序站点的管控配置）。主要字段：code（工序站点码，关联 semi:ProcessStation）、name（工序名）、recipe（配方绑定 id/code/name，关联 semi:Recipe；部分工序无配方时为空对象）、processParamList（工艺参数管控列表，含 paramName、paramModelId→param_model.id、target/maxValue/minValue/tolerance/unit；为该产品在该工序的专属卡控规格）、measurementParamList（量测参数合格界限列表，同结构，另含 shipmentDecision 出货判定标志）、remarkList（文字技术要求，theme/value 键值对）、productEqpGroupList（产品专属指定设备组绑定，参见 semi:specifiesProductEqpGroup）。无独立数据库表，所有管控信息以树状 JSON 内聚于 product_model 行的 main_route 字段中。" .

semi:ProductionOrder a owl:Class ; 
    rdfs:label "生产工单" ;
    rdfs:comment "企业下发的生产指令，连接经营层与执行层。" .

semi:ProductionLot a owl:Class ; 
    rdfs:label "生产批次(Lot)" ;
    rdfs:comment "管理调度的基本单元，承载生产管理核心信息。" .

semi:Sublot a owl:Class ; 
    rdfs:label "子批次(Sublot)" ;
    rdfs:comment "受载具物理约束下的批次分组投影。" .

semi:Equipment a owl:Class ; 
    rdfs:label "设备" ;
    rdfs:comment "价值转换的执行者，生产过程中最大的变量源。" .

semi:Recipe a owl:Class ; 
    rdfs:label "配方(Recipe)" ;
    rdfs:comment "工艺知识的参数化封装，指导设备如何做。" .

semi:Carrier a owl:Class ; 
    rdfs:label "载具" ;
    rdfs:comment "物理流转的承载工具，设备与物料的物理接口。" .

semi:Action a owl:Class ; 
    rdfs:label "生产动作/操作（抽象父类）" ;
    rdfs:comment "驱动物料或设备状态跳转的逻辑单元。抽象父类，不直接映射物理表。子类：semi:ProductionEvent（事件类型模板）。关联类：semi:ProductionEventRecord（事件执行记录，非 Action 子类，描述某次操作的实际执行结果）。" .

semi:CarrierModel a owl:Class ;
    rdfs:label "载具模型" ;
    rdfs:comment "定义特定规格型号载具的设计模板，包含尺寸、容量、额定寿命等参数；Carrier 是 CarrierModel 下的实例。" .

semi:CarrierGroup a owl:Class ;
    rdfs:label "载具组" ;
    rdfs:comment "同类型载具的逻辑分组，MES 调度抽象单元，被工艺站点引用作为载具可用性约束。" .

semi:EquipmentGroup a owl:Class ;
    rdfs:label "设备组" ;
    rdfs:comment "功能相同的设备的逻辑分组（能力池），被工艺站点直接引用作为派工可行域。工序不硬编码到具体机台，而是指向设备组，支持组内动态派工。" .

semi:EquipmentModel a owl:Class ;
    rdfs:label "设备模型" ;
    rdfs:comment "资产蓝图 (Blueprint)。定义了该型号设备的技术规格与物理极限，基于设备模型统一管理同型号设备的备件、额定寿命与厂商信息；采购依据：新增资产时直接继承模型的规格。" .

# 生产履历追溯类群 (Traceability)
# 注：StationPassRecord 抽象基类已废弃；进站/出站语义由 CheckInEventRecord / CheckOutEventRecord 承接。
# ProcessPassRecord 已废弃（对应物理表不存在）；制程/量测参数录入统一由 MeasurementPassRecord 承接。

semi:MeasurementPassRecord a owl:Class ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:MeasurementEvent ] ;
    rdfs:label "量测与制程参数过站记录" ;
    rdfs:comment "Wafer 在某个工艺站点执行量测或制程参数采集后产生的逐片参数快照记录。参数采集的直接主体是 Wafer（wafer_id 全局唯一不变），sublot_id / lot_id 是采集时刻记录的调度管理上下文快照字段，反映该 Wafer 当时所属的子批次/批次，不代表 Sublot 或 Lot 拥有此记录——拆批/并批后这些字段仍保留拆批前的归属信息用于追溯。核心关联：(1) hasMeasurementRecord（反向，Wafer→本记录）：wafer_id 是参数事实的物理锚点；(2) isInstanceOfEvent → semi:MeasurementEvent；(3) actsOnWafer → 被量测的具体晶圆实例（冗余对象属性，与 hasMeasurementRecord 方向互补）；(4) actsOnLot → 量测时所属批次（lot_id 快照字段，对象属性）；(5) recordedAtStation → 量测工艺站点（station_id，可选）；(6) processedByEquipment → 量测设备（eqp_id，人工录入时为空）。查询批次维度量测数据时直接对 process_measure_data.sublot_id / lot_id 过滤，完整语义路径为 Sublot ← belongsToSublot ← Wafer → hasMeasurementRecord。物理主映射：process_measure_data（eqp_id 非空）；制程参数人工录入：process_measure_data_raw（eqp_id 为空）。参数语义注释：param_model_id → param_model；参数分组：param_group_id → param_group。" .

semi:ProductionEvent a owl:Class ;
    rdfs:subClassOf semi:Action ;
    rdfs:label "生产事件类型（Action 子类）" ;
    rdfs:comment "定义某类批次操作的规则/类型模板，如拆批(Split)、攒批(Merge)、返工(Rework)、进站、出站等。作为 semi:Action 的子类，表示系统 API 接口层面的操作类型定义；可通过 Named Individuals 枚举具体事件类型，不直接映射物理表。对应的执行记录见 semi:ProductionEventRecord。" .

semi:ProductionEventRecord a owl:Class ;
    rdfs:label "生产事件记录（抽象父类）" ;
    semi:isAbstract "true"^^xsd:boolean ;
    rdfs:comment "【抽象父类，不直接实例化】生产事件执行记录的抽象父类。主映射表：matrix_routerx_operation_lot_batch_resume_log（所有 operation_type 均写入此表）；关联从表：_detail（子批次操作状态快照，SublotOpSnapshot）和 _wafer_detail_log（逐片 Wafer 迁移明细，WaferTransitionRecord）。每条记录对应一次具体操作，记录操作人、时间戳、状态变更及输入/输出批次。全量子类：SplitEventRecord（1-拆批）/ HoldEventRecord（4-扣留）/ ReleaseEventRecord（5-释放）/ NGRecordEventRecord（6-不良录入）/ CheckInEventRecord（8-进站）/ CheckOutEventRecord（9-出站）。各子类与 ProductionLot 的关联语义不同，详见子类 rdfs:comment。" .

### ==========================================
### 2. 核心有机关联 (Object Properties)
### ==========================================

# 2.1 Wafer 核心状态向量 (物理实体锚点)
semi:belongsToLot a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:ProductionLot ;
    rdfs:label "属于批次" .

semi:belongsToSublot a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:Sublot ;
    rdfs:label "属于子批次" .

semi:isLoadedIn a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:Carrier ;
    rdfs:label "装载于载具" ;
    rdfs:comment "Wafer当前装载的载具实例。物理层：matrix_routerx_operation_lot_wafer.carrier_code → carrier_info.code（ForeignKey）。槽位号通过数据属性 semi:hasSlotNo（对应 slot_no 列）单独表达；两者共同构成'晶圆在载具中的坐标'：载具是独立实体（Object），槽位号是该承载关系下的位置坐标（Data）。" .

semi:atStation a owl:ObjectProperty ;
    rdfs:domain semi:Sublot ; rdfs:range semi:ProcessStation ;
    rdfs:label "当前所处工序(位置向量)" ;
    rdfs:comment "加工以子批次为单位，Sublot当前所处工艺站点。通过Wafer→belongsToSublot→Sublot→atStation→ProcessStation实现2跳路径访问。" .

semi:currentlyFollowsModel a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductModel ;
    rdfs:label "遵循产品模型(目标向量)" .

semi:currentlyOnRoute a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:Route ;
    rdfs:label "当前工艺路径(导航向量)" .

# 2.2 生产管理层级 (Management Hierarchy)
semi:basedOnOrder a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionOrder ;
    rdfs:label "基于工单创建" .

semi:definesRequirementFor a owl:ObjectProperty ;
    rdfs:domain semi:ProductionOrder ; rdfs:range semi:ProductModel ;
    rdfs:label "定义产品规格需求" .

semi:containsSublot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:Sublot ;
    rdfs:label "包含子批次分组" .

semi:isCarriedBy a owl:ObjectProperty ;
    rdfs:domain semi:Sublot ; rdfs:range semi:Carrier ;
    rdfs:label "由载具承载" .

# 2.3 工艺约束注入逻辑 (Core Decoupling Logic)
semi:hasMainRoute a owl:ObjectProperty ;
    rdfs:domain semi:ProductModel ; rdfs:range semi:Route ;
    rdfs:label "使用主工艺路径" ;
    rdfs:comment "产品模型绑定的主工艺路径。物理：product_model.main_route.id → matrix_routerx_config_route.id（routeType=0/MAIN）。每个产品模型唯一对应一条主路径，决定物料流转的完整工序序列。" .

semi:consistsOfStation a owl:ObjectProperty ;
    rdfs:domain semi:Route ; rdfs:range semi:ProcessStation ;
    rdfs:label "包含工序节点" .

semi:hasConstraint a owl:ObjectProperty ;
    rdfs:domain semi:ProductModel ; rdfs:range semi:ProcessConstraint ;
    rdfs:label "注入工艺约束" .

semi:appliesAtStation a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:ProcessStation ;
    rdfs:label "应用于特定工序" .

semi:specifiesRecipe a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:Recipe ;
    rdfs:label "在该工序指定配方" .

# 2.4 物料子类、设备、BOM的关联

# 产品与模型的灵魂绑定
semi:isDefinedBy a owl:ObjectProperty ;
    rdfs:label "由产品模型定义" ;
    rdfs:domain semi:Product ; 
    rdfs:range semi:ProductModel ;
    rdfs:comment "产品模型是该产品的状态转换规则与目标模板总成。" .

# BOM 对原料与辅料的精准消耗
semi:consumesRawMaterial a owl:ObjectProperty ;
    rdfs:label "消耗原料" ;
    rdfs:domain semi:BOM ; 
    rdfs:range semi:RawMaterial .

semi:consumesAuxiliary a owl:ObjectProperty ;
    rdfs:label "消耗辅料" ;
    rdfs:domain semi:BOM ; 
    rdfs:range semi:Auxiliary .

# 备件与设备的运维关联
semi:requiresSparePart a owl:ObjectProperty ;
    rdfs:label "要求备件更换" ;
    rdfs:domain semi:Equipment ; 
    rdfs:range semi:SparePart ;
    rdfs:comment "驱动设备从异常/老化状态回归受控状态。" .

semi:containsEquipment a owl:ObjectProperty ;
    rdfs:domain semi:EquipmentGroup ; rdfs:range semi:Equipment ;
    rdfs:label "设备组包含设备" ;
    rdfs:comment "设备组包含的设备实例，多对多关系（一个设备可属于多个设备组）。对应 equipment_group.equipments JSON 数组，数组元素为 equipment.id。" .

semi:isInstanceOf a owl:ObjectProperty ;
    rdfs:domain semi:Equipment ; rdfs:range semi:EquipmentModel ;
    rdfs:label "设备型号" ;
    rdfs:comment "设备实例所属设备模型（型号），从模型继承额定寿命、规格参数等。当设备当前寿命达到 EquipmentModel 定义的额定寿命时，系统自动触发报废预警或大修计划。N:1 关系（多台设备可属同一型号）。" .

semi:usesEquipmentGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:EquipmentGroup ;
    rdfs:label "工序绑定可用设备组" ;
    rdfs:comment "工序站点（ProcessStation）引用设备组作为通用派工可行域，对应 matrix_routerx_config_process.equipment_group_list（JSON 数组）。表示该工序在工艺能力层面可使用哪些设备组（1对多）。区别于 semi:specifiesProductEqpGroup：后者是产品模型在该工序额外指定的专属设备组约束（存储于 product_model.main_route），两层约束叠加后形成最终派工可行域。" .

semi:hostsRecipe a owl:ObjectProperty ;
    rdfs:domain semi:Equipment ; rdfs:range semi:Recipe ;
    rdfs:label "物理驻留配方" .

semi:hasBOM a owl:ObjectProperty ;
    rdfs:domain semi:ProductModel ; rdfs:range semi:BOM ;
    rdfs:label "关联BOM定义" .

semi:anchoredAtStation a owl:ObjectProperty ;
    rdfs:domain semi:BOM ; rdfs:range semi:ProcessStation ;
    rdfs:label "物料消耗锚定工序" .


# 2.5 动作驱动与跳转 (Action Logic)
semi:hasInput a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEvent ;
    rdfs:range [ a owl:Class ; owl:unionOf (semi:ProductionLot semi:Wafer) ] ;
    rdfs:label "动作输入" ;
    rdfs:comment "本次操作的输入对象（ProductionLot 或 Wafer）。domain 为 semi:ProductionEvent（事件类型），不继承自抽象父类 Action。具体执行记录中的批次关联见 semi:ProductionEventRecord.actsOnLot。" .

semi:hasOutput a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEvent ;
    rdfs:range [ a owl:Class ; owl:unionOf (semi:ProductionLot semi:Wafer) ] ;
    rdfs:label "动作输出" ;
    rdfs:comment "本次操作产生的输出对象（ProductionLot 或 Wafer）。domain 为 semi:ProductionEvent（事件类型），不继承自抽象父类 Action。具体执行记录中的批次关联见 semi:ProductionEventRecord.producesLot。" .

semi:modifiesStateVector a owl:ObjectProperty ;
    rdfs:domain semi:Action ; rdfs:label "修改状态向量" ;
    rdfs:comment "Action 驱动批次(ProductionLot)状态机跳转，间接修改批次所含 Sublot 的 atStation 等动态指针；不直接关联 Wafer 实例。" .

semi:hasParentLot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionLot ;
    rdfs:label "父批次(溯源)" .

# 2.6 生产履历追溯对象属性 (Traceability Object Properties)
# 注：hasPassRecord 已移除——其语义等价于 actsOnLot 的反向查询加类型过滤
# （CheckInEventRecord/CheckOutEventRecord WHERE lot_id=?），保留单一正向路径以避免 LLM 歧义。

semi:hasMeasurementRecord a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range semi:MeasurementPassRecord ;
    rdfs:label "晶圆量测参数记录" ;
    rdfs:comment "晶圆在某站点执行量测后产生的逐片参数快照（MeasurementPassRecord）。关联键：process_measure_data.wafer_id → semi:Wafer，wafer_id 是参数采集的直接主体锚点，全程不变。process_measure_data 中的 sublot_id / lot_id 是采集时刻的调度管理上下文快照字段，不代表 Sublot/Lot 拥有量测记录，拆批后这些字段仍然记录的是拆批前的归属信息。批次维度查询量测数据使用 process_measure_data.sublot_id 过滤（利用快照字段），完整语义路径为：Sublot ← belongsToSublot ← Wafer → hasMeasurementRecord → MeasurementPassRecord。进出站事件查询通过 CheckInEventRecord/CheckOutEventRecord WHERE lot_id=? 正向导航，无需反向属性。" .

semi:affectsSublot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range semi:Sublot ;
    rdfs:label "操作影响的子批次" ;
    rdfs:comment "生产事件执行记录关联被影响的子批次实例（1:N，每个事件可影响多个子批次）。物理JoinVia路径：_resume_log.id → _detail.resume_log_id → _detail.sublot_id → matrix_routerx_operation_lot.id（parent_id!=0）。_detail 中间表同时携带事件执行时刻的子批次状态快照（carrier_code/process_code/before_state/after_state），是该时刻子批次上下文的时序截面，不代表当前状态。适用于全部 operation_type。注：_detail 表不作为独立本体类，其语义由本关系属性完整表达。" .

semi:actsOnWafer a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (semi:NGRecordEventRecord semi:SplitEventRecord
                     semi:MergeEventRecord semi:AccumulateEventRecord
                     semi:CheckInEventRecord semi:CheckOutEventRecord)
    ] ;
    rdfs:range semi:Wafer ;
    rdfs:label "操作涉及的 Wafer" ;
    rdfs:comment "生产事件执行记录关联被影响的具体晶圆实例（1:N）。物理JoinVia路径：_resume_log.id → _wafer_detail_log.resume_log_id → _wafer_detail_log.wafer_id → matrix_routerx_operation_lot_wafer.wafer_id。各子类语义：NGRecordEventRecord→被标记不良的晶圆；SplitEventRecord→被迁移出源批次的晶圆（lot/sublot 归属变更）；MergeEventRecord→被重新归属到目标批次的晶圆；AccumulateEventRecord→被攒入新批次的晶圆；CheckInEventRecord/CheckOutEventRecord→参与进/出站操作的晶圆（逐片站点记录）。_wafer_detail_log 同时携带 from_lot_id/to_lot_id/ng_code/carrier_code/slot_no 作为关系属性。⚠ HoldEventRecord/ReleaseEventRecord 无 wafer 粒度记录，不在此属性 domain 内。注：量测参数记录(MeasurementPassRecord)通过 hasMeasurementRecord 反向属性关联 Wafer，不通过本属性。" .

semi:recordedAtStation a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (semi:ProductionEventRecord semi:MeasurementPassRecord)
    ] ;
    rdfs:range semi:ProcessStation ;
    rdfs:label "事件/记录所在工序" ;
    rdfs:comment "该记录对应的工艺站点（process_id / station_id）。ProductionEventRecord 场景：在时间轴上定位批次所处制造位置的锚点；MeasurementPassRecord 场景：量测工序站点（station_id 字段，可通过 param_model 的 station 反推）。" .

semi:processedByEquipment a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (semi:ProductionEventRecord semi:MeasurementPassRecord)
    ] ;
    rdfs:range semi:Equipment ;
    rdfs:label "事件/记录使用设备" ;
    rdfs:comment "执行本次加工或量测的具体设备实例。ProductionEventRecord 场景：equipment_id FK 关联设备；MeasurementPassRecord 场景：process_measure_data.eqp_id 关联量测设备，制程参数人工录入（process_measure_data_raw）时 eqp_id 为空。支持从设备维度反查'某台设备何时处理/量测了哪些批次'。"  .

semi:mergedFrom a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionLot ;
    rdfs:label "攒批自" ;
    rdfs:comment "攒批/合批(Merge)操作：多个源批次合并为一个新批次。在谱系DAG中表现为多对一的汇聚节点，是追溯断点的最常见来源。" .

semi:reworkedAs a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionLot ;
    rdfs:label "返工为" ;
    rdfs:comment "返工(Rework)操作：被判定为Reject的批次重新投入加工，衍生出运行于返工工艺路径的新批次标识。返工完成若判定Good则在谱系图中归并回主路径。多次返工形成循环切出-回归的有向路径。" .

semi:isInstanceOfEvent a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (semi:SplitEventRecord semi:MergeEventRecord semi:AccumulateEventRecord
                     semi:HoldEventRecord semi:ReleaseEventRecord semi:NGRecordEventRecord
                     semi:CheckInEventRecord semi:CheckOutEventRecord)
    ] ;
    rdfs:range semi:ProductionEvent ;
    rdfs:label "事件实例记录" ;
    rdfs:comment "该执行记录对应的事件类型（ProductionEvent 子类实例），关联 record → event 类型定义。各子类通过 owl:allValuesFrom 约束将 range 精化为对应 XxxEvent 子类：SplitEventRecord→SplitEvent / MergeEventRecord→MergeEvent / AccumulateEventRecord→AccumulateEvent / HoldEventRecord→HoldEvent / ReleaseEventRecord→ReleaseEvent / NGRecordEventRecord→NGRecordEvent / CheckInEventRecord→CheckInEvent / CheckOutEventRecord→CheckOutEvent。" .

semi:actsOnLot a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (semi:SplitEventRecord semi:MergeEventRecord semi:AccumulateEventRecord
                     semi:HoldEventRecord semi:ReleaseEventRecord semi:NGRecordEventRecord
                     semi:CheckInEventRecord semi:CheckOutEventRecord)
    ] ;
    rdfs:range semi:ProductionLot ;
    rdfs:label "作用批次" ;
    rdfs:comment "事件执行时的输入/主体批次（matrix_routerx_operation_lot_batch_resume_log.lot_code）。各子类关联语义：SplitEventRecord→源批次（被拆分的父批次）；MergeEventRecord→源批次（被并入目标批次的来源批次）；AccumulateEventRecord→源批次（多个同产品型号批次之一，物理上每条源批次记录对应一行，共享同一 output_lot_id）；HoldEventRecord/ReleaseEventRecord→被扣留/释放批次；NGRecordEventRecord→被标记不良批次；CheckInEventRecord/CheckOutEventRecord→进/出站批次。" .

semi:producesLot a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (semi:SplitEventRecord semi:AccumulateEventRecord)
    ] ;
    rdfs:range semi:ProductionLot ;
    rdfs:label "产出批次" ;
    rdfs:comment "谱系生成型事件执行后产生的新批次（MES 自动生成的 ProductionLot ID），对应 output_lot_code 字段。SplitEventRecord：拆批后析出的新子批次；AccumulateEventRecord：多个源批次攒批后生成的全新批次（所有源批次的 output_lot_code 指向同一新批次）。区别于 MergeEventRecord 的 mergesIntoLot：攒批产出的是全新批次，并批的目标是已存在的父批次。" .

semi:producesSublot a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (semi:SplitEventRecord semi:AccumulateEventRecord)
    ] ;
    rdfs:range semi:Sublot ;
    rdfs:label "产出子批次" ;
    rdfs:comment "谱系生成型事件执行后，为产出批次同步创建的初始 Sublot 实例。与 producesLot 一一对应。SplitEventRecord：拆批时新批次的初始子批次；AccumulateEventRecord：攒批后新批次的初始子批次（所有被攒入 wafer 的 belongsToSublot 更新指向此 Sublot）。stateTransitionFunction 依赖此属性更新被迁移晶圆的 belongsToSublot 指针，保证 Wafer→belongsToSublot→atStation 路径在谱系操作后仍然连通。物理层对应 matrix_routerx_operation_lot 中与新批次绑定的初始记录行。" .

semi:affectsWafer a owl:ObjectProperty ;
    owl:equivalentProperty semi:actsOnWafer ;
    rdfs:domain semi:SplitEventRecord ; rdfs:range semi:Wafer ;
    rdfs:label "（兼容别名）操作涉及的Wafer" ;
    rdfs:comment "【别名属性，语义等同于 semi:actsOnWafer】保留用于向后兼容 SplitEventRecord 的拆批逐片Wafer迁移场景。推荐使用 semi:actsOnWafer。" .

semi:mergesIntoLot a owl:ObjectProperty ;
    rdfs:domain semi:MergeEventRecord ; rdfs:range semi:ProductionLot ;
    rdfs:label "并入目标批次" ;
    rdfs:comment "并批操作的接收方/目标批次（原父批次）。并批后源批次（actsOnLot）下所有 Sublot 和 Wafer 的 lot_id 归属更新指向此目标批次。区别于 actsOnLot：actsOnLot 是操作的源批次（被消耗方），mergesIntoLot 是目标批次（接收方）。物理对应：matrix_routerx_operation_lot_batch_resume_log.output_lot_code / output_lot_id FK。" .

# 2.7 载具层级关联 (Carrier Hierarchy)
semi:belongsToGroup a owl:ObjectProperty ;
    rdfs:domain semi:Carrier ; rdfs:range semi:CarrierGroup ;
    rdfs:label "归属载具组" ;
    rdfs:comment "载具实例归属于某个载具组，反映工厂对同类载具的逻辑分组管理。" .

semi:hasModel a owl:ObjectProperty ;
    rdfs:domain semi:Carrier ; rdfs:range semi:CarrierModel ;
    rdfs:label "关联载具模型" ;
    rdfs:comment "载具实例关联所属载具模型，从模型继承规格参数（容量、额定寿命等）。" .

semi:usesLoadCarrierGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:CarrierGroup ;
    rdfs:label "进站载具组约束" ;
    rdfs:comment "工序进站时物料所在载具必须属于该载具组，对应 matrix_routerx_config_process.load_carrier_group_id。" .

semi:usesUnloadCarrierGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:CarrierGroup ;
    rdfs:label "出站载具组约束" ;
    rdfs:comment "工序出站时物料转移的目标载具必须属于该载具组，对应 matrix_routerx_config_process.unload_carrier_group_id。" .

### ==========================================
### 3. 数据属性与元数据 (Data & Metadata)
### ==========================================
### 设计原则：
###   - TTL DatatypeProperty 定义语义属性名（"这个字段叫什么"）
###   - mapping_prod.json 的 properties 字段维护物理绑定（"这个语义属性映射哪列"）
###   - 只对有业务语义的字段建模，审计字段(create_user_id/deleted/trace_id等)不建模
### ==========================================

# 3.1 状态属性（unionOf 显式声明域，涵盖全部有状态本体类）
semi:hasState a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (
        semi:Wafer semi:ProductionLot semi:Sublot
        semi:Equipment
        semi:ProductModel semi:ProductionOrder
        semi:BOM semi:Recipe
        semi:Material semi:RawMaterial semi:Auxiliary semi:SparePart semi:Product
    ) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "状态标记" ;
    rdfs:comment "各类状态字段：大多数类对应 status 列（整数枚举），ProductModel 对应 product_status；各枚举值及物理列映射见 mapping_prod.json properties（语义→列）及 value_mappings（值→语义）。" .

semi:isQualified a owl:DatatypeProperty ;
    rdfs:domain semi:Equipment ;
    rdfs:range xsd:boolean ;
    rdfs:label "认证状态(Qual)" ;
    rdfs:comment "设备是否通过工艺认证(Qual run)；当前数据库无独立列直接存储，mapping 对应 null（语义建模保留，查询时需通过设备状态/日志推导）。" .



semi:hasVersion a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessStation semi:Route semi:ProductModel semi:BOM semi:Recipe) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "版本号" ;
    rdfs:comment "版本控制字段：ProcessStation 对应 version，Route / ProductModel / BOM / Recipe 对应 version_n（字段名因表而异）。" .

# 3.2 Wafer 数据属性
semi:hasWaferCode a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:string ;
    rdfs:label "晶圆编号" ;
    rdfs:comment "晶圆唯一标识，对应 matrix_routerx_operation_lot_wafer.wafer_code。" .

semi:hasSlotNo a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:integer ;
    rdfs:label "槽位号" ;
    rdfs:comment "晶圆在载具中的物理位置编号，对应 matrix_routerx_operation_lot_wafer.slot_no。与 semi:isLoadedIn（Wafer→Carrier）共同构成完整的'载具坐标'：isLoadedIn 表达'在哪个载具'，hasSlotNo 表达'在该载具的第几号槽位'。槽位号是数据属性（直接过滤：WHERE slot_no=N），载具是对象属性（需 JOIN carrier_info）。" .

semi:hasNGCode a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:string ;
    rdfs:label "NG码" ;
    rdfs:comment "不良原因/NG分类码，对应 ng_code。" .

semi:waferLevel a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:integer ;
    rdfs:label "晶圆质量等级" ;
    rdfs:comment "晶圆质量状态等级，对应 matrix_routerx_operation_lot_wafer.level 字段。枚举值见 semi:WaferLevel：1=OK、2=NG、3=GOODSAMPLE、9=LOSS。" .

# 3.3 生产批次 / 子批次 数据属性
semi:hasLotCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProductionLot semi:Sublot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "批次号" ;
    rdfs:comment "批次唯一业务标识符，对应 current_lot_code（批次/子批次）。动作执行记录中的批次引用通过 semi:ProductionEventRecord 的对象属性 actsOnLot / producesLot 建立，不在此属性定义。" .

semi:hasProcessStatus a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProductionLot semi:Sublot) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "站点加工状态" ;
    rdfs:comment "批次在当前工序的站点级加工阶段（≠批次整体状态 hasState.status）：0=待进站、50=已进站待执行、100=执行中、150=待出站、200=已出站，对应 process_status。" .

# 在制状态（WIP三态）：推导型状态类
# 不对应批次表中的单一字段，由 process_status 字段值与扣留历史共同推导
# 三态：Run / IDLE / Hold（Hold优先级最高，覆盖其他状态）
#
# ⚠ 重要区分：
#   status=80 (BatchStatus.Staged/暂存) ≠ 激活扣留
#   前者是批次整体状态字段，后者由扣留事件记录推导；两者独立，不可互换。
#
# 物理实现（_h = HoldEventRecord, _r = ReleaseEventRecord）：
#   激活扣留 = EXISTS (_h: operation_type=4, deleted=0, 且无晚于 _h 的 _r: operation_type=5)
#
#   Run  → process_status IN (50,100,150) AND NOT EXISTS(激活扣留)
#   IDLE → process_status IN (0,200)      AND NOT EXISTS(激活扣留)
#   Hold → EXISTS(激活扣留)，不论 process_status 取值
# semi:LotWIPStatus — 推导型在制状态三态枚举（Run / IDLE / Hold）
# ⚠ 不声明为 owl:Class：LotWIPStatus 是计算推导值（derived status），无独立个体，
#   不作为对象属性的值域类，不应在本体可视化中渲染为节点。
#   枚举值与 SQL 推导条件定义在 mapping_prod.json → value_mappings["semi:LotWIPStatus"]。
#   属性引用方式：semi:hasLotWIPStatus rdfs:range xsd:string（枚举字符串：Run/IDLE/Hold）。

semi:hasLotType a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionLot ;
    rdfs:range xsd:integer ;
    rdfs:label "批次类型" ;
    rdfs:comment "批次分类标识，对应 type 字段。" .

semi:hasWaferStatistics a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionLot ;
    rdfs:range xsd:string ;
    rdfs:label "晶圆统计" ;
    rdfs:comment "批次内晶圆数量的JSON统计信息，对应 wafer_statistics。" .

semi:hasProductCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProductionOrder semi:ProductionLot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "品种编码" ;
    rdfs:comment "产品/品种编码（反规范化冗余字段），对应 product_code。" .

semi:hasRecipeCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Recipe semi:ProductionLot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "配方编码" ;
    rdfs:comment "对应 recipe_manage.code 或批次的反规范化字段 recipe_code。" .

semi:hasCarrierCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Carrier semi:ProductionLot semi:Sublot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "载具编码" ;
    rdfs:comment "载具唯一标识，对应 carrier_info.code（载具实体）或 lot.carrier_code（批次当前绑定载具）。" .

# 3.4 工艺站点数据属性
semi:hasStationCode a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessStation ;
    rdfs:range xsd:string ;
    rdfs:label "工序编码" .

semi:hasStationName a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessStation ;
    rdfs:range xsd:string ;
    rdfs:label "工序名称" .

semi:hasStationType a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessStation ;
    rdfs:range xsd:integer ;
    rdfs:label "工序类型" ;
    rdfs:comment "工序分类枚举（整数），对应 matrix_routerx_config_process.type，区分普通工序、检查站、合并站等类型。" .

# 3.5 设备与设备组数据属性

# 3.5.1 设备实体 (Equipment)
semi:hasEquipmentCode a owl:DatatypeProperty ;
    rdfs:domain semi:Equipment ;
    rdfs:range xsd:string ;
    rdfs:label "设备编码" .

semi:hasEquipmentName a owl:DatatypeProperty ;
    rdfs:domain semi:Equipment ;
    rdfs:range xsd:string ;
    rdfs:label "设备名称" .

# 3.5.2 设备组 (EquipmentGroup)
semi:hasEquipmentGroupName a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentGroup ;
    rdfs:range xsd:string ;
    rdfs:label "设备组名称" ;
    rdfs:comment "对应 equipment_group.equipment_group_name。" .

semi:hasEquipmentGroupDesc a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentGroup ;
    rdfs:range xsd:string ;
    rdfs:label "设备组描述" ;
    rdfs:comment "对应 equipment_group.equipment_group_desc。" .

# 3.5.3 设备模型 (EquipmentModel)
semi:hasEquipmentModelCode a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "设备模型编码" ;
    rdfs:comment "设备型号的唯一标识编码，对应 equipment_model.code。" .

semi:hasEquipmentModelName a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "设备模型名称" ;
    rdfs:comment "设备型号名称，对应 equipment_model.name。" .

semi:hasSpecification a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "规格" ;
    rdfs:comment "设备模型的技术规格参数描述，对应 equipment_model.specification。" .

semi:hasManufacturer a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "生产厂家" ;
    rdfs:comment "设备型号的生产厂家名称，对应 equipment_model.manufacturer。" .

semi:hasEquipmentRatedLifetime a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:integer ;
    rdfs:label "额定寿命" ;
    rdfs:comment "该型号设备的额定总寿命（运行小时数或维护周期），对应 equipment_model.rated_lifetime。当设备当前寿命达到此值时触发报废预警或大修计划。" .

# 3.6 载具数据属性

# 3.6.1 载具实体 (Carrier) 专属属性 (载具编码 hasCarrierCode 已在 3.3 定义)
semi:hasCarrierType a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Carrier semi:CarrierModel) ] ;
    rdfs:range xsd:string ;
    rdfs:label "载具类型码" ;
    rdfs:comment "载具类型分类标识，对应 type_code；CarrierModel 中为型号分类，Carrier 中为实例类型码。" .

semi:hasMaintenanceStatus a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "载具保养状态" ;
    rdfs:comment "载具当前保养状态，对应 carrier_info.status 字段：1=保养中、2=可用、3=待保养。枚举见 semi:CarrierMaintenanceStatus。" .

semi:hasLoadStatus a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "载具装载状态" ;
    rdfs:comment "载具物料装载状态，对应 carrier_info.sub_status 字段：0=空（无物料）、1=非空（有物料装载）。枚举见 semi:CarrierLoadStatus。" .

semi:hasCapacity a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Carrier semi:CarrierModel) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "载具容量" ;
    rdfs:comment "载具可容纳的最大晶圆/物料数量，对应 capacity；CarrierModel 中为标称设计容量。" .

semi:hasMaintenanceCountdown a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "距下次保养计数" ;
    rdfs:comment "距离下一次保养的剩余使用计数（单位由 maintenance_countdown_unit 指定），对应 carrier_info.maintenance_countdown。" .

semi:hasRemainingLife a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "剩余寿命" ;
    rdfs:comment "载具剩余可用寿命计数（单位由 usage_unit 指定），对应 carrier_info.remaining_useful_life。" .

# 3.6.2 载具模型 (CarrierModel) 数据属性
semi:hasCarrierModelCode a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:string ;
    rdfs:label "载具模型编码" ;
    rdfs:comment "载具型号的唯一标识编码。" .

semi:hasCarrierModelName a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:string ;
    rdfs:label "载具模型名称" ;
    rdfs:comment "载具型号名称。" .

semi:hasCarrierSize a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:string ;
    rdfs:label "载具尺寸" ;
    rdfs:comment "载具物理尺寸规格描述（如 8寸/12寸），对应型号尺寸字段。" .

semi:hasRatedLifetime a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:integer ;
    rdfs:label "额定寿命" ;
    rdfs:comment "该型号载具的设计额定总寿命（与 usage_unit 单位一致）。" .

semi:hasSupplier a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:string ;
    rdfs:label "供应商" ;
    rdfs:comment "载具型号的供应商名称或编码。" .

# 3.6.3 载具组 (CarrierGroup) 数据属性
semi:hasCarrierGroupCode a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierGroup ;
    rdfs:range xsd:string ;
    rdfs:label "载具组编码" ;
    rdfs:comment "载具组的唯一标识编码。" .

semi:hasCarrierGroupName a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierGroup ;
    rdfs:range xsd:string ;
    rdfs:label "载具组名称" ;
    rdfs:comment "载具组名称，通常按类型或用途命名。" .

semi:hasMaintenanceCycle a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierGroup ;
    rdfs:range xsd:integer ;
    rdfs:label "保养周期" ;
    rdfs:comment "该载具组的统一保养周期配置（使用次数/时长，单位由业务规则确定）。" .

# 3.7 工艺路径数据属性
semi:hasRouteCode a owl:DatatypeProperty ;
    rdfs:domain semi:Route ;
    rdfs:range xsd:string ;
    rdfs:label "路径编码" .

semi:hasRouteName a owl:DatatypeProperty ;
    rdfs:domain semi:Route ;
    rdfs:range xsd:string ;
    rdfs:label "路径名称" .

semi:hasRouteType a owl:DatatypeProperty ;
    rdfs:domain semi:Route ;
    rdfs:range xsd:string ;
    rdfs:label "路径类型" ;
    rdfs:comment "工艺路径分类标识，对应 routerx_router_config.route_type（字符串枚举，如主路线/子路线等）。" .

