    rdfs:label "载具模型编码" ;
    rdfs:comment "载具型号的唯一标识编码。" .

semi:hasCarrierModelName a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:string ;
    rdfs:label "载具模型名称" ;
    rdfs:comment "载具型号名称。" .

semi:hasCarrierSize a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:string ;
    rdfs:label "载具尺寸" ;
    rdfs:comment "载具物理尺寸规格描述（如 8寸/12寸），对应型号尺寸字段。" .

semi:hasRatedLifetime a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:integer ;
    rdfs:label "额定寿命" ;
    rdfs:comment "该型号载具的设计额定总寿命（与 usage_unit 单位一致）。" .

semi:hasSupplier a owl:DatatypeProperty ;
