@prefix semi: <http://www.semanticweb.org/semi-mes/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### ==========================================
### 1. 核心类定义 (Classes)
### ==========================================

semi:Wafer a owl:Class ; 
    rdfs:label "晶圆(Wafer)" ;
    rdfs:comment "不可变的最小物理实体标识，全生命周期身份稳定的核心锚点。" .

semi:Material a owl:Class ; 
    rdfs:label "物料" ;
    rdfs:comment "价值的物理载体，包括原料、辅料、备件、产品。" .

semi:Product a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "产品" ;
    rdfs:comment "状态演化的终点产物，受产品模型定义约束。" .

semi:RawMaterial a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "原料" ;
    rdfs:comment "生产投入的初始实物（如 Bare Wafer）。" .

semi:Auxiliary a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "辅料" ;
    rdfs:comment "加工过程中的消耗性资源（如化学药液、特气）。" .

semi:SparePart a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "备件" ;
    rdfs:comment "用于设备维护和状态恢复的更换件。" .


semi:ProductModel a owl:Class ; 
    rdfs:label "产品模型" ;
    rdfs:comment "目标状态(What)与转换约束(How)的规则总成。" .

semi:BOM a owl:Class ; 
    rdfs:label "物料清单(BOM)" ;
    rdfs:comment "物料资源的结构逻辑，定义用什么做。" .

semi:Route a owl:Class ; 
    rdfs:label "工艺路径" ;
    rdfs:comment "制造导航地图，定义物料流转的受控路径。" .

semi:ProcessStation a owl:Class ; 
    rdfs:label "工艺站点(工序)" ;
    rdfs:comment "最小生产控制单元，物料状态转换的场所。" .

semi:ProcessConstraint a owl:Class ;
    rdfs:label "工艺约束" ;
    rdfs:comment "中间类：用于注入产品模型在特定工序下的具体执行规范。" .

semi:ProductionOrder a owl:Class ; 
    rdfs:label "生产工单" ;
    rdfs:comment "企业下发的生产指令，连接经营层与执行层。" .

semi:ProductionLot a owl:Class ; 
    rdfs:label "生产批次(Lot)" ;
    rdfs:comment "管理调度的基本单元，承载生产管理核心信息。" .

semi:Sublot a owl:Class ; 
    rdfs:label "子批次(Sublot)" ;
    rdfs:comment "受载具物理约束下的批次分组投影。" .

semi:Equipment a owl:Class ; 
    rdfs:label "设备" ;
    rdfs:comment "价值转换的执行者，生产过程中最大的变量源。" .

semi:Recipe a owl:Class ; 
    rdfs:label "配方(Recipe)" ;
    rdfs:comment "工艺知识的参数化封装，指导设备如何做。" .

semi:Carrier a owl:Class ; 
    rdfs:label "载具" ;
    rdfs:comment "物理流转的承载工具，设备与物料的物理接口。" .

semi:Action a owl:Class ; 
    rdfs:label "生产动作/操作（抽象父类）" ;
    rdfs:comment "驱动物料或设备状态跳转的逻辑单元。抽象父类，不直接映射物理表。子类：semi:ProductionEvent（事件类型模板）。关联类：semi:ProductionEventRecord（事件执行记录，非 Action 子类，描述某次操作的实际执行结果）。" .

semi:CarrierModel a owl:Class ;
    rdfs:label "载具模型" ;
    rdfs:comment "定义特定规格型号载具的设计模板，包含尺寸、容量、额定寿命等参数；Carrier 是 CarrierModel 下的实例。" .

semi:CarrierGroup a owl:Class ;
    rdfs:label "载具组" ;
    rdfs:comment "同类型载具的逻辑分组，MES 调度抽象单元，被工艺站点引用作为载具可用性约束。" .

semi:EquipmentGroup a owl:Class ;
    rdfs:label "设备组" ;
    rdfs:comment "功能相同的设备的逻辑分组（能力池），被工艺站点直接引用作为派工可行域。工序不硬编码到具体机台，而是指向设备组，支持组内动态派工。" .

semi:EquipmentModel a owl:Class ;
    rdfs:label "设备模型" ;
    rdfs:comment "资产蓝图 (Blueprint)。定义了该型号设备的技术规格与物理极限，基于设备模型统一管理同型号设备的备件、额定寿命与厂商信息；采购依据：新增资产时直接继承模型的规格。" .

# 生产履历追溯类群 (Traceability)
semi:StationPassRecord a owl:Class ;
    rdfs:label "过站记录" ;
    rdfs:comment "Wafer（以批次/子批次为载体）在某道工序完成进出站全流程所产生的不可变历史记录，是履历追溯的基本事实单元。抽象基类，具体分为加工过站记录与量测过站记录。" .

semi:ProcessPassRecord a owl:Class ;
    rdfs:subClassOf semi:StationPassRecord ;
    rdfs:label "加工过站记录" ;
    rdfs:comment "Wafer经过加工工序时的执行记录：采集上下料时间、进出站时间、加工设备及制程参数快照（单片数据或聚合值）。每条记录对应一个子批次在一道加工工序的完整过站事件。" .

semi:MeasurementPassRecord a owl:Class ;
    rdfs:subClassOf semi:StationPassRecord ;
    rdfs:label "量测过站记录" ;
    rdfs:comment "Wafer经过量测工序时的检验记录：包含量测设备信息、抽检规则、逐片或聚合量测参数（取最大/最小/平均值表征批次质量属性）。表征该批次在当前阶段的质量状态快照。" .

semi:ProductionEvent a owl:Class ;
    rdfs:subClassOf semi:Action ;
    rdfs:label "生产事件类型（Action 子类）" ;
    rdfs:comment "定义某类批次操作的规则/类型模板，如拆批(Split)、攒批(Merge)、返工(Rework)、进站、出站等。作为 semi:Action 的子类，表示系统 API 接口层面的操作类型定义；可通过 Named Individuals 枚举具体事件类型，不直接映射物理表。对应的执行记录见 semi:ProductionEventRecord。" .

semi:ProductionEventRecord a owl:Class ;
    rdfs:label "生产事件记录" ;
    rdfs:comment "某次生产事件的实际执行记录，是ProductionEvent(事件类型)与ProductionLot(批次)的关联类。主映射表：matrix_routerx_operation_lot_batch_resume_log；关联从表：_detail（批次状态快照）和 _wafer_detail_log（逐片Wafer明细）。每条记录对应一次具体操作，记录操作人、时间戳、状态变更及输入/输出批次。" .

### ==========================================
### 2. 核心有机关联 (Object Properties)
### ==========================================

# 2.1 Wafer 核心状态向量 (物理实体锚点)
semi:belongsToLot a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:ProductionLot ;
    rdfs:label "属于批次" .

semi:belongsToSublot a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:Sublot ;
    rdfs:label "属于子批次" .

semi:locatedInSlot a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:Carrier ;
    rdfs:label "位于载具槽位" .

semi:atStation a owl:ObjectProperty ;
    rdfs:domain semi:Sublot ; rdfs:range semi:ProcessStation ;
    rdfs:label "当前所处工序(位置向量)" ;
    rdfs:comment "加工以子批次为单位，Sublot当前所处工艺站点。通过Wafer→belongsToSublot→Sublot→atStation→ProcessStation实现2跳路径访问。" .

semi:currentlyFollowsModel a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductModel ;
    rdfs:label "遵循产品模型(目标向量)" .

semi:currentlyOnRoute a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:Route ;
    rdfs:label "当前工艺路径(导航向量)" .

# 2.2 生产管理层级 (Management Hierarchy)
semi:basedOnOrder a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionOrder ;
    rdfs:label "基于工单创建" .

semi:definesRequirementFor a owl:ObjectProperty ;
    rdfs:domain semi:ProductionOrder ; rdfs:range semi:ProductModel ;
    rdfs:label "定义产品规格需求" .

semi:containsSublot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:Sublot ;
    rdfs:label "包含子批次分组" .

semi:isCarriedBy a owl:ObjectProperty ;
    rdfs:domain semi:Sublot ; rdfs:range semi:Carrier ;
    rdfs:label "由载具承载" .

# 2.3 工艺约束注入逻辑 (Core Decoupling Logic)
semi:usesRoute a owl:ObjectProperty ;
    rdfs:domain semi:ProductModel ; rdfs:range semi:Route ;
    rdfs:label "使用工艺路径模板" .

semi:consistsOfStation a owl:ObjectProperty ;
    rdfs:domain semi:Route ; rdfs:range semi:ProcessStation ;
    rdfs:label "包含工序节点" .

semi:hasConstraint a owl:ObjectProperty ;
    rdfs:domain semi:ProductModel ; rdfs:range semi:ProcessConstraint ;
    rdfs:label "注入工艺约束" .

semi:appliesAtStation a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:ProcessStation ;
    rdfs:label "应用于特定工序" .

semi:specifiesRecipe a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:Recipe ;
    rdfs:label "在该工序指定配方" .

# 2.4 物料子类、设备、BOM的关联

# 产品与模型的灵魂绑定
semi:isDefinedBy a owl:ObjectProperty ;
    rdfs:label "由产品模型定义" ;
    rdfs:domain semi:Product ; 
    rdfs:range semi:ProductModel ;
    rdfs:comment "产品模型是该产品的状态转换规则与目标模板总成。" .

# BOM 对原料与辅料的精准消耗
semi:consumesRawMaterial a owl:ObjectProperty ;
    rdfs:label "消耗原料" ;
    rdfs:domain semi:BOM ; 
    rdfs:range semi:RawMaterial .

semi:consumesAuxiliary a owl:ObjectProperty ;
    rdfs:label "消耗辅料" ;
    rdfs:domain semi:BOM ; 
    rdfs:range semi:Auxiliary .

# 备件与设备的运维关联
semi:requiresSparePart a owl:ObjectProperty ;
    rdfs:label "要求备件更换" ;
    rdfs:domain semi:Equipment ; 
    rdfs:range semi:SparePart ;
    rdfs:comment "驱动设备从异常/老化状态回归受控状态。" .

semi:containsEquipment a owl:ObjectProperty ;
    rdfs:domain semi:EquipmentGroup ; rdfs:range semi:Equipment ;
    rdfs:label "设备组包含设备" ;
    rdfs:comment "设备组包含的设备实例，多对多关系（一个设备可属于多个设备组）。对应 equipment_group.equipments JSON 数组，数组元素为 equipment.id。" .

semi:isInstanceOf a owl:ObjectProperty ;
    rdfs:domain semi:Equipment ; rdfs:range semi:EquipmentModel ;
    rdfs:label "设备型号" ;
    rdfs:comment "设备实例所属设备模型（型号），从模型继承额定寿命、规格参数等。当设备当前寿命达到 EquipmentModel 定义的额定寿命时，系统自动触发报废预警或大修计划。N:1 关系（多台设备可属同一型号）。" .

semi:usesEquipmentGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:EquipmentGroup ;
    rdfs:label "工序绑定可用设备组" ;
    rdfs:comment "工序引用设备组作为派工可行域，对应 matrix_routerx_config_process.equipment_group_list（JSON 数组）。" .

semi:hostsRecipe a owl:ObjectProperty ;
    rdfs:domain semi:Equipment ; rdfs:range semi:Recipe ;
    rdfs:label "物理驻留配方" .

semi:hasBOM a owl:ObjectProperty ;
    rdfs:domain semi:ProductModel ; rdfs:range semi:BOM ;
    rdfs:label "关联BOM定义" .

semi:anchoredAtStation a owl:ObjectProperty ;
    rdfs:domain semi:BOM ; rdfs:range semi:ProcessStation ;
    rdfs:label "物料消耗锚定工序" .


# 2.5 动作驱动与跳转 (Action Logic)
semi:hasInput a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEvent ; rdfs:range semi:ProductionLot ;
    rdfs:label "动作输入" ;
    rdfs:comment "本次操作的输入批次（ProductionLot）。domain 为 semi:ProductionEvent（事件类型），不继承自抽象父类 Action。具体执行记录中的批次关联见 semi:ProductionEventRecord.actsOnLot。" .

semi:hasOutput a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEvent ; rdfs:range semi:ProductionLot ;
    rdfs:label "动作输出" ;
    rdfs:comment "本次操作产生的输出批次（ProductionLot）。domain 为 semi:ProductionEvent（事件类型），不继承自抽象父类 Action。具体执行记录中的批次关联见 semi:ProductionEventRecord.producesLot。" .

semi:modifiesStateVector a owl:ObjectProperty ;
    rdfs:domain semi:Action ; rdfs:label "修改状态向量" ;
    rdfs:comment "Action 驱动批次(ProductionLot)状态机跳转，间接修改批次所含 Sublot 的 atStation 等动态指针；不直接关联 Wafer 实例。" .

semi:hasParentLot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionLot ;
    rdfs:label "父批次(溯源)" .

# 2.6 生产履历追溯对象属性 (Traceability Object Properties)

semi:hasPassRecord a owl:ObjectProperty ;
    rdfs:domain semi:Sublot ; rdfs:range semi:StationPassRecord ;
    rdfs:label "子批次过站记录" ;
    rdfs:comment "子批次在某道工序产生的过站执行记录（加工或量测），是Wafer生产履历的基本事实节点。反向关联：station_pass_record.sublot_id → matrix_routerx_operation_lot.id。" .

semi:recordedAtStation a owl:ObjectProperty ;
    rdfs:domain semi:StationPassRecord ; rdfs:range semi:ProcessStation ;
    rdfs:label "过站所在工序" ;
    rdfs:comment "该过站记录对应的工艺站点，是在时间轴上定位Wafer所处制造位置的锚点。" .

semi:processedByEquipment a owl:ObjectProperty ;
    rdfs:domain semi:StationPassRecord ; rdfs:range semi:Equipment ;
    rdfs:label "过站使用设备" ;
    rdfs:comment "执行本次加工或量测的具体设备实例。与Equipment的关联构成'Wafer-工序-设备'三元组，支持从设备维度反查'某台设备何时加工了哪些批次'。" .

semi:splitInto a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionLot ;
    rdfs:label "拆批为" ;
    rdfs:comment "拆批(Split)操作：一个批次拆分为多个子批次，每个输出批次的 parent_id 指向源批次。此关系是 hasParentLot 的反向语义。在谱系DAG中表现为一对多的发散节点。" .

semi:mergedFrom a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionLot ;
    rdfs:label "攒批自" ;
    rdfs:comment "攒批/合批(Merge)操作：多个源批次合并为一个新批次。在谱系DAG中表现为多对一的汇聚节点，是追溯断点的最常见来源。" .

semi:reworkedAs a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionLot ;
    rdfs:label "返工为" ;
    rdfs:comment "返工(Rework)操作：被判定为Reject的批次重新投入加工，衍生出运行于返工工艺路径的新批次标识。返工完成若判定Good则在谱系图中归并回主路径。多次返工形成循环切出-回归的有向路径。" .

semi:isInstanceOfEvent a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ; rdfs:range semi:ProductionEvent ;
    rdfs:label "事件类型" ;
    rdfs:comment "该执行记录对应的事件类型（如SPLIT、MERGE、REWORK等ProductionEvent实例），关联record到event类型定义。" .

semi:actsOnLot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ; rdfs:range semi:ProductionLot ;
    rdfs:label "作用批次" ;
    rdfs:comment "事件执行时的输入/主体批次（matrix_routerx_operation_lot_batch_resume_log.lot_code）。对于进出站等单批次操作，actsOnLot与producesLot指向同一批次。" .

semi:producesLot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ; rdfs:range semi:ProductionLot ;
    rdfs:label "产出批次" ;
    rdfs:comment "事件执行后产生的输出批次（matrix_routerx_operation_lot_batch_resume_log.output_lot_code）。对于拆批操作，产出批次与作用批次不同；对于状态变更操作，两者相同。" .

semi:producesSublot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ; rdfs:range semi:Sublot ;
    rdfs:label "产出子批次" ;
    rdfs:comment "谱系变更事件（拆批/并批/返工）执行后，为产出批次同步创建的初始 Sublot 实例。与 producesLot 一一对应（新批次在拆批时只有一个初始子批次）。stateTransitionFunction 依赖此属性更新被迁移晶圆的 belongsToSublot 指针，保证 Wafer→belongsToSublot→atStation 路径在拆批后仍然连通。物理层对应 matrix_routerx_operation_lot 中与新批次绑定的初始记录行。" .

semi:affectsWafer a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ; rdfs:range semi:Wafer ;
    rdfs:label "操作涉及的Wafer" ;
    rdfs:comment "事件执行时涉及的具体晶圆实例。在拆批场景中记录被从源批次迁移到新批次的晶圆；在量测场景中记录抽检晶圆；在返工场景中记录受返工影响的晶圆。支持从事件维度反查 Wafer 粒度的生产履历，实现逐片血缘闭环。物理层对应三联日志表中的 wafer_detail_log 明细行。" .

# 2.7 载具层级关联 (Carrier Hierarchy)
semi:belongsToGroup a owl:ObjectProperty ;
    rdfs:domain semi:Carrier ; rdfs:range semi:CarrierGroup ;
    rdfs:label "归属载具组" ;
    rdfs:comment "载具实例归属于某个载具组，反映工厂对同类载具的逻辑分组管理。" .

semi:hasModel a owl:ObjectProperty ;
    rdfs:domain semi:Carrier ; rdfs:range semi:CarrierModel ;
    rdfs:label "关联载具模型" ;
    rdfs:comment "载具实例关联所属载具模型，从模型继承规格参数（容量、额定寿命等）。" .

semi:usesLoadCarrierGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:CarrierGroup ;
    rdfs:label "进站载具组约束" ;
    rdfs:comment "工序进站时物料所在载具必须属于该载具组，对应 matrix_routerx_config_process.load_carrier_group_id。" .

semi:usesUnloadCarrierGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:CarrierGroup ;
    rdfs:label "出站载具组约束" ;
    rdfs:comment "工序出站时物料转移的目标载具必须属于该载具组，对应 matrix_routerx_config_process.unload_carrier_group_id。" .

### ==========================================
### 3. 数据属性与元数据 (Data & Metadata)
### ==========================================
### 设计原则：
###   - TTL DatatypeProperty 定义语义属性名（"这个字段叫什么"）
###   - mapping_prod.json 的 properties 字段维护物理绑定（"这个语义属性映射哪列"）
###   - 只对有业务语义的字段建模，审计字段(create_user_id/deleted/trace_id等)不建模
### ==========================================

# 3.1 状态属性（unionOf 显式声明域，涵盖全部有状态本体类）
semi:hasState a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (
        semi:Wafer semi:ProductionLot semi:Sublot
        semi:Equipment
        semi:ProductModel semi:ProductionOrder
        semi:BOM semi:Recipe
        semi:Material semi:RawMaterial semi:Auxiliary semi:SparePart semi:Product
    ) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "状态标记" ;
    rdfs:comment "各类状态字段：大多数类对应 status 列（整数枚举），ProductModel 对应 product_status；各枚举值及物理列映射见 mapping_prod.json properties（语义→列）及 value_mappings（值→语义）。" .

semi:isQualified a owl:DatatypeProperty ;
    rdfs:domain semi:Equipment ;
    rdfs:range xsd:boolean ;
    rdfs:label "认证状态(Qual)" ;
    rdfs:comment "设备是否通过工艺认证(Qual run)；当前数据库无独立列直接存储，mapping 对应 null（语义建模保留，查询时需通过设备状态/日志推导）。" .

semi:hasControlLimit a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "制程卡控界限" ;
    rdfs:comment "工艺参数的上下控制边界，ProcessConstraint 为虚拟中间类（无独立表），物理层嵌入 matrix_routerx_config_process 配置字段中。" .

semi:hasVersion a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessStation semi:Route semi:ProductModel semi:BOM semi:Recipe) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "版本号" ;
    rdfs:comment "版本控制字段：ProcessStation 对应 version，Route / ProductModel / BOM / Recipe 对应 version_n（字段名因表而异）。" .

# 3.2 Wafer 数据属性
semi:hasWaferCode a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:string ;
    rdfs:label "晶圆编号" ;
    rdfs:comment "晶圆唯一标识，对应 matrix_routerx_operation_lot_wafer.wafer_code。" .

semi:hasSlotNo a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:integer ;
    rdfs:label "槽位号" ;
    rdfs:comment "晶圆在载具中的物理位置，对应 slot_no。" .

semi:hasNGCode a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:string ;
    rdfs:label "NG码" ;
    rdfs:comment "不良原因/NG分类码，对应 ng_code。" .

semi:waferLevel a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:integer ;
    rdfs:label "晶圆质量等级" ;
    rdfs:comment "晶圆质量状态等级，对应 matrix_routerx_operation_lot_wafer.level 字段。枚举值见 semi:WaferLevel：1=OK、2=NG、3=GOODSAMPLE、9=LOSS。" .

# 3.3 生产批次 / 子批次 数据属性
semi:hasLotCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProductionLot semi:Sublot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "批次号" ;
    rdfs:comment "批次唯一业务标识符，对应 current_lot_code（批次/子批次）。动作执行记录中的批次引用通过 semi:ProductionEventRecord 的对象属性 actsOnLot / producesLot 建立，不在此属性定义。" .

semi:hasProcessStatus a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProductionLot semi:Sublot) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "站点加工状态" ;
    rdfs:comment "批次在当前工序的站点级加工阶段（≠批次整体状态 hasState.status）：0=待进站、50=已进站待执行、100=执行中、150=待出站、200=已出站，对应 process_status。" .

semi:hasLotType a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionLot ;
    rdfs:range xsd:integer ;
    rdfs:label "批次类型" ;
    rdfs:comment "批次分类标识，对应 type 字段。" .

semi:hasWaferStatistics a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionLot ;
    rdfs:range xsd:string ;
    rdfs:label "晶圆统计" ;
    rdfs:comment "批次内晶圆数量的JSON统计信息，对应 wafer_statistics。" .

semi:hasProductCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProductionOrder semi:ProductionLot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "品种编码" ;
    rdfs:comment "产品/品种编码（反规范化冗余字段），对应 product_code。" .

semi:hasRecipeCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Recipe semi:ProductionLot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "配方编码" ;
    rdfs:comment "对应 recipe_manage.code 或批次的反规范化字段 recipe_code。" .

semi:hasCarrierCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Carrier semi:ProductionLot semi:Sublot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "载具编码" ;
    rdfs:comment "载具唯一标识，对应 carrier_info.code（载具实体）或 lot.carrier_code（批次当前绑定载具）。" .

# 3.4 工艺站点数据属性
semi:hasStationCode a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessStation ;
    rdfs:range xsd:string ;
    rdfs:label "工序编码" .

semi:hasStationName a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessStation ;
    rdfs:range xsd:string ;
    rdfs:label "工序名称" .

semi:hasStationType a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessStation ;
    rdfs:range xsd:integer ;
    rdfs:label "工序类型" ;
    rdfs:comment "工序分类枚举（整数），对应 matrix_routerx_config_process.type，区分普通工序、检查站、合并站等类型。" .

# 3.5 设备与设备组数据属性

# 3.5.1 设备实体 (Equipment)
semi:hasEquipmentCode a owl:DatatypeProperty ;
    rdfs:domain semi:Equipment ;
    rdfs:range xsd:string ;
    rdfs:label "设备编码" .

semi:hasEquipmentName a owl:DatatypeProperty ;
    rdfs:domain semi:Equipment ;
    rdfs:range xsd:string ;
    rdfs:label "设备名称" .

# 3.5.2 设备组 (EquipmentGroup)
semi:hasEquipmentGroupName a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentGroup ;
    rdfs:range xsd:string ;
    rdfs:label "设备组名称" ;
    rdfs:comment "对应 equipment_group.equipment_group_name。" .

semi:hasEquipmentGroupDesc a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentGroup ;
    rdfs:range xsd:string ;
    rdfs:label "设备组描述" ;
    rdfs:comment "对应 equipment_group.equipment_group_desc。" .

# 3.5.3 设备模型 (EquipmentModel)
semi:hasEquipmentModelCode a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "设备模型编码" ;
    rdfs:comment "设备型号的唯一标识编码，对应 equipment_model.code。" .

semi:hasEquipmentModelName a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "设备模型名称" ;
    rdfs:comment "设备型号名称，对应 equipment_model.name。" .

semi:hasSpecification a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "规格" ;
    rdfs:comment "设备模型的技术规格参数描述，对应 equipment_model.specification。" .

semi:hasManufacturer a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "生产厂家" ;
    rdfs:comment "设备型号的生产厂家名称，对应 equipment_model.manufacturer。" .

semi:hasEquipmentRatedLifetime a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:integer ;
    rdfs:label "额定寿命" ;
    rdfs:comment "该型号设备的额定总寿命（运行小时数或维护周期），对应 equipment_model.rated_lifetime。当设备当前寿命达到此值时触发报废预警或大修计划。" .

# 3.6 载具数据属性

# 3.6.1 载具实体 (Carrier) 专属属性 (载具编码 hasCarrierCode 已在 3.3 定义)
semi:hasCarrierType a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Carrier semi:CarrierModel) ] ;
    rdfs:range xsd:string ;
    rdfs:label "载具类型码" ;
    rdfs:comment "载具类型分类标识，对应 type_code；CarrierModel 中为型号分类，Carrier 中为实例类型码。" .

semi:hasMaintenanceStatus a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "载具保养状态" ;
    rdfs:comment "载具当前保养状态，对应 carrier_info.status 字段：1=保养中、2=可用、3=待保养。枚举见 semi:CarrierMaintenanceStatus。" .

semi:hasLoadStatus a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "载具装载状态" ;
    rdfs:comment "载具物料装载状态，对应 carrier_info.sub_status 字段：0=空（无物料）、1=非空（有物料装载）。枚举见 semi:CarrierLoadStatus。" .

semi:hasCapacity a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Carrier semi:CarrierModel) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "载具容量" ;
    rdfs:comment "载具可容纳的最大晶圆/物料数量，对应 capacity；CarrierModel 中为标称设计容量。" .

semi:hasMaintenanceCountdown a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "距下次保养计数" ;
    rdfs:comment "距离下一次保养的剩余使用计数（单位由 maintenance_countdown_unit 指定），对应 carrier_info.maintenance_countdown。" .

semi:hasRemainingLife a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "剩余寿命" ;
    rdfs:comment "载具剩余可用寿命计数（单位由 usage_unit 指定），对应 carrier_info.remaining_useful_life。" .

# 3.6.2 载具模型 (CarrierModel) 数据属性
