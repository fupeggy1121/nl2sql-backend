@prefix semi: <http://www.semanticweb.org/semi-mes/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### ==========================================
### 1. 核心类定义 (Classes)
### ==========================================

semi:Wafer a owl:Class ; 
    rdfs:label "晶圆(Wafer)" ;
    rdfs:comment "不可变的最小物理实体标识，全生命周期身份稳定的核心锚点。" .

semi:Material a owl:Class ; 
    rdfs:label "物料" ;
    rdfs:comment "价值的物理载体，包括原料、辅料、备件、产品。" .

semi:Product a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "产品" ;
    rdfs:comment "状态演化的终点产物，受产品模型定义约束。" .

semi:RawMaterial a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "原料" ;
    rdfs:comment "生产投入的初始实物（如 Bare Wafer）。" .

semi:Auxiliary a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "辅料" ;
    rdfs:comment "加工过程中的消耗性资源（如化学药液、特气）。" .

semi:SparePart a owl:Class ; 
    rdfs:subClassOf semi:Material ; 
    rdfs:label "备件" ;
    rdfs:comment "用于设备维护和状态恢复的更换件。" .


semi:ProductModel a owl:Class ; 
    rdfs:label "产品模型" ;
    rdfs:comment "目标状态(What)与转换约束(How)的规则总成。" .

semi:BOM a owl:Class ; 
    rdfs:label "物料清单(BOM)" ;
    rdfs:comment "物料资源的结构逻辑，定义用什么做。" .

semi:Route a owl:Class ; 
    rdfs:label "工艺路径" ;
    rdfs:comment "制造导航地图，定义物料流转的受控路径。" .

semi:ProcessStation a owl:Class ; 
    rdfs:label "工艺站点(工序)" ;
    rdfs:comment "最小生产控制单元，物料状态转换的场所。" .

semi:ProcessConstraint a owl:Class ;
    rdfs:label "工艺约束" ;
    rdfs:comment "中间类：用于注入产品模型在特定工序下的具体执行规范。" .

semi:ProductionOrder a owl:Class ; 
    rdfs:label "生产工单" ;
    rdfs:comment "企业下发的生产指令，连接经营层与执行层。" .

semi:ProductionLot a owl:Class ; 
    rdfs:label "生产批次(Lot)" ;
    rdfs:comment "管理调度的基本单元，承载生产管理核心信息。" .

semi:Sublot a owl:Class ; 
    rdfs:label "子批次(Sublot)" ;
    rdfs:comment "受载具物理约束下的批次分组投影。" .

semi:Equipment a owl:Class ; 
    rdfs:label "设备" ;
    rdfs:comment "价值转换的执行者，生产过程中最大的变量源。" .

semi:Recipe a owl:Class ; 
    rdfs:label "配方(Recipe)" ;
    rdfs:comment "工艺知识的参数化封装，指导设备如何做。" .

semi:Carrier a owl:Class ; 
    rdfs:label "载具" ;
    rdfs:comment "物理流转的承载工具，设备与物料的物理接口。" .

semi:Action a owl:Class ; 
    rdfs:label "生产动作/操作（抽象父类）" ;
    rdfs:comment "驱动物料或设备状态跳转的逻辑单元。抽象父类，不直接映射物理表。子类：semi:ProductionEvent（事件类型模板）。关联类：semi:ProductionEventRecord（事件执行记录，非 Action 子类，描述某次操作的实际执行结果）。" .

semi:CarrierModel a owl:Class ;
    rdfs:label "载具模型" ;
    rdfs:comment "定义特定规格型号载具的设计模板，包含尺寸、容量、额定寿命等参数；Carrier 是 CarrierModel 下的实例。" .

semi:CarrierGroup a owl:Class ;
    rdfs:label "载具组" ;
    rdfs:comment "同类型载具的逻辑分组，MES 调度抽象单元，被工艺站点引用作为载具可用性约束。" .

semi:EquipmentGroup a owl:Class ;
    rdfs:label "设备组" ;
    rdfs:comment "功能相同的设备的逻辑分组（能力池），被工艺站点直接引用作为派工可行域。工序不硬编码到具体机台，而是指向设备组，支持组内动态派工。" .

semi:EquipmentModel a owl:Class ;
    rdfs:label "设备模型" ;
    rdfs:comment "资产蓝图 (Blueprint)。定义了该型号设备的技术规格与物理极限，基于设备模型统一管理同型号设备的备件、额定寿命与厂商信息；采购依据：新增资产时直接继承模型的规格。" .

# 生产履历追溯类群 (Traceability)
semi:StationPassRecord a owl:Class ;
    rdfs:label "过站记录" ;
    rdfs:comment "Wafer（以批次/子批次为载体）在某道工序完成进出站全流程所产生的不可变历史记录，是履历追溯的基本事实单元。抽象基类，具体分为加工过站记录与量测过站记录。" .

semi:ProcessPassRecord a owl:Class ;
    rdfs:subClassOf semi:StationPassRecord ;
    rdfs:label "加工过站记录" ;
    rdfs:comment "Wafer经过加工工序时的执行记录：采集上下料时间、进出站时间、加工设备及制程参数快照（单片数据或聚合值）。每条记录对应一个子批次在一道加工工序的完整过站事件。" .

semi:MeasurementPassRecord a owl:Class ;
    rdfs:subClassOf semi:StationPassRecord ;
    rdfs:label "量测过站记录" ;
    rdfs:comment "Wafer经过量测工序时的检验记录：包含量测设备信息、抽检规则、逐片或聚合量测参数（取最大/最小/平均值表征批次质量属性）。表征该批次在当前阶段的质量状态快照。" .

semi:ProductionEvent a owl:Class ;
    rdfs:subClassOf semi:Action ;
    rdfs:label "生产事件类型（Action 子类）" ;
    rdfs:comment "定义某类批次操作的规则/类型模板，如拆批(Split)、攒批(Merge)、返工(Rework)、进站、出站等。作为 semi:Action 的子类，表示系统 API 接口层面的操作类型定义；可通过 Named Individuals 枚举具体事件类型，不直接映射物理表。对应的执行记录见 semi:ProductionEventRecord。" .

semi:ProductionEventRecord a owl:Class ;
    rdfs:label "生产事件记录" ;
    rdfs:comment "某次生产事件的实际执行记录，是ProductionEvent(事件类型)与ProductionLot(批次)的关联类。主映射表：matrix_routerx_operation_lot_batch_resume_log；关联从表：_detail（批次状态快照）和 _wafer_detail_log（逐片Wafer明细）。每条记录对应一次具体操作，记录操作人、时间戳、状态变更及输入/输出批次。" .

### ==========================================
### 2. 核心有机关联 (Object Properties)
### ==========================================

# 2.1 Wafer 核心状态向量 (物理实体锚点)
semi:belongsToLot a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:ProductionLot ;
    rdfs:label "属于批次" .

semi:belongsToSublot a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:Sublot ;
    rdfs:label "属于子批次" .

semi:isLoadedIn a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:Carrier ;
    rdfs:label "装载于载具" ;
    rdfs:comment "Wafer当前装载的载具实例。物理层：matrix_routerx_operation_lot_wafer.carrier_code → carrier_info.code（ForeignKey）。槽位号通过数据属性 semi:hasSlotNo（对应 slot_no 列）单独表达；两者共同构成'晶圆在载具中的坐标'：载具是独立实体（Object），槽位号是该承载关系下的位置坐标（Data）。" .

semi:atStation a owl:ObjectProperty ;
    rdfs:domain semi:Sublot ; rdfs:range semi:ProcessStation ;
    rdfs:label "当前所处工序(位置向量)" ;
    rdfs:comment "加工以子批次为单位，Sublot当前所处工艺站点。通过Wafer→belongsToSublot→Sublot→atStation→ProcessStation实现2跳路径访问。" .

semi:currentlyFollowsModel a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductModel ;
    rdfs:label "遵循产品模型(目标向量)" .

semi:currentlyOnRoute a owl:ObjectProperty ;
    rdfs:domain semi:Wafer ; rdfs:range semi:Route ;
    rdfs:label "当前工艺路径(导航向量)" .

# 2.2 生产管理层级 (Management Hierarchy)
semi:basedOnOrder a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionOrder ;
    rdfs:label "基于工单创建" .

semi:definesRequirementFor a owl:ObjectProperty ;
    rdfs:domain semi:ProductionOrder ; rdfs:range semi:ProductModel ;
    rdfs:label "定义产品规格需求" .

semi:containsSublot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:Sublot ;
    rdfs:label "包含子批次分组" .

semi:isCarriedBy a owl:ObjectProperty ;
    rdfs:domain semi:Sublot ; rdfs:range semi:Carrier ;
    rdfs:label "由载具承载" .

# 2.3 工艺约束注入逻辑 (Core Decoupling Logic)
semi:usesRoute a owl:ObjectProperty ;
    rdfs:domain semi:ProductModel ; rdfs:range semi:Route ;
    rdfs:label "使用工艺路径模板" .

semi:consistsOfStation a owl:ObjectProperty ;
    rdfs:domain semi:Route ; rdfs:range semi:ProcessStation ;
    rdfs:label "包含工序节点" .

semi:hasConstraint a owl:ObjectProperty ;
    rdfs:domain semi:ProductModel ; rdfs:range semi:ProcessConstraint ;
    rdfs:label "注入工艺约束" .

semi:appliesAtStation a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:ProcessStation ;
    rdfs:label "应用于特定工序" .

semi:specifiesRecipe a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:Recipe ;
    rdfs:label "在该工序指定配方" .

# 2.4 物料子类、设备、BOM的关联

# 产品与模型的灵魂绑定
semi:isDefinedBy a owl:ObjectProperty ;
    rdfs:label "由产品模型定义" ;
    rdfs:domain semi:Product ; 
    rdfs:range semi:ProductModel ;
    rdfs:comment "产品模型是该产品的状态转换规则与目标模板总成。" .

# BOM 对原料与辅料的精准消耗
semi:consumesRawMaterial a owl:ObjectProperty ;
    rdfs:label "消耗原料" ;
    rdfs:domain semi:BOM ; 
    rdfs:range semi:RawMaterial .

semi:consumesAuxiliary a owl:ObjectProperty ;
    rdfs:label "消耗辅料" ;
    rdfs:domain semi:BOM ; 
    rdfs:range semi:Auxiliary .

# 备件与设备的运维关联
semi:requiresSparePart a owl:ObjectProperty ;
    rdfs:label "要求备件更换" ;
    rdfs:domain semi:Equipment ; 
    rdfs:range semi:SparePart ;
    rdfs:comment "驱动设备从异常/老化状态回归受控状态。" .

semi:containsEquipment a owl:ObjectProperty ;
    rdfs:domain semi:EquipmentGroup ; rdfs:range semi:Equipment ;
    rdfs:label "设备组包含设备" ;
    rdfs:comment "设备组包含的设备实例，多对多关系（一个设备可属于多个设备组）。对应 equipment_group.equipments JSON 数组，数组元素为 equipment.id。" .

semi:isInstanceOf a owl:ObjectProperty ;
    rdfs:domain semi:Equipment ; rdfs:range semi:EquipmentModel ;
    rdfs:label "设备型号" ;
    rdfs:comment "设备实例所属设备模型（型号），从模型继承额定寿命、规格参数等。当设备当前寿命达到 EquipmentModel 定义的额定寿命时，系统自动触发报废预警或大修计划。N:1 关系（多台设备可属同一型号）。" .

semi:usesEquipmentGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:EquipmentGroup ;
    rdfs:label "工序绑定可用设备组" ;
    rdfs:comment "工序引用设备组作为派工可行域，对应 matrix_routerx_config_process.equipment_group_list（JSON 数组）。" .

semi:hostsRecipe a owl:ObjectProperty ;
    rdfs:domain semi:Equipment ; rdfs:range semi:Recipe ;
    rdfs:label "物理驻留配方" .

semi:hasBOM a owl:ObjectProperty ;
    rdfs:domain semi:ProductModel ; rdfs:range semi:BOM ;
    rdfs:label "关联BOM定义" .

semi:anchoredAtStation a owl:ObjectProperty ;
    rdfs:domain semi:BOM ; rdfs:range semi:ProcessStation ;
    rdfs:label "物料消耗锚定工序" .


# 2.5 动作驱动与跳转 (Action Logic)
semi:hasInput a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEvent ; rdfs:range semi:ProductionLot ;
    rdfs:label "动作输入" ;
    rdfs:comment "本次操作的输入批次（ProductionLot）。domain 为 semi:ProductionEvent（事件类型），不继承自抽象父类 Action。具体执行记录中的批次关联见 semi:ProductionEventRecord.actsOnLot。" .

semi:hasOutput a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEvent ; rdfs:range semi:ProductionLot ;
    rdfs:label "动作输出" ;
    rdfs:comment "本次操作产生的输出批次（ProductionLot）。domain 为 semi:ProductionEvent（事件类型），不继承自抽象父类 Action。具体执行记录中的批次关联见 semi:ProductionEventRecord.producesLot。" .

semi:modifiesStateVector a owl:ObjectProperty ;
    rdfs:domain semi:Action ; rdfs:label "修改状态向量" ;
    rdfs:comment "Action 驱动批次(ProductionLot)状态机跳转，间接修改批次所含 Sublot 的 atStation 等动态指针；不直接关联 Wafer 实例。" .

semi:hasParentLot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionLot ;
    rdfs:label "父批次(溯源)" .

# 2.6 生产履历追溯对象属性 (Traceability Object Properties)

semi:hasPassRecord a owl:ObjectProperty ;
    rdfs:domain semi:Sublot ; rdfs:range semi:StationPassRecord ;
    rdfs:label "子批次过站记录" ;
    rdfs:comment "子批次在某道工序产生的过站执行记录（加工或量测），是Wafer生产履历的基本事实节点。反向关联：station_pass_record.sublot_id → matrix_routerx_operation_lot.id。" .

semi:recordedAtStation a owl:ObjectProperty ;
    rdfs:domain semi:StationPassRecord ; rdfs:range semi:ProcessStation ;
    rdfs:label "过站所在工序" ;
    rdfs:comment "该过站记录对应的工艺站点，是在时间轴上定位Wafer所处制造位置的锚点。" .

semi:processedByEquipment a owl:ObjectProperty ;
    rdfs:domain semi:StationPassRecord ; rdfs:range semi:Equipment ;
    rdfs:label "过站使用设备" ;
    rdfs:comment "执行本次加工或量测的具体设备实例。与Equipment的关联构成'Wafer-工序-设备'三元组，支持从设备维度反查'某台设备何时加工了哪些批次'。" .

semi:mergedFrom a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionLot ;
    rdfs:label "攒批自" ;
    rdfs:comment "攒批/合批(Merge)操作：多个源批次合并为一个新批次。在谱系DAG中表现为多对一的汇聚节点，是追溯断点的最常见来源。" .

semi:reworkedAs a owl:ObjectProperty ;
    rdfs:domain semi:ProductionLot ; rdfs:range semi:ProductionLot ;
    rdfs:label "返工为" ;
    rdfs:comment "返工(Rework)操作：被判定为Reject的批次重新投入加工，衍生出运行于返工工艺路径的新批次标识。返工完成若判定Good则在谱系图中归并回主路径。多次返工形成循环切出-回归的有向路径。" .

semi:isInstanceOfEvent a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ; rdfs:range semi:ProductionEvent ;
    rdfs:label "事件类型" ;
    rdfs:comment "该执行记录对应的事件类型（如SPLIT、MERGE、REWORK等ProductionEvent实例），关联record到event类型定义。" .

semi:actsOnLot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ; rdfs:range semi:ProductionLot ;
    rdfs:label "作用批次" ;
    rdfs:comment "事件执行时的输入/主体批次（matrix_routerx_operation_lot_batch_resume_log.lot_code）。对于进出站等单批次操作，actsOnLot与producesLot指向同一批次。" .

semi:producesLot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ; rdfs:range semi:ProductionLot ;
    rdfs:label "产出批次" ;
    rdfs:comment "事件执行后产生的输出批次（matrix_routerx_operation_lot_batch_resume_log.output_lot_code）。对于拆批操作，产出批次与作用批次不同；对于状态变更操作，两者相同。" .

semi:producesSublot a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ; rdfs:range semi:Sublot ;
    rdfs:label "产出子批次" ;
    rdfs:comment "谱系变更事件（拆批/并批/返工）执行后，为产出批次同步创建的初始 Sublot 实例。与 producesLot 一一对应（新批次在拆批时只有一个初始子批次）。stateTransitionFunction 依赖此属性更新被迁移晶圆的 belongsToSublot 指针，保证 Wafer→belongsToSublot→atStation 路径在拆批后仍然连通。物理层对应 matrix_routerx_operation_lot 中与新批次绑定的初始记录行。" .

semi:affectsWafer a owl:ObjectProperty ;
    rdfs:domain semi:ProductionEventRecord ; rdfs:range semi:Wafer ;
    rdfs:label "操作涉及的Wafer" ;
    rdfs:comment "事件执行时涉及的具体晶圆实例。在拆批场景中记录被从源批次迁移到新批次的晶圆；在量测场景中记录抽检晶圆；在返工场景中记录受返工影响的晶圆。支持从事件维度反查 Wafer 粒度的生产履历，实现逐片血缘闭环。物理层对应三联日志表中的 wafer_detail_log 明细行。" .

# 2.7 载具层级关联 (Carrier Hierarchy)
semi:belongsToGroup a owl:ObjectProperty ;
    rdfs:domain semi:Carrier ; rdfs:range semi:CarrierGroup ;
    rdfs:label "归属载具组" ;
    rdfs:comment "载具实例归属于某个载具组，反映工厂对同类载具的逻辑分组管理。" .

semi:hasModel a owl:ObjectProperty ;
    rdfs:domain semi:Carrier ; rdfs:range semi:CarrierModel ;
    rdfs:label "关联载具模型" ;
    rdfs:comment "载具实例关联所属载具模型，从模型继承规格参数（容量、额定寿命等）。" .

semi:usesLoadCarrierGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:CarrierGroup ;
    rdfs:label "进站载具组约束" ;
    rdfs:comment "工序进站时物料所在载具必须属于该载具组，对应 matrix_routerx_config_process.load_carrier_group_id。" .

semi:usesUnloadCarrierGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:CarrierGroup ;
    rdfs:label "出站载具组约束" ;
    rdfs:comment "工序出站时物料转移的目标载具必须属于该载具组，对应 matrix_routerx_config_process.unload_carrier_group_id。" .

### ==========================================
### 3. 数据属性与元数据 (Data & Metadata)
### ==========================================
### 设计原则：
###   - TTL DatatypeProperty 定义语义属性名（"这个字段叫什么"）
###   - mapping_prod.json 的 properties 字段维护物理绑定（"这个语义属性映射哪列"）
###   - 只对有业务语义的字段建模，审计字段(create_user_id/deleted/trace_id等)不建模
### ==========================================

# 3.1 状态属性（unionOf 显式声明域，涵盖全部有状态本体类）
semi:hasState a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (
        semi:Wafer semi:ProductionLot semi:Sublot
        semi:Equipment
        semi:ProductModel semi:ProductionOrder
        semi:BOM semi:Recipe
        semi:Material semi:RawMaterial semi:Auxiliary semi:SparePart semi:Product
    ) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "状态标记" ;
    rdfs:comment "各类状态字段：大多数类对应 status 列（整数枚举），ProductModel 对应 product_status；各枚举值及物理列映射见 mapping_prod.json properties（语义→列）及 value_mappings（值→语义）。" .

semi:isQualified a owl:DatatypeProperty ;
    rdfs:domain semi:Equipment ;
    rdfs:range xsd:boolean ;
    rdfs:label "认证状态(Qual)" ;
    rdfs:comment "设备是否通过工艺认证(Qual run)；当前数据库无独立列直接存储，mapping 对应 null（语义建模保留，查询时需通过设备状态/日志推导）。" .

semi:hasControlLimit a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "制程卡控界限" ;
    rdfs:comment "工艺参数的上下控制边界，ProcessConstraint 为虚拟中间类（无独立表），物理层嵌入 matrix_routerx_config_process 配置字段中。" .

semi:hasVersion a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessStation semi:Route semi:ProductModel semi:BOM semi:Recipe) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "版本号" ;
    rdfs:comment "版本控制字段：ProcessStation 对应 version，Route / ProductModel / BOM / Recipe 对应 version_n（字段名因表而异）。" .

# 3.2 Wafer 数据属性
semi:hasWaferCode a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:string ;
    rdfs:label "晶圆编号" ;
    rdfs:comment "晶圆唯一标识，对应 matrix_routerx_operation_lot_wafer.wafer_code。" .

semi:hasSlotNo a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:integer ;
    rdfs:label "槽位号" ;
    rdfs:comment "晶圆在载具中的物理位置编号，对应 matrix_routerx_operation_lot_wafer.slot_no。与 semi:isLoadedIn（Wafer→Carrier）共同构成完整的'载具坐标'：isLoadedIn 表达'在哪个载具'，hasSlotNo 表达'在该载具的第几号槽位'。槽位号是数据属性（直接过滤：WHERE slot_no=N），载具是对象属性（需 JOIN carrier_info）。" .

semi:hasNGCode a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:string ;
    rdfs:label "NG码" ;
    rdfs:comment "不良原因/NG分类码，对应 ng_code。" .

semi:waferLevel a owl:DatatypeProperty ;
    rdfs:domain semi:Wafer ;
    rdfs:range xsd:integer ;
    rdfs:label "晶圆质量等级" ;
    rdfs:comment "晶圆质量状态等级，对应 matrix_routerx_operation_lot_wafer.level 字段。枚举值见 semi:WaferLevel：1=OK、2=NG、3=GOODSAMPLE、9=LOSS。" .

# 3.3 生产批次 / 子批次 数据属性
semi:hasLotCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProductionLot semi:Sublot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "批次号" ;
    rdfs:comment "批次唯一业务标识符，对应 current_lot_code（批次/子批次）。动作执行记录中的批次引用通过 semi:ProductionEventRecord 的对象属性 actsOnLot / producesLot 建立，不在此属性定义。" .

semi:hasProcessStatus a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProductionLot semi:Sublot) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "站点加工状态" ;
    rdfs:comment "批次在当前工序的站点级加工阶段（≠批次整体状态 hasState.status）：0=待进站、50=已进站待执行、100=执行中、150=待出站、200=已出站，对应 process_status。" .

semi:hasLotType a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionLot ;
    rdfs:range xsd:integer ;
    rdfs:label "批次类型" ;
    rdfs:comment "批次分类标识，对应 type 字段。" .

semi:hasWaferStatistics a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionLot ;
    rdfs:range xsd:string ;
    rdfs:label "晶圆统计" ;
    rdfs:comment "批次内晶圆数量的JSON统计信息，对应 wafer_statistics。" .

semi:hasProductCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProductionOrder semi:ProductionLot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "品种编码" ;
    rdfs:comment "产品/品种编码（反规范化冗余字段），对应 product_code。" .

semi:hasRecipeCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Recipe semi:ProductionLot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "配方编码" ;
    rdfs:comment "对应 recipe_manage.code 或批次的反规范化字段 recipe_code。" .

semi:hasCarrierCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Carrier semi:ProductionLot semi:Sublot) ] ;
    rdfs:range xsd:string ;
    rdfs:label "载具编码" ;
    rdfs:comment "载具唯一标识，对应 carrier_info.code（载具实体）或 lot.carrier_code（批次当前绑定载具）。" .

# 3.4 工艺站点数据属性
semi:hasStationCode a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessStation ;
    rdfs:range xsd:string ;
    rdfs:label "工序编码" .

semi:hasStationName a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessStation ;
    rdfs:range xsd:string ;
    rdfs:label "工序名称" .

semi:hasStationType a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessStation ;
    rdfs:range xsd:integer ;
    rdfs:label "工序类型" ;
    rdfs:comment "工序分类枚举（整数），对应 matrix_routerx_config_process.type，区分普通工序、检查站、合并站等类型。" .

# 3.5 设备与设备组数据属性

# 3.5.1 设备实体 (Equipment)
semi:hasEquipmentCode a owl:DatatypeProperty ;
    rdfs:domain semi:Equipment ;
    rdfs:range xsd:string ;
    rdfs:label "设备编码" .

semi:hasEquipmentName a owl:DatatypeProperty ;
    rdfs:domain semi:Equipment ;
    rdfs:range xsd:string ;
    rdfs:label "设备名称" .

# 3.5.2 设备组 (EquipmentGroup)
semi:hasEquipmentGroupName a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentGroup ;
    rdfs:range xsd:string ;
    rdfs:label "设备组名称" ;
    rdfs:comment "对应 equipment_group.equipment_group_name。" .

semi:hasEquipmentGroupDesc a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentGroup ;
    rdfs:range xsd:string ;
    rdfs:label "设备组描述" ;
    rdfs:comment "对应 equipment_group.equipment_group_desc。" .

# 3.5.3 设备模型 (EquipmentModel)
semi:hasEquipmentModelCode a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "设备模型编码" ;
    rdfs:comment "设备型号的唯一标识编码，对应 equipment_model.code。" .

semi:hasEquipmentModelName a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "设备模型名称" ;
    rdfs:comment "设备型号名称，对应 equipment_model.name。" .

semi:hasSpecification a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "规格" ;
    rdfs:comment "设备模型的技术规格参数描述，对应 equipment_model.specification。" .

semi:hasManufacturer a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:string ;
    rdfs:label "生产厂家" ;
    rdfs:comment "设备型号的生产厂家名称，对应 equipment_model.manufacturer。" .

semi:hasEquipmentRatedLifetime a owl:DatatypeProperty ;
    rdfs:domain semi:EquipmentModel ;
    rdfs:range xsd:integer ;
    rdfs:label "额定寿命" ;
    rdfs:comment "该型号设备的额定总寿命（运行小时数或维护周期），对应 equipment_model.rated_lifetime。当设备当前寿命达到此值时触发报废预警或大修计划。" .

# 3.6 载具数据属性

# 3.6.1 载具实体 (Carrier) 专属属性 (载具编码 hasCarrierCode 已在 3.3 定义)
semi:hasCarrierType a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Carrier semi:CarrierModel) ] ;
    rdfs:range xsd:string ;
    rdfs:label "载具类型码" ;
    rdfs:comment "载具类型分类标识，对应 type_code；CarrierModel 中为型号分类，Carrier 中为实例类型码。" .

semi:hasMaintenanceStatus a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "载具保养状态" ;
    rdfs:comment "载具当前保养状态，对应 carrier_info.status 字段：1=保养中、2=可用、3=待保养。枚举见 semi:CarrierMaintenanceStatus。" .

semi:hasLoadStatus a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "载具装载状态" ;
    rdfs:comment "载具物料装载状态，对应 carrier_info.sub_status 字段：0=空（无物料）、1=非空（有物料装载）。枚举见 semi:CarrierLoadStatus。" .

semi:hasCapacity a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Carrier semi:CarrierModel) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "载具容量" ;
    rdfs:comment "载具可容纳的最大晶圆/物料数量，对应 capacity；CarrierModel 中为标称设计容量。" .

semi:hasMaintenanceCountdown a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "距下次保养计数" ;
    rdfs:comment "距离下一次保养的剩余使用计数（单位由 maintenance_countdown_unit 指定），对应 carrier_info.maintenance_countdown。" .

semi:hasRemainingLife a owl:DatatypeProperty ;
    rdfs:domain semi:Carrier ;
    rdfs:range xsd:integer ;
    rdfs:label "剩余寿命" ;
    rdfs:comment "载具剩余可用寿命计数（单位由 usage_unit 指定），对应 carrier_info.remaining_useful_life。" .

# 3.6.2 载具模型 (CarrierModel) 数据属性
semi:hasCarrierModelCode a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:string ;
    rdfs:label "载具模型编码" ;
    rdfs:comment "载具型号的唯一标识编码。" .

semi:hasCarrierModelName a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:string ;
    rdfs:label "载具模型名称" ;
    rdfs:comment "载具型号名称。" .

semi:hasCarrierSize a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:string ;
    rdfs:label "载具尺寸" ;
    rdfs:comment "载具物理尺寸规格描述（如 8寸/12寸），对应型号尺寸字段。" .

semi:hasRatedLifetime a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:integer ;
    rdfs:label "额定寿命" ;
    rdfs:comment "该型号载具的设计额定总寿命（与 usage_unit 单位一致）。" .

semi:hasSupplier a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierModel ;
    rdfs:range xsd:string ;
    rdfs:label "供应商" ;
    rdfs:comment "载具型号的供应商名称或编码。" .

# 3.6.3 载具组 (CarrierGroup) 数据属性
semi:hasCarrierGroupCode a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierGroup ;
    rdfs:range xsd:string ;
    rdfs:label "载具组编码" ;
    rdfs:comment "载具组的唯一标识编码。" .

semi:hasCarrierGroupName a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierGroup ;
    rdfs:range xsd:string ;
    rdfs:label "载具组名称" ;
    rdfs:comment "载具组名称，通常按类型或用途命名。" .

semi:hasMaintenanceCycle a owl:DatatypeProperty ;
    rdfs:domain semi:CarrierGroup ;
    rdfs:range xsd:integer ;
    rdfs:label "保养周期" ;
    rdfs:comment "该载具组的统一保养周期配置（使用次数/时长，单位由业务规则确定）。" .

# 3.7 工艺路径数据属性
semi:hasRouteCode a owl:DatatypeProperty ;
    rdfs:domain semi:Route ;
    rdfs:range xsd:string ;
    rdfs:label "路径编码" .

semi:hasRouteName a owl:DatatypeProperty ;
    rdfs:domain semi:Route ;
    rdfs:range xsd:string ;
    rdfs:label "路径名称" .

semi:hasRouteType a owl:DatatypeProperty ;
    rdfs:domain semi:Route ;
    rdfs:range xsd:string ;
    rdfs:label "路径类型" ;
    rdfs:comment "工艺路径分类标识，对应 routerx_router_config.route_type（字符串枚举，如主路线/子路线等）。" .

# 3.8 产品模型数据属性
semi:hasProductModelCode a owl:DatatypeProperty ;
    rdfs:domain semi:ProductModel ;
    rdfs:range xsd:string ;
    rdfs:label "产品模型编码" .

semi:hasProductModelName a owl:DatatypeProperty ;
    rdfs:domain semi:ProductModel ;
    rdfs:range xsd:string ;
    rdfs:label "产品模型名称" .

# 3.9 生产工单数据属性
semi:hasOrderNo a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionOrder ;
    rdfs:range xsd:string ;
    rdfs:label "工单编号" ;
    rdfs:comment "对应 production_scheduling.schedule_no。" .

semi:hasTotalQty a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionOrder ;
    rdfs:range xsd:integer ;
    rdfs:label "计划总数量" .

semi:hasPlanStartTime a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionOrder ;
    rdfs:range xsd:dateTime ;
    rdfs:label "计划开始时间" .

semi:hasPlanEndTime a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionOrder ;
    rdfs:range xsd:dateTime ;
    rdfs:label "计划结束时间" .

# 3.10 BOM 数据属性
semi:hasBOMCode a owl:DatatypeProperty ;
    rdfs:domain semi:BOM ;
    rdfs:range xsd:string ;
    rdfs:label "BOM编码" .

semi:hasBOMName a owl:DatatypeProperty ;
    rdfs:domain semi:BOM ;
    rdfs:range xsd:string ;
    rdfs:label "BOM名称" .

# 3.11 配方数据属性 (配方编码 hasRecipeCode 已在 3.3 定义)
semi:hasRecipeName a owl:DatatypeProperty ;
    rdfs:domain semi:Recipe ;
    rdfs:range xsd:string ;
    rdfs:label "配方名称" .

# 3.12 物料数据属性 (Material 及其子类共享)
semi:hasMaterialCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Material semi:Product semi:RawMaterial semi:Auxiliary semi:SparePart) ] ;
    rdfs:range xsd:string ;
    rdfs:label "物料编码" ;
    rdfs:comment "对应 material_no 或 code 字段。" .

semi:hasMaterialName a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Material semi:Product semi:RawMaterial semi:Auxiliary semi:SparePart) ] ;
    rdfs:range xsd:string ;
    rdfs:label "物料名称" ;
    rdfs:comment "对应 material_name 或 name 字段。" .

semi:hasMaterialType a owl:DatatypeProperty ;
    rdfs:domain semi:Material ;
    rdfs:range xsd:string ;
    rdfs:label "物料类型" ;
    rdfs:comment "物料分类标识，对应 material_type 或 type 字段（字符串枚举），用于区分原料/辅料/备件/产品等子类。SparePart / Product 子类也共用此属性，值域因子类而异。" .

semi:hasMaterialSpec a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Material semi:Product semi:RawMaterial semi:Auxiliary) ] ;
    rdfs:range xsd:string ;
    rdfs:label "物料规格" ;
    rdfs:comment "对应 spec 或 material_spec 字段。" .

semi:hasUnit a owl:DatatypeProperty ;
    rdfs:domain semi:Material ;
    rdfs:range xsd:string ;
    rdfs:label "物料单位" .

semi:hasBatchMgmt a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Material semi:Product semi:RawMaterial semi:Auxiliary semi:SparePart) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "启用批次管理" ;
    rdfs:comment "物料模型是否开启批次号管理，对应 warehouse_material.batch（bit(1)）字段。true=该物料入库时须填写批次号（semi:MaterialBatch.hasBatchNo）；false=不区分批次，按数量管理。此配置决定 MaterialBatch.hasBatchNo 是否为必填。适用于 semi:Material 所有子类（Product/Auxiliary/SparePart/RawMaterial）。" .

semi:hasUniqueCodeMgmt a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Material semi:Product semi:RawMaterial semi:Auxiliary semi:SparePart) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "启用逐件唯一码管理" ;
    rdfs:comment "物料模型是否开启逐件唯一码管理，对应 warehouse_material.unique_code（bit(1)）字段。true=该物料每个实例具备唯一码（semi:MaterialBatch.hasBoxNo），可逐件扫码追踪（如产成品包装盒号、备件序列号）；false=仅以批次号+数量管理（如辅料/原料）。与 semi:hasBatchMgmt 均为物料模型层配置，决定 MaterialBatch 实例的管理规范。" .

# 3.13 动作日志数据属性
semi:hasOperationType a owl:DatatypeProperty ;
    rdfs:domain semi:Action ;
    rdfs:range xsd:string ;
    rdfs:label "操作类型" ;
    rdfs:comment "如进站、出站、拆批、并批、Hold、Release，对应 operation_type。" .

semi:hasBeforeState a owl:DatatypeProperty ;
    rdfs:domain semi:Action ;
    rdfs:range xsd:string ;
    rdfs:label "操作前状态" ;
    rdfs:comment "对应 before_state 字段。" .

semi:hasAfterState a owl:DatatypeProperty ;
    rdfs:domain semi:Action ;
    rdfs:range xsd:string ;
    rdfs:label "操作后状态" ;
    rdfs:comment "对应 after_state 字段。" .

# 3.14 过站记录数据属性 (StationPassRecord 及其子类)

# 3.14.1 过站记录公共属性 (StationPassRecord)
semi:hasInTime a owl:DatatypeProperty ;
    rdfs:domain semi:StationPassRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "进站时间" ;
    rdfs:comment "子批次进入工序加工区的时间戳，对应 in_time / enter_time 字段。" .

semi:hasOutTime a owl:DatatypeProperty ;
    rdfs:domain semi:StationPassRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "出站时间" ;
    rdfs:comment "子批次完成工序离开加工区的时间戳，对应 out_time / exit_time 字段。" .

semi:hasLoadTime a owl:DatatypeProperty ;
    rdfs:domain semi:StationPassRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "上料时间" ;
    rdfs:comment "操作员完成上料（将载具放置到设备进料口）的时间戳。" .

semi:hasUnloadTime a owl:DatatypeProperty ;
    rdfs:domain semi:StationPassRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "下料时间" ;
    rdfs:comment "操作员完成下料（从设备取出载具）的时间戳。" .

semi:hasEquipmentSnapshot a owl:DatatypeProperty ;
    rdfs:domain semi:StationPassRecord ;
    rdfs:range xsd:string ;
    rdfs:label "设备状态快照" ;
    rdfs:comment "过站时刻的设备关键状态快照（JSON），作为因果追溯的设备侧证据链节点，可进一步关联设备履历表展开细节。" .

# 3.14.2 加工过站记录专属属性 (ProcessPassRecord)
semi:hasProcessParamRecord a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessPassRecord ;
    rdfs:range xsd:string ;
    rdfs:label "加工制程参数记录" ;
    rdfs:comment "加工设备采集的关键制程参数快照（JSON），可能是单片逐片数据或批次聚合值（均值/极值等）。是分析工艺漂移和设备异常的核心数据源。" .

# 3.14.3 量测过站记录专属属性 (MeasurementPassRecord)
semi:hasMeasurementResult a owl:DatatypeProperty ;
    rdfs:domain semi:MeasurementPassRecord ;
    rdfs:range xsd:string ;
    rdfs:label "量测结果数据" ;
    rdfs:comment "量测工序采集的质量参数（JSON），含逐片数据及统计聚合值（最大/最小/平均/标准差），表征当前阶段批次整体质量属性。" .

semi:hasSamplingRule a owl:DatatypeProperty ;
    rdfs:domain semi:MeasurementPassRecord ;
    rdfs:range xsd:string ;
    rdfs:label "抽检规则" ;
    rdfs:comment "该量测站点应用的抽检规则标识（如'每批抽n片'），决定量测结果对批次的代表性置信度。" .

# 3.14.4 生产事件记录属性 (ProductionEventRecord)
semi:hasEventType a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "谱系事件类型" ;
    rdfs:comment "批次谱系变更事件类型（整数枚举）：1=拆批、2=并批、12=返工、14=拆父批、16=攒批。对应 matrix_routerx_operation_lot_batch_resume_log.operation_type。完整23种类型枚举见 semi:LotOperationType。" .

semi:hasEventStartTime a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "事件开始时间" ;
    rdfs:comment "生产事件的开始时间戳，对应 matrix_routerx_operation_lot_batch_resume_log.gmt_create。" .

semi:hasEventEndTime a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "事件结束时间" ;
    rdfs:comment "生产事件的结束时间戳。" .

semi:hasOperatorId a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "操作人ID" ;
    rdfs:comment "执行该生产事件的操作人标识，对应 matrix_routerx_operation_lot_batch_resume_log.operator_id。" .

semi:hasLotStatusBefore a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "事件前批次状态" ;
    rdfs:comment "事件执行前的批次状态快照，对应 matrix_routerx_operation_lot_batch_resume_log_detail.before_state。" .

semi:hasLotStatusAfter a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "事件后批次状态" ;
    rdfs:comment "事件执行后的批次状态快照，对应 matrix_routerx_operation_lot_batch_resume_log_detail.after_state。" .

### ==========================================
### 4. 事件逻辑规约注解属性 (Event Logic Annotation Properties)
### ==========================================
### 设计说明：
###   下列 6 个注解属性构成事件类（XxxEvent）的五维度逻辑规约框架，
###   挂载于具体事件类的类定义上（如 semi:SplitEvent）。
###   语义引擎（Semantic Resolver）扫描 XxxEventRecord 时，
###   追溯 isInstanceOfEvent 所指向的事件类，读取各维度规约，
###   生成物理 SQL/API 调用序列后执行。
###
###   维度一  preCondition        — 准入门禁（验证前置状态）
###   维度二  inputSchema         — 参数规约（外部输入参数集）
###   维度三  transformationLogic — 状态算子（状态跳转执行逻辑）
###   维度四  apiBinding          — 服务绑定（物理 MES 接口）
###   维度五  postCondition       — 约束后验（结果校验）
###   辅助    stateTransitionFunction — 精简的本体对象状态更新指令模板
### ==========================================

semi:preCondition a owl:AnnotationProperty ;
    rdfs:label "准入规则" ;
    rdfs:comment "维度一：事件执行的前置门禁条件，引擎执行前须校验通过。不满足则向用户返回拦截原因，不进入执行流程。格式：领域对象.属性 运算符 期望值。" .

semi:inputSchema a owl:AnnotationProperty ;
    rdfs:label "参数规约" ;
    rdfs:comment "维度二：驱动本事件所需的最小外部输入参数集（JSON Schema 描述）。仅包含业务必要的外部输入；系统自动生成的值（如新批次ID）作为 transformationLogic 的产出变量（$var），不在此列。" .

semi:transformationLogic a owl:AnnotationProperty ;
    rdfs:label "状态算子" ;
    rdfs:comment "维度三：事件触发后的状态跳转逻辑，供语义引擎解析并转化为物理 SQL/API 调用。伪代码约定：LET $var = CALL apiBinding 捕获调用返回值；CREATE/SET/UPDATE 操作本体对象；?param 引用 inputSchema 中的入参。" .

semi:apiBinding a owl:AnnotationProperty ;
    rdfs:label "服务绑定" ;
    rdfs:comment "维度四：本事件绑定的 MES 外部服务接口标识（服务名.方法名）。引擎执行 transformationLogic 中 CALL 指令时调用，返回值（如 generated_lot_id）捕获到对应 $var 变量。" .

semi:postCondition a owl:AnnotationProperty ;
    rdfs:label "约束后验" ;
    rdfs:comment "维度五：事件执行完成后的结果验证条件，确认状态已正确变更。引擎在 API 调用和状态同步完成后执行，不满足则触发回滚或告警。" .

semi:stateTransitionFunction a owl:AnnotationProperty ;
    rdfs:label "状态转换函数" ;
    rdfs:comment "辅助维度：本体对象层面的状态更新指令模板（精简描述），供语义引擎转化为物理 UPDATE/INSERT。格式：UPDATE Target(类名) SET 属性 = EventRecord.属性 [WHERE 条件]。与 transformationLogic 互补，后者描述完整执行序列，本属性聚焦于本体图谱的状态向量变更。" .

semi:tableFilter a owl:AnnotationProperty ;
    rdfs:label "物理表行级过滤条件" ;
    rdfs:comment "指定 XxxEventRecord 子类在映射物理表时所需的 WHERE 谓词。所有 semi:ProductionEventRecord 子类均存储于同一张表 matrix_routerx_operation_lot_batch_resume_log，通过 operation_type 整数字段区分子类型；语义引擎生成 SQL 时将本注解值直接拼入 WHERE 子句。格式：column_name = value。" .

semi:operationTypeCode a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "操作类型编码" ;
    rdfs:comment "批次操作类型命名个体（owl:NamedIndividual）对应的整数编码，与物理表 matrix_routerx_operation_lot_batch_resume_log.operation_type 字段值一一对应。" .

### ==========================================
### 5. 生产事件具体化类群 (Specific Production Event Classes)
### ==========================================
### 建模规范：
###   每种操作类型由两个相互绑定的类共同描述：
###   ① XxxEvent    — rdfs:subClassOf semi:ProductionEvent
###       挂载 5 维度逻辑规约注解，是操作的静态规则/类型模板。
###   ② XxxEventRecord — rdfs:subClassOf semi:ProductionEventRecord
###       存储一次具体执行的实例数据；通过
###       [ owl:Restriction; owl:onProperty isInstanceOfEvent;
###         owl:allValuesFrom XxxEvent ]
###       将记录锁定到对应规则定义，使引擎可从记录追溯到完整规约。
### ==========================================

# 5.1 拆批事件定义 (SplitEvent)
semi:SplitEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "拆批事件定义" ;
    rdfs:comment "定义拆批（Split）操作的规则/类型模板。将源批次中的指定晶圆析出，由 MES 系统自动生成新批次 ID。拆批不涉及物理设备加工，仅执行批次谱系切割与 Wafer 归属迁移。执行记录层见 semi:SplitEventRecord。" ;
    # 维度一：准入规则 — 源批次须处于待加工状态且晶圆数量可拆
    semi:preCondition "ParentLot.status == 0 && ParentLot.waferCount > 1" ;
    # 注：status=0 对应 matrix_routerx_operation_lot.status=0（待加工/待进站），整数枚举。
    # 维度二：参数规约 — 仅需外部传入源批次ID与待拆晶圆列表；新批次ID由系统生成
    semi:inputSchema "{ parentLotId: string, splitWaferList: string[] }" ;
    # 维度三：状态算子 — 调用 API 取得新批次ID，创建新批次+初始Sublot、迁移Wafer归属、建立父子谱系
    semi:transformationLogic "LET $newId = CALL apiBinding; CREATE semi:ProductionLot($newId); LET $newSublotId = $newId.initialSublot; CREATE semi:Sublot($newSublotId); SET $newId.containsSublot = $newSublotId; SET $newId.hasParentLot = ?parentLotId; UPDATE semi:Wafer SET belongsToLot = $newId, belongsToSublot = $newSublotId WHERE id IN ?splitWaferList" ;
    # 维度四：服务绑定 — 调用 MES 核心服务拆批接口，接口返回值含系统生成的新批次ID
    semi:apiBinding "MES_CORE_SERVICE.executeSplitAction" ;
    # 维度五：约束后验 — 确认新批次已实例化，源批次数量已正确扣减
    semi:postCondition "checkExists($newId) && ParentLot.qty == (prevQty - splitCount)" ;
    # 辅助：状态转换函数 — 被迁移晶圆同时更新 Lot 和 Sublot 两个归属指针
    semi:stateTransitionFunction "UPDATE Target(Wafer) SET belongsToLot = EventRecord.producesLot, belongsToSublot = EventRecord.producesSublot WHERE Wafer.id IN EventRecord.affectsWafer" .

# 5.2 拆批执行记录 (SplitEventRecord)
semi:SplitEventRecord a owl:Class ;
    rdfs:subClassOf semi:ProductionEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:SplitEvent ] ;
    rdfs:label "拆批记录" ;
    semi:tableFilter "operation_type = 1" ;
    rdfs:comment "拆批操作的具体执行记录实例。物理映射：matrix_routerx_operation_lot_batch_resume_log WHERE operation_type = 1（semi:tableFilter 注解值）。核心关联：(1) isInstanceOfEvent → semi:SplitEvent，将记录锁定到拆批规则定义，引擎据此追溯 5 维规约生成物理执行序列；(2) actsOnLot → 源批次（被拆的父批次）；(3) producesLot → MES 系统自动生成的新 ProductionLot（子批次），是拆批操作的核心产出；(4) producesSublot → 与 producesLot 同步创建的初始 Sublot，被迁移晶圆的 belongsToSublot 指向此 Sublot，保证 Wafer→Sublot→atStation 路径仍可导航；(5) affectsWafer → 被迁移的具体晶圆实例列表，支持逐片血缘追溯。物理层三联写入：主记录表（operation_type=1）+ _log_detail（拆批前后批次状态快照）+ _wafer_detail_log（逐片Wafer迁移明细）。" .

### ==========================================
### 6. 操作类型枚举 (NamedIndividuals)
### ==========================================
### 设计说明：
###   semi:LotOperationType 不建模为 owl:Class。
###   所有 semi:ProductionEventRecord 子类（XxxEventRecord）均存储于同一物理表
###   matrix_routerx_operation_lot_batch_resume_log，通过 operation_type 整数字段区分
###   事件子类型。XxxEventRecord 子类通过 semi:tableFilter 注解属性声明过滤条件，
###   语义引擎生成 SQL 时自动附加 WHERE operation_type = N 谓词。
###
###   下列命名个体（owl:NamedIndividual）提供可引用的枚举标识，
###   通过 semi:operationTypeCode 属性绑定对应物理整数编码。
###   完整枚举值映射见 mapping_prod.json value_mappings 中的 operation_type 条目。
### ==========================================

semi:SplitOp          a owl:NamedIndividual ; rdfs:label "1-拆批操作"          ; semi:operationTypeCode 1 .
semi:MergeLotsOp      a owl:NamedIndividual ; rdfs:label "2-并批操作"          ; semi:operationTypeCode 2 .
semi:CarrierTransOp   a owl:NamedIndividual ; rdfs:label "3-倒篮操作"          ; semi:operationTypeCode 3 .
semi:HoldOp           a owl:NamedIndividual ; rdfs:label "4-批次扣留"          ; semi:operationTypeCode 4 .
semi:ReleaseOp        a owl:NamedIndividual ; rdfs:label "5-批次释放"          ; semi:operationTypeCode 5 .
semi:NGRecordOp       a owl:NamedIndividual ; rdfs:label "6-不良录入"          ; semi:operationTypeCode 6 .
semi:CancelNGOp       a owl:NamedIndividual ; rdfs:label "7-取消不良"          ; semi:operationTypeCode 7 .
semi:CheckInOp        a owl:NamedIndividual ; rdfs:label "8-批次进站"          ; semi:operationTypeCode 8 .
semi:CheckOutOp       a owl:NamedIndividual ; rdfs:label "9-批次出站"          ; semi:operationTypeCode 9 .
semi:ReturnOp         a owl:NamedIndividual ; rdfs:label "10-批次退回"         ; semi:operationTypeCode 10 .
semi:SkipOp           a owl:NamedIndividual ; rdfs:label "11-批次跳站"         ; semi:operationTypeCode 11 .
semi:ReworkOp         a owl:NamedIndividual ; rdfs:label "12-返工操作"         ; semi:operationTypeCode 12 .
semi:CancelReworkOp   a owl:NamedIndividual ; rdfs:label "13-取消返工"         ; semi:operationTypeCode 13 .
semi:SplitParentOp    a owl:NamedIndividual ; rdfs:label "14-拆父批操作"       ; semi:operationTypeCode 14 .
semi:SwitchSubRouteOp a owl:NamedIndividual ; rdfs:label "15-切换子路径"       ; semi:operationTypeCode 15 .
semi:AccumulateOp     a owl:NamedIndividual ; rdfs:label "16-攒批操作"         ; semi:operationTypeCode 16 .
semi:CarrierChangeOp  a owl:NamedIndividual ; rdfs:label "17-片篮更换"         ; semi:operationTypeCode 17 .
semi:CreateLocalLotOp a owl:NamedIndividual ; rdfs:label "18-本地批次创建"     ; semi:operationTypeCode 18 .
semi:OpenLotOp        a owl:NamedIndividual ; rdfs:label "19-开批"             ; semi:operationTypeCode 19 .
semi:ExpSkipOp        a owl:NamedIndividual ; rdfs:label "20-实验跳站"         ; semi:operationTypeCode 20 .
semi:CancelLocalLotOp a owl:NamedIndividual ; rdfs:label "21-取消本地批次创建" ; semi:operationTypeCode 21 .
semi:CancelOpenLotOp  a owl:NamedIndividual ; rdfs:label "22-取消开批"         ; semi:operationTypeCode 22 .
semi:CompleteLotOp    a owl:NamedIndividual ; rdfs:label "23-批次完结"         ; semi:operationTypeCode 23 .

### ==========================================
### 7. 仓库与库存类群 (Warehouse & Inventory Classes)
### ==========================================
### 适用范围：线边仓（产线本地仓）管理
### 对应物理表：warehouse_location, warehouse_inventory,
###            warehouse_approval_record, warehouse_input_bill_detail, warehouse_output_bill_detail
### ==========================================

# 7.1 库位 (WarehouseLocation) — warehouse_model
semi:WarehouseLocation a owl:Class ;
    rdfs:label "库位" ;
    rdfs:comment "线边仓物理存储空间的最小管理单元。对应 warehouse_model 表（支持多层级，通过 parent_id/parent_name 维护层次结构）；每条记录代表一个独立的库位节点，通过 code/name 标识，type 区分存储类型，warehouse_id/area_id/factory_id 表示所属仓库/区域/工厂。注：equipment_warehouse 表是设备旁的暂存缓冲区（绑定到设备），与 warehouse_model 是两个不同的存储概念。通过 semi:hasInventory 关联当前库存明细集合。" .

# 7.2 物料批次/物料实例 (MaterialBatch)
semi:MaterialBatch a owl:Class ;
    rdfs:label "物料批次（物料实例）" ;
    rdfs:comment "某种物料（semi:Material 子类）的一次实例化记录，是仓库管理中物料流转的基本单元。统一以 hasBatchNo（批次号，必填）标识批次身份；是否额外具备 hasBoxNo（逐件唯一码）取决于物料模型的配置（semi:hasUniqueCodeMgmt=true 时填写唯一码，如产成品盒号、备件序列号）；是否以批次整体管理由 semi:hasBatchMgmt 配置（底层为 warehouse_material.batch 和 warehouse_material.unique_code 字段）。产成品批次在结批(CompleteLotOp)后创建，通过 derivedFromLot 关联源 ProductionLot；辅料/备件/原料批次通过 hasBatchNo 记录供应商批次号。" .

# 7.3 库存明细 (Inventory) — warehouse_inventory
semi:Inventory a owl:Class ;
    rdfs:label "库存明细" ;
    rdfs:comment "某库位中某种物料批次的当前库存量快照。追踪粒度：(库位 × 物料类型 × 批次) → 在库数量。每条记录是三元组 (WarehouseLocation, Material, MaterialBatch) 对应的当前在库数量，随入/出库事件动态更新。物理映射：warehouse_inventory 表。" .

# 7.4 库存管理事件定义（抽象父类）(WarehouseEvent)
semi:WarehouseEvent a owl:Class ;
    rdfs:subClassOf semi:Action ;
    rdfs:label "库存管理事件定义（抽象父类）" ;
    rdfs:comment "定义库存管理操作类型的抽象模板（入库/出库/审批等）。作为 semi:Action 的子类，与 semi:ProductionEvent 平行，专用于线边仓物料管理域；作用对象为物料批次（semi:MaterialBatch）和库位（semi:WarehouseLocation），区别于生产事件（作用于 semi:ProductionLot 和 semi:ProcessStation）。具体操作类型子类：semi:InboundApprovalEvent、semi:InboundEvent、semi:OutboundEvent。" .

# 7.5 库存管理事件记录（抽象父类）(WarehouseEventRecord)
semi:WarehouseEventRecord a owl:Class ;
    rdfs:label "库存管理事件记录（抽象父类）" ;
    rdfs:comment "库存管理操作的执行记录抽象基类，与 semi:ProductionEventRecord 平行，专用于仓库管理域。作用对象：semi:MaterialBatch（物料批次实例）× semi:WarehouseLocation（库位）；通过 semi:isInstanceOfWarehouseEvent 关联对应的事件类型定义。具体子类：semi:InboundApprovalRecord、semi:InboundEventRecord、semi:OutboundEventRecord。" .

# 7.6 入库审批事件定义 (InboundApprovalEvent)
semi:InboundApprovalEvent a owl:Class ;
    rdfs:subClassOf semi:WarehouseEvent ;
    rdfs:label "入库审批事件定义" ;
    rdfs:comment "定义线边仓入库审批操作的规则/类型模板。产成品在包装完成后、入库前须经质检审批，审批通过(status=1)后方可触发入库操作。其他物料的入库视业务流程决定是否需要审批。执行记录层见 semi:InboundApprovalRecord。" ;
    semi:preCondition "InboundApprovalRecord.hasApprovalStatus == 0" ;
    semi:inputSchema "{ approvalRecordId: string, approvalResult: integer, approvalRemark: string }" ;
    semi:transformationLogic "UPDATE semi:InboundApprovalRecord(id=?approvalRecordId) SET hasApprovalStatus = ?approvalResult, hasApprovalResult = ?approvalRemark; IF ?approvalResult == 1 THEN TRIGGER semi:InboundEvent FOR EACH batch in approvalRecord.approvalForMaterial" ;
    semi:apiBinding "WMS_SERVICE.executeApproval" ;
    semi:postCondition "InboundApprovalRecord(id=?approvalRecordId).hasApprovalStatus != 0" .

# 7.7 入库审批记录 (InboundApprovalRecord) — warehouse_approval_record
semi:InboundApprovalRecord a owl:Class ;
    rdfs:subClassOf semi:WarehouseEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfWarehouseEvent ;
          owl:allValuesFrom semi:InboundApprovalEvent ] ;
    rdfs:label "入库审批记录" ;
    rdfs:comment "入库审批操作的具体执行记录。物理映射：warehouse_approval_record 表（独立表，全部行均为审批记录，无行级类型区分符）。核心关联：approvalForMaterial → semi:Material（待审批入库的物料类型）；审批通过后由 triggersInbound 指向对应的 InboundEventRecord，建立审批→入库因果链。hasApprovalStatus 对应 audit_state 字段（字符串类型），支持多阶段审批流（如 '1,2,3' 表示多个节点已完成），具体枚举见 value_mappings。" .

# 7.8 入库事件定义 (InboundEvent)
semi:InboundEvent a owl:Class ;
    rdfs:subClassOf semi:WarehouseEvent ;
    rdfs:label "入库事件定义" ;
    rdfs:comment "定义线边仓入库操作的规则/类型模板。将物料批次（MaterialBatch）移入指定库位，执行后更新库存快照（Inventory.hasStockQty += billQty）。产成品入库通常需先完成 InboundApprovalEvent；其他物料可直接入库。执行记录层见 semi:InboundEventRecord。" ;
    semi:preCondition "WarehouseLocation.hasLocationStatus == 1 && MaterialBatch.batchOfMaterial != null" ;
    semi:inputSchema "{ materialBatchId: string, locationId: string, billQty: decimal, billTime: dateTime }" ;
    semi:transformationLogic "LET $inv = FIND semi:Inventory WHERE stockOfBatch=?materialBatchId AND hasInventory.location=?locationId; IF $inv EXISTS THEN UPDATE $inv SET hasStockQty += ?billQty ELSE CREATE semi:Inventory(stockOfBatch=?materialBatchId, stockOfMaterial=batch.batchOfMaterial, hasStockQty=?billQty)" ;
    semi:apiBinding "WMS_SERVICE.executeInbound" ;
    semi:postCondition "Inventory(batch=?materialBatchId, location=?locationId).hasStockQty > 0" .

# 7.9 入库执行记录 (InboundEventRecord) — warehouse_input_bill_detail
semi:InboundEventRecord a owl:Class ;
    rdfs:subClassOf semi:WarehouseEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfWarehouseEvent ;
          owl:allValuesFrom semi:InboundEvent ] ;
    rdfs:label "入库记录" ;
    rdfs:comment "入库操作的具体执行记录。物理映射：warehouse_input_bill_detail 表（与入库单头表 warehouse_input_bill 通过 input_bill_id 关联，一单多行，每行对应一个物料批次实例）。核心关联：(1) inboundBatch → semi:MaterialBatch，入库的物料批次实例（unique_code=唯一码，Material.hasUniqueCodeMgmt=true 时填写）；(2) inboundToLocation → semi:WarehouseLocation，目标库位（warehouse_id 外键）；(3) hasBillNo（input_bill_no）、hasBillQty（count）、hasBillTime（create_time）。执行后触发 warehouse_inventory 对应行更新（在库数量增加）。" .

# 7.10 出库事件定义 (OutboundEvent)
semi:OutboundEvent a owl:Class ;
    rdfs:subClassOf semi:WarehouseEvent ;
    rdfs:label "出库事件定义" ;
    rdfs:comment "定义线边仓出库操作的规则/类型模板。将物料批次从指定库位移出（用于生产线领料或调拨），执行后更新库存快照（Inventory.hasStockQty -= billQty）。执行记录层见 semi:OutboundEventRecord。" ;
    semi:preCondition "Inventory(batch=?materialBatchId, location=?locationId).hasStockQty >= ?billQty" ;
    semi:inputSchema "{ materialBatchId: string, locationId: string, billQty: decimal, billTime: dateTime }" ;
    semi:transformationLogic "UPDATE semi:Inventory SET hasStockQty -= ?billQty WHERE stockOfBatch=?materialBatchId AND atLocation=?locationId" ;
    semi:apiBinding "WMS_SERVICE.executeOutbound" ;
    semi:postCondition "Inventory(batch=?materialBatchId, location=?locationId).hasStockQty >= 0" .

# 7.11 出库执行记录 (OutboundEventRecord) — warehouse_output_bill_detail
semi:OutboundEventRecord a owl:Class ;
    rdfs:subClassOf semi:WarehouseEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfWarehouseEvent ;
          owl:allValuesFrom semi:OutboundEvent ] ;
    rdfs:label "出库记录" ;
    rdfs:comment "出库操作的具体执行记录。物理映射：warehouse_output_bill_detail 表（与出库单头表 warehouse_output_bill 通过 output_bill_id 关联，一单多行，每行对应一个物料批次实例）。核心关联：(1) outboundBatch → semi:MaterialBatch，出库的物料批次实例（unique_code=唯一码，Material.hasUniqueCodeMgmt=true 时填写）；(2) outboundFromLocation → semi:WarehouseLocation，源库位（warehouse_id 外键）；(3) hasBillNo（output_bill_no）、hasBillQty（output_count）、hasBillTime（create_time）；destination 记录出库目标（生产线/部门）。执行后触发 warehouse_inventory 对应行更新（在库数量减少）。" .

### ==========================================
### 8. WMS 对象属性 (WMS Object Properties)
### ==========================================

# 8.1 库存管理事件记录关联属性 (WarehouseEventRecord)
semi:isInstanceOfWarehouseEvent a owl:ObjectProperty ;
    rdfs:domain semi:WarehouseEventRecord ; rdfs:range semi:WarehouseEvent ;
    rdfs:label "库存管理事件类型" ;
    rdfs:comment "该库存管理执行记录（WarehouseEventRecord 子类实例）对应的事件类型定义（WarehouseEvent 子类），关联记录到事件规约。与 semi:isInstanceOfEvent（ProductionEventRecord→ProductionEvent）平行，两者共同构成生产域与仓库域的事件类型溯源机制。" .

# 8.2 MaterialBatch 关联属性
semi:batchOfMaterial a owl:ObjectProperty ;
    rdfs:domain semi:MaterialBatch ; rdfs:range semi:Material ;
    rdfs:label "批次所属物料类型" ;
    rdfs:comment "物料批次实例对应的物料类型（semi:Material 子类），必填。建立批次→物料模型的归属关系，支持'某种物料有哪些批次在库'的反向查询。" .

semi:derivedFromLot a owl:ObjectProperty ;
    rdfs:domain semi:MaterialBatch ; rdfs:range semi:ProductionLot ;
    rdfs:label "源生产批次（结批溯源）" ;
    rdfs:comment "产成品批次结批时关联的源 ProductionLot（在制品批次）。仅 semi:Product 类型的 MaterialBatch 填写此属性（derivedFromLot 的 batchOfMaterial → semi:Product）；辅料/备件/原料的 MaterialBatch 此属性为空。支持从产成品批次反向追溯到生产线上的原始在制批次。" .

# 8.2 WarehouseLocation 关联属性
semi:hasInventory a owl:ObjectProperty ;
    rdfs:domain semi:WarehouseLocation ; rdfs:range semi:Inventory ;
    rdfs:label "当前库存明细" ;
    rdfs:comment "库位持有的库存明细记录集合，一个库位可关联多条 Inventory 记录（每种物料批次对应一条）。" .

semi:hasParentLocation a owl:ObjectProperty ;
    rdfs:domain semi:WarehouseLocation ; rdfs:range semi:WarehouseLocation ;
    rdfs:label "上级库位/仓库节点" ;
    rdfs:comment "通过 warehouse_model.parent_id 表达的行政或逻辑归属层级关系（自引用外键）。顶层仓库节点 parent_id=0，叶节点库位指向其所属的上级区域或仓库节点。支持任意深度的树状层级查询（如：库位 → 区域 → 仓库 → 工厂）。" .

# 8.3 Inventory 关联属性
semi:stockOfMaterial a owl:ObjectProperty ;
    rdfs:domain semi:Inventory ; rdfs:range semi:Material ;
    rdfs:label "库存物料类型" ;
    rdfs:comment "该库存明细记录对应的物料类型（反规范化冗余字段，便于按物料类型直接过滤库存，无需经由 MaterialBatch 跳转）。" .

semi:stockOfBatch a owl:ObjectProperty ;
    rdfs:domain semi:Inventory ; rdfs:range semi:MaterialBatch ;
    rdfs:label "库存批次" ;
    rdfs:comment "该库存明细对应的物料批次实例，是库存追踪的精确粒度锚点（批次粒度）。" .

# 8.4 入库记录关联属性
semi:inboundBatch a owl:ObjectProperty ;
    rdfs:domain semi:InboundEventRecord ; rdfs:range semi:MaterialBatch ;
    rdfs:label "入库物料批次" ;
    rdfs:comment "本次入库操作涉及的物料批次实例（含 hasBatchNo；单件追踪型含 hasBoxNo）。" .

semi:inboundToLocation a owl:ObjectProperty ;
    rdfs:domain semi:InboundEventRecord ; rdfs:range semi:WarehouseLocation ;
    rdfs:label "入库目标库位" ;
    rdfs:comment "本次入库操作的目标存储库位。" .

# 8.5 出库记录关联属性
semi:outboundBatch a owl:ObjectProperty ;
    rdfs:domain semi:OutboundEventRecord ; rdfs:range semi:MaterialBatch ;
    rdfs:label "出库物料批次" ;
    rdfs:comment "本次出库操作涉及的物料批次实例。" .

semi:outboundFromLocation a owl:ObjectProperty ;
    rdfs:domain semi:OutboundEventRecord ; rdfs:range semi:WarehouseLocation ;
    rdfs:label "出库源库位" ;
    rdfs:comment "本次出库操作的源存储库位。" .

# 8.6 审批记录关联属性
semi:approvalForMaterial a owl:ObjectProperty ;
    rdfs:domain semi:InboundApprovalRecord ; rdfs:range semi:Material ;
    rdfs:label "审批物料类型" ;
    rdfs:comment "本次入库审批对应的物料类型，便于按物料维度查询历史审批记录。" .

semi:triggersInbound a owl:ObjectProperty ;
    rdfs:domain semi:InboundApprovalRecord ; rdfs:range semi:InboundEventRecord ;
    rdfs:label "审批通过触发入库" ;
    rdfs:comment "审批通过(hasApprovalStatus=1)后关联触发的入库执行记录，建立'审批→入库'的操作因果链（对应 warehouse_approval_record → warehouse_input_bill 的外键关联）。" .

### ==========================================
### 9. WMS 数据属性 (WMS Data Properties)
### ==========================================

# 9.1 WarehouseLocation 数据属性
semi:hasWarehouseCode a owl:DatatypeProperty ;
    rdfs:domain semi:WarehouseLocation ;
    rdfs:range xsd:string ;
    rdfs:label "仓库编码" ;
    rdfs:comment "仓库唯一业务标识码，对应 warehouse_model.code。" .

semi:hasWarehouseName a owl:DatatypeProperty ;
    rdfs:domain semi:WarehouseLocation ;
    rdfs:range xsd:string ;
    rdfs:label "仓库名称" ;
    rdfs:comment "仓库显示名称，对应 warehouse_model.name。" .

semi:hasStorageType a owl:DatatypeProperty ;
    rdfs:domain semi:WarehouseLocation ;
    rdfs:range xsd:string ;
    rdfs:label "存储类型" ;
    rdfs:comment "库位的物理环境约束分类，如：常温、冷藏、氮气柜、避光等。当前系统尚未在数据库中建立存储类型管理字段，暂无物理列映射。" .

semi:hasGeoLocation a owl:DatatypeProperty ;
    rdfs:domain semi:WarehouseLocation ;
    rdfs:range xsd:string ;
    rdfs:label "地理位置" ;
    rdfs:comment "库位在厂区或车间的物理坐标描述（如：A栋2楼东侧货架区）。当前系统无对应数据库字段，暂无物理列映射。" .

# 9.2 MaterialBatch 数据属性
semi:hasBatchNo a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialBatch ;
    rdfs:range xsd:string ;
    rdfs:label "批次号" ;
    rdfs:comment "物料批次的业务标识号。产成品：值等于源 ProductionLot 的批次编号（结批时由系统继承填入）；辅料/备件/原料：值为供应商批次号（进货时录入）。所有 MaterialBatch 实例必填。" .

semi:hasBoxNo a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialBatch ;
    rdfs:range xsd:string ;
    rdfs:label "唯一码" ;
    rdfs:comment "物料实例的物理唯一标识码，对应 warehouse_inventory.unique_code 及 bill_detail.unique_code。适用于物料模型开启了逐件唯一码管理（semi:hasUniqueCodeMgmt=true）的物料批次：产成品对应包装盒号（每箱唯一），备件对应设备序列号，等。物料模型未开启唯一码管理（如辅料/原料）时此属性为空。" .

semi:hasBatchQty a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialBatch ;
    rdfs:range xsd:decimal ;
    rdfs:label "批次数量" ;
    rdfs:comment "该物料批次的总数量（通常为入库时的初始批次量）。" .

# 9.3 Inventory 数据属性
semi:hasStockQty a owl:DatatypeProperty ;
    rdfs:domain semi:Inventory ;
    rdfs:range xsd:decimal ;
    rdfs:label "在库数量" ;
    rdfs:comment "该库存明细记录的当前在库数量（实时快照，随入/出库操作动态更新），对应 warehouse_inventory.qty 或 stock_qty 字段。" .

semi:hasStockUnit a owl:DatatypeProperty ;
    rdfs:domain semi:Inventory ;
    rdfs:range xsd:string ;
    rdfs:label "库存单位" ;
    rdfs:comment "在库数量的计量单位（如片/箱/kg/个），对应 warehouse_inventory.unit 字段。" .

# 9.4 InboundApprovalRecord 数据属性
semi:hasApprovalStatus a owl:DatatypeProperty ;
    rdfs:domain semi:InboundApprovalRecord ;
    rdfs:range xsd:string ;
    rdfs:label "审批状态" ;
    rdfs:comment "入库审批当前状态，对应 warehouse_approval_record.audit_state 字段（字符串类型）。语义枚举：单值表示当前阶段（如 '1'/'2'/'3'），逗号分隔多值（如 '1,2,3'）表示多阶段审批流的已完成节点列表。具体语义枚举见 value_mappings。" .

semi:hasApprovalResult a owl:DatatypeProperty ;
    rdfs:domain semi:InboundApprovalRecord ;
    rdfs:range xsd:string ;
    rdfs:label "审批结论/备注" ;
    rdfs:comment "审批人填写的审批结论或驳回原因文本，对应 warehouse_approval_record.remark 或 result 字段。" .

# 9.5 入出库单据公共数据属性
semi:hasBillNo a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:InboundEventRecord semi:OutboundEventRecord) ] ;
    rdfs:range xsd:string ;
    rdfs:label "单据编号" ;
    rdfs:comment "入库单/出库单的唯一单据号，对应 warehouse_input_bill.bill_no 或 warehouse_output_bill.bill_no。" .

semi:hasBillQty a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:InboundEventRecord semi:OutboundEventRecord) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "单据数量" ;
    rdfs:comment "本次入库或出库操作的实际执行数量。" .

semi:hasBillTime a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:InboundEventRecord semi:OutboundEventRecord) ] ;
    rdfs:range xsd:dateTime ;
    rdfs:label "单据时间" ;
    rdfs:comment "入库或出库操作的执行时间戳，对应 bill_time 或 create_time 字段。" .

