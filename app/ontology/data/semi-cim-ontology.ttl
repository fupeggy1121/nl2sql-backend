# 3.12 物料数据属性 (Material 及其子类共享)
semi:hasMaterialCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Material semi:Product semi:RawMaterial semi:Auxiliary semi:SparePart) ] ;
    rdfs:range xsd:string ;
    rdfs:label "物料编码" ;
    rdfs:comment "对应 material_no 或 code 字段。" .

semi:hasMaterialName a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Material semi:Product semi:RawMaterial semi:Auxiliary semi:SparePart) ] ;
    rdfs:range xsd:string ;
    rdfs:label "物料名称" ;
    rdfs:comment "对应 material_name 或 name 字段。" .

semi:hasMaterialType a owl:DatatypeProperty ;
    rdfs:domain semi:Material ;
    rdfs:range xsd:string ;
    rdfs:label "物料类型" ;
    rdfs:comment "物料分类标识，对应 material_type 或 type 字段（字符串枚举），用于区分原料/辅料/备件/产品等子类。SparePart / Product 子类也共用此属性，值域因子类而异。" .

semi:hasMaterialSpec a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Material semi:Product semi:RawMaterial semi:Auxiliary) ] ;
    rdfs:range xsd:string ;
    rdfs:label "物料规格" ;
    rdfs:comment "对应 spec 或 material_spec 字段。" .

semi:hasUnit a owl:DatatypeProperty ;
    rdfs:domain semi:Material ;
    rdfs:range xsd:string ;
    rdfs:label "物料单位" .

semi:hasBatchMgmt a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Material semi:Product semi:RawMaterial semi:Auxiliary semi:SparePart) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "启用批次管理" ;
    rdfs:comment "物料模型是否开启批次号管理，对应 warehouse_material.batch（bit(1)）字段。true=该物料入库时须填写批次号（semi:MaterialBatch.hasBatchNo）；false=不区分批次，按数量管理。此配置决定 MaterialBatch.hasBatchNo 是否为必填。适用于 semi:Material 所有子类（Product/Auxiliary/SparePart/RawMaterial）。" .

semi:hasUniqueCodeMgmt a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:Material semi:Product semi:RawMaterial semi:Auxiliary semi:SparePart) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "启用逐件唯一码管理" ;
    rdfs:comment "物料模型是否开启逐件唯一码管理，对应 warehouse_material.unique_code（bit(1)）字段。true=该物料每个实例具备唯一码（semi:MaterialBatch.hasBoxNo），可逐件扫码追踪（如产成品包装盒号、备件序列号）；false=仅以批次号+数量管理（如辅料/原料）。与 semi:hasBatchMgmt 均为物料模型层配置，决定 MaterialBatch 实例的管理规范。" .

# 3.13 动作日志数据属性
semi:hasOperationType a owl:DatatypeProperty ;
    rdfs:domain semi:Action ;
    rdfs:range xsd:string ;
    rdfs:label "操作类型" ;
    rdfs:comment "如进站、出站、拆批、并批、Hold、Release，对应 operation_type。" .

semi:hasBeforeState a owl:DatatypeProperty ;
    rdfs:domain semi:Action ;
    rdfs:range xsd:string ;
    rdfs:label "操作前状态" ;
    rdfs:comment "对应 before_state 字段。" .

semi:hasAfterState a owl:DatatypeProperty ;
    rdfs:domain semi:Action ;
    rdfs:range xsd:string ;
    rdfs:label "操作后状态" ;
    rdfs:comment "对应 after_state 字段。" .

# 3.14 量测与制程参数过站记录数据属性 (MeasurementPassRecord)
# 对应物理表：process_measure_data（量测设备自动采集）+ process_measure_data_raw（人工录入）

semi:hasMeasurementResult a owl:DatatypeProperty ;
    rdfs:domain semi:MeasurementPassRecord ;
    rdfs:range xsd:string ;
    rdfs:label "量测结果数据" ;
    rdfs:comment "量测工序采集的质量参数（JSON），含逐片数据及统计聚合值（最大/最小/平均/标准差），表征当前阶段批次整体质量属性。对应 process_measure_data 表中的参数值字段。" .

semi:hasSamplingRule a owl:DatatypeProperty ;
    rdfs:domain semi:MeasurementPassRecord ;
    rdfs:range xsd:string ;
    rdfs:label "抽检规则" ;
    rdfs:comment "该量测站点应用的抽检规则标识（如'每批抽n片'），决定量测结果对批次的代表性置信度。" .

# 3.14.4 生产事件记录属性 (ProductionEventRecord)
semi:hasEventType a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "谱系事件类型" ;
    rdfs:comment "批次谱系变更事件类型（整数枚举）：1=拆批、2=并批、12=返工、14=拆父批、16=攒批。对应 matrix_routerx_operation_lot_batch_resume_log.operation_type。完整23种类型枚举见 semi:LotOperationType。" .

semi:hasEventStartTime a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "事件开始时间" ;
    rdfs:comment "生产事件的开始时间戳，对应 matrix_routerx_operation_lot_batch_resume_log.gmt_create。" .

semi:hasEventEndTime a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "事件结束时间" ;
    rdfs:comment "生产事件的结束时间戳。" .

semi:hasOperatorId a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "操作人ID" ;
    rdfs:comment "执行该生产事件的操作人标识，对应 matrix_routerx_operation_lot_batch_resume_log.operator_id。" .

semi:hasLotStatusBefore a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "事件前批次状态" ;
    rdfs:comment "事件执行前的批次状态快照，对应 matrix_routerx_operation_lot_batch_resume_log_detail.before_state。" .

semi:hasLotStatusAfter a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "事件后批次状态" ;
    rdfs:comment "事件执行后的批次状态快照，对应 matrix_routerx_operation_lot_batch_resume_log_detail.after_state。" .

### ==========================================
### 4. 事件逻辑规约注解属性 (Event Logic Annotation Properties)
### ==========================================
### 设计说明：
###   下列 6 个注解属性构成事件类（XxxEvent）的五维度逻辑规约框架，
###   挂载于具体事件类的类定义上（如 semi:SplitEvent）。
###   语义引擎（Semantic Resolver）扫描 XxxEventRecord 时，
###   追溯 isInstanceOfEvent 所指向的事件类，读取各维度规约，
###   生成物理 SQL/API 调用序列后执行。
###
###   维度一  preCondition        — 准入门禁（验证前置状态）
###   维度二  inputSchema         — 参数规约（外部输入参数集）
###   维度三  transformationLogic — 状态算子（状态跳转执行逻辑）
###   维度四  apiBinding          — 服务绑定（物理 MES 接口）
###   维度五  postCondition       — 约束后验（结果校验）
###   辅助    stateTransitionFunction — 精简的本体对象状态更新指令模板
### ==========================================

semi:preCondition a owl:AnnotationProperty ;
    rdfs:label "准入规则" ;
    rdfs:comment "维度一：事件执行的前置门禁条件，引擎执行前须校验通过。不满足则向用户返回拦截原因，不进入执行流程。格式：领域对象.属性 运算符 期望值。" .

semi:inputSchema a owl:AnnotationProperty ;
    rdfs:label "参数规约" ;
    rdfs:comment "维度二：驱动本事件所需的最小外部输入参数集（JSON Schema 描述）。仅包含业务必要的外部输入；系统自动生成的值（如新批次ID）作为 transformationLogic 的产出变量（$var），不在此列。" .

semi:transformationLogic a owl:AnnotationProperty ;
    rdfs:label "状态算子" ;
    rdfs:comment "维度三：事件触发后的状态跳转逻辑，供语义引擎解析并转化为物理 SQL/API 调用。伪代码约定：LET $var = CALL apiBinding 捕获调用返回值；CREATE/SET/UPDATE 操作本体对象；?param 引用 inputSchema 中的入参。" .

semi:apiBinding a owl:AnnotationProperty ;
    rdfs:label "服务绑定" ;
    rdfs:comment "维度四：本事件绑定的 MES 外部服务接口标识（服务名.方法名）。引擎执行 transformationLogic 中 CALL 指令时调用，返回值（如 generated_lot_id）捕获到对应 $var 变量。" .

semi:postCondition a owl:AnnotationProperty ;
    rdfs:label "约束后验" ;
    rdfs:comment "维度五：事件执行完成后的结果验证条件，确认状态已正确变更。引擎在 API 调用和状态同步完成后执行，不满足则触发回滚或告警。" .

semi:stateTransitionFunction a owl:AnnotationProperty ;
    rdfs:label "状态转换函数" ;
    rdfs:comment "辅助维度：本体对象层面的状态更新指令模板（精简描述），供语义引擎转化为物理 UPDATE/INSERT。格式：UPDATE Target(类名) SET 属性 = EventRecord.属性 [WHERE 条件]。与 transformationLogic 互补，后者描述完整执行序列，本属性聚焦于本体图谱的状态向量变更。" .

semi:tableFilter a owl:AnnotationProperty ;
    rdfs:label "物理表行级过滤条件" ;
    rdfs:comment "指定 XxxEventRecord 子类在映射物理表时所需的 WHERE 谓词。所有 semi:ProductionEventRecord 子类均存储于同一张表 matrix_routerx_operation_lot_batch_resume_log，通过 operation_type 整数字段区分子类型；语义引擎生成 SQL 时将本注解值直接拼入 WHERE 子句。格式：column_name = value。" .

semi:isAbstract a owl:AnnotationProperty ;
    rdfs:label "是否为抽象类" ;
    rdfs:comment "标注该 OWL 类为抽象父类（不应直接实例化为数据行，只作为子类的父类层级使用）。取值 \"true\"^^xsd:boolean。" .

semi:operationTypeCode a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "操作类型编码" ;
    rdfs:comment "批次操作类型命名个体（owl:NamedIndividual）对应的整数编码，与物理表 matrix_routerx_operation_lot_batch_resume_log.operation_type 字段值一一对应。" .

### ==========================================
### 5. 生产事件具体化类群 (Specific Production Event Classes)
### ==========================================
### 建模规范：
###   每种操作类型由两个相互绑定的类共同描述：
###   ① XxxEvent    — rdfs:subClassOf semi:ProductionEvent
###       挂载 5 维度逻辑规约注解，是操作的静态规则/类型模板。
###   ② XxxEventRecord — rdfs:subClassOf semi:ProductionEventRecord
###       存储一次具体执行的实例数据；通过
###       [ owl:Restriction; owl:onProperty isInstanceOfEvent;
###         owl:allValuesFrom XxxEvent ]
###       将记录锁定到对应规则定义，使引擎可从记录追溯到完整规约。
### ==========================================

# 5.1 拆批事件定义 (SplitEvent)
semi:SplitEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "拆批事件定义" ;
    rdfs:comment "定义拆批（Split）操作的规则/类型模板。将源批次中的指定晶圆析出，由 MES 系统自动生成新批次 ID。拆批不涉及物理设备加工，仅执行批次谱系切割与 Wafer 归属迁移。执行记录层见 semi:SplitEventRecord。" ;
    # 维度一：准入规则 — 源批次须处于待加工状态且晶圆数量可拆
    semi:preCondition "ParentLot.status == 0 && ParentLot.waferCount > 1" ;
    # 注：status=0 对应 matrix_routerx_operation_lot.status=0（待加工/待进站），整数枚举。
    # 维度二：参数规约 — 仅需外部传入源批次ID与待拆晶圆列表；新批次ID由系统生成
    semi:inputSchema "{ parentLotId: string, splitWaferList: string[] }" ;
    # 维度三：状态算子 — 调用 API 取得新批次ID，创建新批次+初始Sublot、迁移Wafer归属、建立父子谱系
    semi:transformationLogic "LET $newId = CALL apiBinding; CREATE semi:ProductionLot($newId); LET $newSublotId = $newId.initialSublot; CREATE semi:Sublot($newSublotId); SET $newId.containsSublot = $newSublotId; SET $newId.hasParentLot = ?parentLotId; UPDATE semi:Wafer SET belongsToLot = $newId, belongsToSublot = $newSublotId WHERE id IN ?splitWaferList" ;
    # 维度四：服务绑定 — 调用 MES 核心服务拆批接口，接口返回值含系统生成的新批次ID
    semi:apiBinding "MES_CORE_SERVICE.executeSplitAction" ;
    # 维度五：约束后验 — 确认新批次已实例化，源批次数量已正确扣减
    semi:postCondition "checkExists($newId) && ParentLot.qty == (prevQty - splitCount)" ;
    # 辅助：状态转换函数 — 被迁移晶圆同时更新 Lot 和 Sublot 两个归属指针
    semi:stateTransitionFunction "UPDATE Target(Wafer) SET belongsToLot = EventRecord.producesLot, belongsToSublot = EventRecord.producesSublot WHERE Wafer.id IN EventRecord.affectsWafer" .

# 5.2 拆批执行记录 (SplitEventRecord)
semi:SplitEventRecord a owl:Class ;
    rdfs:subClassOf semi:ProductionEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:SplitEvent ] ;
    rdfs:label "拆批记录" ;
    semi:tableFilter "operation_type = 1" ;
    rdfs:comment "拆批操作的具体执行记录实例。物理映射：matrix_routerx_operation_lot_batch_resume_log WHERE operation_type = 1（semi:tableFilter 注解值）。核心关联：(1) isInstanceOfEvent → semi:SplitEvent，将记录锁定到拆批规则定义，引擎据此追溯 5 维规约生成物理执行序列；(2) actsOnLot → 源批次（被拆的父批次）；(3) producesLot → MES 系统自动生成的新 ProductionLot（子批次），是拆批操作的核心产出；(4) producesSublot → 与 producesLot 同步创建的初始 Sublot，被迁移晶圆的 belongsToSublot 指向此 Sublot，保证 Wafer→Sublot→atStation 路径仍可导航；(5) affectsWafer → 被迁移的具体晶圆实例列表，支持逐片血缘追溯。物理层三联写入：主记录表（operation_type=1）+ _log_detail（拆批前后批次状态快照）+ _wafer_detail_log（逐片Wafer迁移明细）。" .

# 5.2b 并批事件 (MergeEvent)
semi:MergeEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "并批事件类型" ;
    rdfs:comment "定义并批（Merge）操作的规则/类型模板。对应 operation_type=2。将已拆分的子批次重新归并回其父批次：源批次（lot_id）下所有 Sublot 和 Wafer 的归属更新为目标批次（output_lot_id），源批次状态设为完结。⚠ 谱系操作（is_genealogy_event=True），执行后 DAG 中源节点归并为 Merge 汇聚节点。执行记录层见 semi:MergeEventRecord。" ;
    semi:preCondition "SourceLot.parent_id IS NOT NULL && SourceLot.status IN (50)" ;
    semi:inputSchema "{ sourceLotId: string, targetLotId: string }" ;
    semi:transformationLogic "UPDATE Wafer SET lot_id = targetLotId, sub_lot_id = newSublotId WHERE wafer.lot_id = sourceLotId; UPDATE ProductionLot SET status = Completed WHERE id = sourceLotId" ;
    semi:apiBinding "MES_CORE_SERVICE.executeLotMerge" ;
    semi:postCondition "SourceLot.status == Completed && Wafer.lot_id == targetLotId" ;
    semi:stateTransitionFunction "UPDATE Target(Wafer) SET belongsToLot = EventRecord.mergesIntoLot, belongsToSublot = newSublot WHERE Wafer.lot_id = EventRecord.actsOnLot.lot_id; UPDATE SourceLot SET status = Completed" .

# 5.2c 并批执行记录 (MergeEventRecord)
semi:MergeEventRecord a owl:Class ;
    rdfs:subClassOf semi:ProductionEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:MergeEvent ] ;
    rdfs:label "并批记录" ;
    semi:tableFilter "operation_type = 2" ;
    rdfs:comment "并批操作的具体执行记录实例。物理映射：matrix_routerx_operation_lot_batch_resume_log WHERE operation_type = 2。核心关联：(1) isInstanceOfEvent → semi:MergeEvent；(2) actsOnLot → 源批次（被并入的来源批次，lot_code 字段）；(3) mergesIntoLot → 目标批次（接收方父批次，output_lot_code 字段），是并批操作的接收端；(4) actsOnWafer → 被重新归属的晶圆实例列表（_wafer_detail_log 逐片明细）。⚠ 并批是谱系操作（is_genealogy_event=True）：执行后源批次完结，所有 Wafer 归属迁移至目标批次下的新 Sublot ID。物理层二联写入：主记录表（operation_type=2）+ _wafer_detail_log（逐片Wafer归属迁移明细）。" .

# 5.3 批次扣留事件 (HoldEvent)
semi:HoldEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "批次扣留事件类型" ;
    rdfs:comment "定义批次扣留（Hold）操作的规则/类型模板。对应 operation_type=4。执行后目标批次 WIPStatus 从 Run/IDLE 转为 Hold（激活扣留记录：HoldEventRecord 无对应晚于它的 ReleaseEventRecord）。⚠ 不产生新批次（无 producesLot），actsOnLot 指向被扣留的批次本身。支持预扣留：可在扣留时指定未来某工序站点，批次流转到该工序时自动触发扣留，extra 字段存储 preHoldProcessId/preHoldProcessCode。执行记录层见 semi:HoldEventRecord。" ;
    # 维度一：准入规则 — 目标批次须在制（未被其他激活扣留且批次状态正常）
    semi:preCondition "TargetLot.status IN (50) && WIPStatus(lotId) != Hold" ;
    # 维度二：参数规约 — 批次ID必须；预扣留工序可选
    semi:inputSchema "{ lotId: string, preHoldProcessId?: string, preHoldProcessCode?: string }" ;
    # 维度三：状态算子 — 将目标批次状态设为 80（Staged/暂存），记录扣留事件
    semi:transformationLogic "UPDATE ProductionLot SET status = 80 WHERE id = ?lotId; INSERT HoldEventRecord(lot_id=?lotId, operation_type=4, extra={preHoldProcessId:?preHoldProcessId})" ;
    # 维度四：服务绑定
    semi:apiBinding "MES_CORE_SERVICE.executeLotHold" ;
    # 维度五：约束后验 — 确认激活扣留已存在
    semi:postCondition "WIPStatus(lotId) == Hold" ;
    # 辅助：状态转换函数
    semi:stateTransitionFunction "UPDATE Target(ProductionLot) SET status = 80 WHERE Lot.id = EventRecord.lot_id" .

# 5.4 批次扣留执行记录 (HoldEventRecord)
semi:HoldEventRecord a owl:Class ;
    rdfs:subClassOf semi:ProductionEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:HoldEvent ] ;
    rdfs:label "批次扣留记录" ;
    semi:tableFilter "operation_type = 4" ;
    rdfs:comment "批次扣留操作的具体执行记录实例。物理映射：matrix_routerx_operation_lot_batch_resume_log WHERE operation_type = 4。【关联语义】actsOnLot → 被扣留的批次（操作主体，即被扣留的 ProductionLot；该批次 WIPStatus 执行后转为 Hold）；⚠ 该操作不产生新批次（producesLot 不适用，不出现在本子类的 SQL 关联中）。区别于拆批：拆批 actsOnLot 是源批次、producesLot 是新析出批次；扣留操作 actsOnLot 与被操作对象同一，无产出批次。extra 字段可包含预扣留工序信息（preHoldProcessId/preHoldProcessCode）。" .

# 5.5 批次释放事件 (ReleaseEvent)
semi:ReleaseEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "批次释放事件类型" ;
    rdfs:comment "定义批次释放（Release）操作的规则/类型模板。对应 operation_type=5。解除批次激活扣留状态，执行后 WIPStatus 从 Hold 恢复为 Run 或 IDLE（取决于 process_status 值）。⚠ 不产生新批次（无 producesLot），actsOnLot 指向被释放的扣留批次本身。注意区分：status=80(BatchStatus.Staged/暂存) 是独立字段，与激活扣留不等价，釋放操作针对激活扣留记录（HoldEventRecord），而非仅针对 status=80 字段。执行记录层见 semi:ReleaseEventRecord。" ;
    # 维度一：准入规则 — 目标批次须存在激活扣留记录
    semi:preCondition "WIPStatus(lotId) == Hold" ;
    # 维度二：参数规约 — 仅需批次ID
    semi:inputSchema "{ lotId: string }" ;
    # 维度三：状态算子 — 记录释放事件；WIPStatus 由激活扣留计算推导（非直接设字段）
    semi:transformationLogic "INSERT ReleaseEventRecord(lot_id=?lotId, operation_type=5, gmt_create=NOW())" ;
    # 维度四：服务绑定
    semi:apiBinding "MES_CORE_SERVICE.executeLotRelease" ;
    # 维度五：约束后验 — 确认激活扣留已解除
    semi:postCondition "WIPStatus(lotId) != Hold" ;
    # 辅助：状态转换函数 — WIPStatus 由推导计算，物理无直接单字段更新；此处记录语义
    semi:stateTransitionFunction "INSERT ReleaseEventRecord WHERE lot_id = EventRecord.lot_id; DERIVED: WIPStatus(lot_id) transitions Hold → Run|IDLE based on process_status" .

# 5.6 批次释放执行记录 (ReleaseEventRecord)
semi:ReleaseEventRecord a owl:Class ;
    rdfs:subClassOf semi:ProductionEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:ReleaseEvent ] ;
    rdfs:label "批次释放记录" ;
    semi:tableFilter "operation_type = 5" ;
    rdfs:comment "批次释放操作的具体执行记录实例。物理映射：matrix_routerx_operation_lot_batch_resume_log WHERE operation_type = 5。【关联语义】actsOnLot → 被扣留待释放的批次（操作主体，即被释放的 ProductionLot；该批次 WIPStatus 执行后从 Hold 恢复为 Run 或 IDLE）；⚠ 该操作不产生新批次（producesLot 不适用）。WIPStatus 的转变由推导逻辑决定：释放后不再满足激活扣留条件（EXISTS HoldEventRecord 且无 ReleaseEventRecord），WIPStatus 恢复为 process_status 决定的 Run 或 IDLE。区别于拆批：拆批有明确的 actsOnLot（源批次）→ producesLot（新析出批次）谱系关系；释放/扣留操作均为单批次状态变更，不涉及批次谱系生成。" .

# 5.7 不良录入事件 (NGRecordEvent)
semi:NGRecordEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "不良录入事件类型" ;
    rdfs:comment "定义 Wafer 不良录入（NG Record）操作的规则/类型模板。对应 operation_type=6。在批次进站加工或量测后，操作员对检出的不良晶圆标记不良原因码（ng_code）；不良录入不改变批次整体 status，仅在 wafer 维度（_wafer_detail_log）写入 ng_code 标记。执行记录见 semi:NGRecordEventRecord。" ;
    semi:preCondition "Lot.process_status IN (40,50) AND Lot.status NOT IN (80)" ;
    semi:inputSchema "{ lotId: string, waferList: [{waferId: string, ngCode: string}] }" ;
    semi:apiBinding "MES_CORE_SERVICE.executeNGRecord" .

# 5.8 不良录入执行记录 (NGRecordEventRecord)
semi:NGRecordEventRecord a owl:Class ;
    rdfs:subClassOf semi:ProductionEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:NGRecordEvent ] ;
    rdfs:label "不良录入记录" ;
    semi:tableFilter "operation_type = 6" ;
    rdfs:comment "不良录入操作的具体执行记录实例。物理映射：matrix_routerx_operation_lot_batch_resume_log WHERE operation_type = 6。【关联语义】actsOnLot → 被标记不良的批次；affectsWafer → 具体被标记的晶圆实例列表。不良明细写入 _wafer_detail_log（ng_code 字段）。不改变批次 status，不产生新批次（producesLot 不适用）。" .

# 5.9 批次进站事件 (CheckInEvent)
semi:CheckInEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "批次进站事件类型" ;
    rdfs:comment "定义批次进站（Check-In）操作的规则/类型模板。对应 operation_type=8。批次（以子批次/Sublot 为单位）进入某道工序开始加工或量测的动作，记录进站时间、绑定设备。执行后 process_status 变为 40（In-Process/加工中）。执行记录见 semi:CheckInEventRecord。" ;
    semi:preCondition "Lot.process_status IN (10,20,30) AND Lot.status == 50" ;
    semi:inputSchema "{ sublotId: string, stationId: string, equipmentId?: string }" ;
    semi:transformationLogic "UPDATE Sublot SET atStation = ?stationId, process_status = 40; INSERT CheckInEventRecord(operation_type=8, lot_id, sublot_id, station_id, equipment_id, gmt_create=NOW())" ;
    semi:apiBinding "MES_CORE_SERVICE.executeCheckIn" ;
    semi:postCondition "Sublot.process_status == 40" .

# 5.10 批次进站执行记录 (CheckInEventRecord)
semi:CheckInEventRecord a owl:Class ;
    rdfs:subClassOf semi:ProductionEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:CheckInEvent ] ;
    rdfs:label "批次进站记录" ;
    semi:tableFilter "operation_type = 8" ;
    rdfs:comment "批次进站操作的具体执行记录实例。物理映射：matrix_routerx_operation_lot_batch_resume_log WHERE operation_type = 8。【关联语义】actsOnLot → 进站的批次（操作主体）；执行后 Sublot.atStation 指向目标工序站点，process_status 转变为 40（加工中）。不产生新批次（producesLot 不适用）。区别于 CheckOutEventRecord：进站标志着工序处理的开始，出站标志着完成并流转下道。station_id/equipment_id 字段记录进站工序与绑定设备。" .

# 5.11 批次出站事件 (CheckOutEvent)
semi:CheckOutEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "批次出站事件类型" ;
    rdfs:comment "定义批次出站（Check-Out）操作的规则/类型模板。对应 operation_type=9。批次完成当前工序加工/量测后确认出站，记录出站时间；执行后 process_status 变为 10/20（待进站下道工序），Sublot.atStation 更新（或进入完结态）。执行记录见 semi:CheckOutEventRecord。" ;
    semi:preCondition "Lot.process_status == 40" ;
    semi:inputSchema "{ sublotId: string, stationId: string }" ;
    semi:transformationLogic "UPDATE Sublot SET process_status = 10; INSERT CheckOutEventRecord(operation_type=9, lot_id, sublot_id, station_id, gmt_create=NOW())" ;
    semi:apiBinding "MES_CORE_SERVICE.executeCheckOut" ;
    semi:postCondition "Sublot.process_status IN (10,20)" .

# 5.12 批次出站执行记录 (CheckOutEventRecord)
semi:CheckOutEventRecord a owl:Class ;
    rdfs:subClassOf semi:ProductionEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:CheckOutEvent ] ;
    rdfs:label "批次出站记录" ;
    semi:tableFilter "operation_type = 9" ;
    rdfs:comment "批次出站操作的具体执行记录实例。物理映射：matrix_routerx_operation_lot_batch_resume_log WHERE operation_type = 9。【关联语义】actsOnLot → 出站的批次（操作主体）；执行后 Sublot.process_status 转变为 10/20（待进站），批次流转至下道工序。不产生新批次（producesLot 不适用）。与 CheckInEventRecord 成对出现：一次完整的过站周期 = 一条 CheckInEventRecord（op=8）+ 一条 CheckOutEventRecord（op=9）。station_id 字段记录本道出站工序。" .

# 5.13 攒批事件 (AccumulateEvent)
semi:AccumulateEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "攒批事件类型" ;
    rdfs:comment "定义攒批（Accumulate）操作的规则/类型模板。对应 operation_type=16。将多个属于相同产品型号的独立 ProductionLot 合并为一个全新批次（MES 自动生成新 lot_id 及新 sublot_id）。⚠ 谱系操作（is_genealogy_event=True）：执行后 DAG 中多个源节点汇聚为一个新子节点，不同于并批（Merge）归回已有父批次。区别于 MergeEvent：攒批产出全新 ProductionLot + Sublot，并批只更新 wafer 归属至已存在的父批次。执行记录层见 semi:AccumulateEventRecord。" ;
    semi:preCondition "ALL SourceLots.product_id == SAME && ALL SourceLots.status IN (50)" ;
    semi:inputSchema "{ sourceLotIds: string[], productId: string }" ;
    semi:transformationLogic "INSERT ProductionLot(new_lot_id); INSERT Sublot(new_sublot_id, lot_id=new_lot_id); UPDATE Wafer SET lot_id=new_lot_id, sub_lot_id=new_sublot_id WHERE wafer.lot_id IN sourceLotIds; UPDATE SourceLots SET status=Completed" ;
    semi:apiBinding "MES_CORE_SERVICE.executeAccumulate" ;
    semi:postCondition "new ProductionLot EXISTS && Wafer.lot_id == new_lot_id" ;
    semi:stateTransitionFunction "UPDATE Target(Wafer) SET belongsToLot=EventRecord.producesLot, belongsToSublot=EventRecord.producesSublot WHERE Wafer.lot_id IN EventRecord.actsOnLot; UPDATE SourceLots SET status=Completed" .

# 5.14 攒批执行记录 (AccumulateEventRecord)
semi:AccumulateEventRecord a owl:Class ;
    rdfs:subClassOf semi:ProductionEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:AccumulateEvent ] ;
    rdfs:label "攒批记录" ;
    semi:tableFilter "operation_type = 16" ;
    rdfs:comment "攒批操作的具体执行记录实例。物理映射：matrix_routerx_operation_lot_batch_resume_log WHERE operation_type = 16。⚠ 物理层多行模型：每个源批次对应一行记录（lot_code=源批次，output_lot_code=新批次），同一次攒批操作的多行共享相同的 output_lot_id 和 gmt_create/operator_id。核心关联：(1) isInstanceOfEvent → semi:AccumulateEvent；(2) actsOnLot → 各源批次（每行一个，同产品型号）；(3) producesLot → 新生成的 ProductionLot（output_lot_code，所有行相同）；(4) producesSublot → 新批次对应的初始 Sublot；(5) actsOnWafer → 被攒入新批次的晶圆实例列表（_wafer_detail_log 逐片明细）。谱系操作：执行后所有源批次完结，wafer 归属迁移至新批次/子批次。" .

### ==========================================
### 5.13（已重构）_detail 中间表（原 SublotOpSnapshot）
### 5.14（已重构）_wafer_detail_log 中间表（原 WaferTransitionRecord）
### ==========================================
### 物理层三联写说明（更新）：
###   所有 ProductionEventRecord 子类在写入主表 _resume_log 的同时，
###   关联从表按操作类型写入相应明细：
###   - _detail：semi:affectsSublot 关系的物理中间表
###     （resume_log_id → sublot_id；快照字段：carrier_code/process_code/before_state/after_state）
###   - _wafer_detail_log：semi:actsOnWafer 关系的物理中间表
###     （resume_log_id → wafer_id；快照字段：from_lot_id/to_lot_id/ng_code/carrier_code/slot_no）
###   两张从表是对象属性关系的实现载体，不作为独立本体类建模。

# semi:SublotOpSnapshot — 已降级为关系实现表 (virtual_kind: detail_snapshot)
# 语义由 semi:affectsSublot ObjectProperty 完整表达，不再作为可查询类存在。
# 物理表：matrix_routerx_operation_lot_batch_resume_log_detail

# semi:WaferTransitionRecord — 已降级为关系实现表 (virtual_kind: detail_snapshot)
# 语义由 semi:actsOnWafer ObjectProperty 完整表达，不再作为可查询类存在。
# 物理表：matrix_routerx_operation_lot_batch_resume_wafer_detail_log

# 5.15 量测事件类型 (MeasurementEvent)
semi:MeasurementEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "量测参数录入事件" ;
    rdfs:comment "定义量测或制程参数录入操作的事件类型模板。Wafer 经过量测站点时，通过量测设备（eqp_id）或操作员人工录入，针对每片 Wafer 的每个参数规格（param_model_id）产生一条 MeasurementPassRecord。与进站/出站事件的区别：进站/出站操作以批次为粒度写入 resume_log，量测录入以单片 Wafer × 单参数为粒度写入 process_measure_data。" .

### ==========================================
### 6. 操作类型枚举 (NamedIndividuals)
### ==========================================
### 设计说明：
###   semi:LotOperationType 不建模为 owl:Class。
###   所有 semi:ProductionEventRecord 子类（XxxEventRecord）均存储于同一物理表
###   matrix_routerx_operation_lot_batch_resume_log，通过 operation_type 整数字段区分
###   事件子类型。XxxEventRecord 子类通过 semi:tableFilter 注解属性声明过滤条件，
###   语义引擎生成 SQL 时自动附加 WHERE operation_type = N 谓词。
###
###   下列命名个体（owl:NamedIndividual）提供可引用的枚举标识，
###   通过 semi:operationTypeCode 属性绑定对应物理整数编码。
###   完整枚举值映射见 mapping_prod.json value_mappings 中的 operation_type 条目。
### ==========================================

semi:SplitOp          a owl:NamedIndividual ; rdfs:label "1-拆批操作"          ; semi:operationTypeCode 1 .
semi:MergeLotsOp      a owl:NamedIndividual ; rdfs:label "2-并批操作"          ; semi:operationTypeCode 2 .
semi:CarrierTransOp   a owl:NamedIndividual ; rdfs:label "3-倒篮操作"          ; semi:operationTypeCode 3 .
semi:HoldOp           a owl:NamedIndividual ; rdfs:label "4-批次扣留"          ; semi:operationTypeCode 4 .
semi:ReleaseOp        a owl:NamedIndividual ; rdfs:label "5-批次释放"          ; semi:operationTypeCode 5 .
semi:NGRecordOp       a owl:NamedIndividual ; rdfs:label "6-不良录入"          ; semi:operationTypeCode 6 .
semi:CancelNGOp       a owl:NamedIndividual ; rdfs:label "7-取消不良"          ; semi:operationTypeCode 7 .
semi:CheckInOp        a owl:NamedIndividual ; rdfs:label "8-批次进站"          ; semi:operationTypeCode 8 .
semi:CheckOutOp       a owl:NamedIndividual ; rdfs:label "9-批次出站"          ; semi:operationTypeCode 9 .
semi:ReturnOp         a owl:NamedIndividual ; rdfs:label "10-批次退回"         ; semi:operationTypeCode 10 .
semi:SkipOp           a owl:NamedIndividual ; rdfs:label "11-批次跳站"         ; semi:operationTypeCode 11 .
semi:ReworkOp         a owl:NamedIndividual ; rdfs:label "12-返工操作"         ; semi:operationTypeCode 12 .
semi:CancelReworkOp   a owl:NamedIndividual ; rdfs:label "13-取消返工"         ; semi:operationTypeCode 13 .
semi:SplitParentOp    a owl:NamedIndividual ; rdfs:label "14-拆父批操作"       ; semi:operationTypeCode 14 .
semi:SwitchSubRouteOp a owl:NamedIndividual ; rdfs:label "15-切换子路径"       ; semi:operationTypeCode 15 .
semi:AccumulateOp     a owl:NamedIndividual ; rdfs:label "16-攒批操作"         ; semi:operationTypeCode 16 .
semi:CarrierChangeOp  a owl:NamedIndividual ; rdfs:label "17-片篮更换"         ; semi:operationTypeCode 17 .
semi:CreateLocalLotOp a owl:NamedIndividual ; rdfs:label "18-本地批次创建"     ; semi:operationTypeCode 18 .
semi:OpenLotOp        a owl:NamedIndividual ; rdfs:label "19-开批"             ; semi:operationTypeCode 19 .
semi:ExpSkipOp        a owl:NamedIndividual ; rdfs:label "20-实验跳站"         ; semi:operationTypeCode 20 .
semi:CancelLocalLotOp a owl:NamedIndividual ; rdfs:label "21-取消本地批次创建" ; semi:operationTypeCode 21 .
semi:CancelOpenLotOp  a owl:NamedIndividual ; rdfs:label "22-取消开批"         ; semi:operationTypeCode 22 .
semi:CompleteLotOp    a owl:NamedIndividual ; rdfs:label "23-批次完结"         ; semi:operationTypeCode 23 .

### ==========================================
### 7. 仓库与库存类群 (Warehouse & Inventory Classes)
### ==========================================
### 适用范围：线边仓（产线本地仓）管理
### 对应物理表：warehouse_location, warehouse_inventory,
###            warehouse_approval_record,
###            warehouse_input_bill, warehouse_input_bill_detail,
###            warehouse_input_record_bill, warehouse_input_record_bill_detail,
###            warehouse_output_bill, warehouse_output_bill_detail,
###            warehouse_output_record_bill, warehouse_output_record_bill_detail
### ==========================================

# 7.1 库位 (WarehouseLocation) — warehouse_model
semi:WarehouseLocation a owl:Class ;
    rdfs:label "库位" ;
    rdfs:comment "线边仓物理存储空间的最小管理单元。对应 warehouse_model 表（支持多层级，通过 parent_id/parent_name 维护层次结构）；每条记录代表一个独立的库位节点，通过 code/name 标识，type 区分存储类型，warehouse_id/area_id/factory_id 表示所属仓库/区域/工厂。注：equipment_warehouse 表是设备旁的暂存缓冲区（绑定到设备），与 warehouse_model 是两个不同的存储概念。通过 semi:hasInventory 关联当前库存明细集合。" .

# 7.2 物料批次/物料实例 (MaterialBatch)
semi:MaterialBatch a owl:Class ;
    rdfs:label "物料批次（物料实例）" ;
    rdfs:comment "某种物料（semi:Material 子类）的一次实例化记录，是仓库管理中物料流转的基本单元。统一以 hasBatchNo（批次号，必填）标识批次身份；是否额外具备 hasBoxNo（逐件唯一码）取决于物料模型的配置（semi:hasUniqueCodeMgmt=true 时填写唯一码，如产成品盒号、备件序列号）；是否以批次整体管理由 semi:hasBatchMgmt 配置（底层为 warehouse_material.batch 和 warehouse_material.unique_code 字段）。产成品批次在结批(CompleteLotOp)后创建，通过 derivedFromLot 关联源 ProductionLot；辅料/备件/原料批次通过 hasBatchNo 记录供应商批次号。" .

# 7.3 库存明细 (Inventory) — warehouse_inventory
semi:Inventory a owl:Class ;
    rdfs:label "库存明细" ;
    rdfs:comment "某库位中某种物料批次的当前库存量快照。追踪粒度：(库位 × 物料类型 × 批次) → 在库数量。每条记录是三元组 (WarehouseLocation, Material, MaterialBatch) 对应的当前在库数量，随入/出库事件动态更新。物理映射：warehouse_inventory 表。" .

# 7.4 库存管理事件定义（抽象父类）(WarehouseEvent)
semi:WarehouseEvent a owl:Class ;
    rdfs:subClassOf semi:Action ;
    rdfs:label "库存管理事件定义（抽象父类）" ;
    semi:isAbstract "true"^^xsd:boolean ;
    rdfs:comment "定义库存管理操作类型的抽象模板（入库/出库/审批/申请等）。作为 semi:Action 的子类，与 semi:ProductionEvent 平行，专用于线边仓物料管理域；作用对象为物料批次（semi:MaterialBatch）和库位（semi:WarehouseLocation），区别于生产事件（作用于 semi:ProductionLot 和 semi:ProcessStation）。具体操作类型子类：semi:InboundApprovalEvent（入库审批）、semi:InboundRequestEvent（入库申请）、semi:InboundEvent（入库执行）、semi:OutboundRequestEvent（出库申请）、semi:OutboundEvent（出库执行）。" .

# 7.5 库存管理事件记录（抽象父类）(WarehouseEventRecord)
semi:WarehouseEventRecord a owl:Class ;
    rdfs:label "库存管理事件记录（抽象父类）" ;
    semi:isAbstract "true"^^xsd:boolean ;
    rdfs:comment "库存管理操作的执行记录抽象基类，与 semi:ProductionEventRecord 平行，专用于仓库管理域。每个实例代表一次完整的库存交易事件单据（如一次入库、一次出库、一次申请）。具体子类（事件单据层）：semi:InboundApprovalRecord（入库审批记录）、semi:InboundRequest（入库申请单）、semi:InboundBill（入库记录单）、semi:OutboundRequest（出库申请单）、semi:OutboundBill（出库记录单）。⚠ 明细行项目（semi:InboundEventRecord、semi:OutboundEventRecord、semi:InboundRequestDetail、semi:OutboundRequestDetail）不是独立的 WarehouseEventRecord，而是通过包含关系（containsInboundDetail / containsOutboundDetail / containsInboundRequestDetail / containsOutboundRequestDetail）挂载在对应单据下，代表单据中每个物料批次的行条目。" .

# 7.6 入库审批事件定义 (InboundApprovalEvent)
semi:InboundApprovalEvent a owl:Class ;
    rdfs:subClassOf semi:WarehouseEvent ;
    rdfs:label "入库审批事件定义" ;
    rdfs:comment "定义线边仓入库审批操作的规则/类型模板。产成品在包装完成后、入库前须经质检审批，审批通过(status=1)后方可触发入库操作。其他物料的入库视业务流程决定是否需要审批。执行记录层见 semi:InboundApprovalRecord。" ;
    semi:preCondition "InboundApprovalRecord.hasApprovalStatus == 0" ;
    semi:inputSchema "{ approvalRecordId: string, approvalResult: integer, approvalRemark: string }" ;
    semi:transformationLogic "UPDATE semi:InboundApprovalRecord(id=?approvalRecordId) SET hasApprovalStatus = ?approvalResult, hasApprovalResult = ?approvalRemark; IF ?approvalResult == 1 THEN TRIGGER semi:InboundEvent FOR EACH batch in approvalRecord.approvalForMaterial" ;
    semi:apiBinding "WMS_SERVICE.executeApproval" ;
    semi:postCondition "InboundApprovalRecord(id=?approvalRecordId).hasApprovalStatus != 0" .

# 7.7 入库审批记录 (InboundApprovalRecord) — warehouse_approval_record
semi:InboundApprovalRecord a owl:Class ;
    rdfs:subClassOf semi:WarehouseEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfWarehouseEvent ;
          owl:allValuesFrom semi:InboundApprovalEvent ] ;
    rdfs:label "入库审批记录" ;
    rdfs:comment "入库审批操作的具体执行记录。物理映射：warehouse_approval_record 表（独立表，全部行均为审批记录，无行级类型区分符）。核心关联：approvalForMaterial → semi:Material（待审批入库的物料类型）；审批通过后由 triggersInbound 指向对应的 InboundEventRecord，建立审批→入库因果链。hasApprovalStatus 对应 audit_state 字段（字符串类型），支持多阶段审批流（如 '1,2,3' 表示多个节点已完成），具体枚举见 value_mappings。" .

# 7.8 入库事件定义 (InboundEvent)
semi:InboundEvent a owl:Class ;
    rdfs:subClassOf semi:WarehouseEvent ;
    rdfs:label "入库事件定义" ;
    rdfs:comment "定义线边仓入库操作的规则/类型模板。将物料批次（MaterialBatch）移入指定库位，执行后更新库存快照（Inventory.hasStockQty += billQty）。产成品入库通常需先完成 InboundApprovalEvent；其他物料可直接入库。执行记录层见 semi:InboundEventRecord。" ;
    semi:preCondition "WarehouseLocation.hasLocationStatus == 1 && MaterialBatch.batchOfMaterial != null" ;
    semi:inputSchema "{ materialBatchId: string, locationId: string, billQty: decimal, billTime: dateTime }" ;
    semi:transformationLogic "LET $inv = FIND semi:Inventory WHERE stockOfBatch=?materialBatchId AND hasInventory.location=?locationId; IF $inv EXISTS THEN UPDATE $inv SET hasStockQty += ?billQty ELSE CREATE semi:Inventory(stockOfBatch=?materialBatchId, stockOfMaterial=batch.batchOfMaterial, hasStockQty=?billQty)" ;
    semi:apiBinding "WMS_SERVICE.executeInbound" ;
    semi:postCondition "Inventory(batch=?materialBatchId, location=?locationId).hasStockQty > 0" .

# 7.9 入库记录单 (InboundBill) — warehouse_input_record_bill
semi:InboundBill a owl:Class ;
    rdfs:subClassOf semi:WarehouseEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfWarehouseEvent ;
          owl:allValuesFrom semi:InboundEvent ] ;
    rdfs:label "入库记录单" ;
    semi:isAbstract "false"^^xsd:boolean ;
    rdfs:comment "入库操作的单据头部记录（主表）。物理映射：warehouse_input_record_bill 表（每行代表一次完整的入库单据，1:N 对应 semi:InboundEventRecord 明细行）。核心字段：record_bill_no（唯一单号/UNI）、status（单据审批状态）、type（入库类型）、gmt_create/user_create（创建时间/人）、reject_reason（拒绝原因）。通过 id → warehouse_input_record_bill_detail.record_bill_id 关联入库明细。" .

# 7.9b 入库执行记录明细 (InboundEventRecord) — warehouse_input_record_bill_detail
# ⚠ 设计注意：InboundEventRecord 是 InboundBill 的行项目，不是独立的 WarehouseEventRecord 子类。
#   它代表「一次入库单据中针对某个物料批次的一条入库明细」，通过 containsInboundDetail 从属于 InboundBill。
semi:InboundEventRecord a owl:Class ;
    rdfs:label "入库记录明细" ;
    rdfs:comment "入库操作的具体执行明细记录（行项目）。物理映射：warehouse_input_record_bill_detail 表（每行对应一个物料/批次的入库行项目，通过 record_bill_id 外键关联入库单主表 warehouse_input_record_bill）。【非 WarehouseEventRecord 子类】：本类是 InboundBill 的组成行，通过对象属性 semi:containsInboundDetail（InboundBill→InboundEventRecord）建立从属关系。核心关联：(1) inboundBatch → semi:MaterialBatch（batch_no/unique_code）；(2) inboundToLocation → semi:WarehouseLocation（warehouse_id）；(3) hasBillQty（count）、hasBillTime（gmt_create）、updatesInventory → semi:Inventory。" .

# 7.10 出库事件定义 (OutboundEvent)
semi:OutboundEvent a owl:Class ;
    rdfs:subClassOf semi:WarehouseEvent ;
    rdfs:label "出库事件定义" ;
    rdfs:comment "定义线边仓出库操作的规则/类型模板。将物料批次从指定库位移出（用于生产线领料或调拨），执行后更新库存快照（Inventory.hasStockQty -= billQty）。执行记录层见 semi:OutboundEventRecord。" ;
    semi:preCondition "Inventory(batch=?materialBatchId, location=?locationId).hasStockQty >= ?billQty" ;
    semi:inputSchema "{ materialBatchId: string, locationId: string, billQty: decimal, billTime: dateTime }" ;
    semi:transformationLogic "UPDATE semi:Inventory SET hasStockQty -= ?billQty WHERE stockOfBatch=?materialBatchId AND atLocation=?locationId" ;
    semi:apiBinding "WMS_SERVICE.executeOutbound" ;
    semi:postCondition "Inventory(batch=?materialBatchId, location=?locationId).hasStockQty >= 0" .

# 7.11 出库记录单 (OutboundBill) — warehouse_output_record_bill
semi:OutboundBill a owl:Class ;
    rdfs:subClassOf semi:WarehouseEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfWarehouseEvent ;
          owl:allValuesFrom semi:OutboundEvent ] ;
    rdfs:label "出库记录单" ;
    semi:isAbstract "false"^^xsd:boolean ;
    rdfs:comment "出库操作的单据头部记录（主表）。物理映射：warehouse_output_record_bill 表（每行代表一次完整的出库单据，1:N 对应 semi:OutboundEventRecord 明细行）。核心字段：record_bill_no（唯一单号/UNI）、status（单据审批状态）、type（出库类型）、destination（出库目标/生产线/部门）、gmt_create/user_create（创建时间/人）、scan_code（扫码字段）。通过 id → warehouse_output_record_bill_detail.record_bill_id 关联出库明细。" .

# 7.11b 出库执行记录明细 (OutboundEventRecord) — warehouse_output_record_bill_detail
# ⚠ 设计注意：OutboundEventRecord 是 OutboundBill 的行项目，不是独立的 WarehouseEventRecord 子类。
#   它代表「一次出库单据中针对某个物料批次的一条出库明细」，通过 containsOutboundDetail 从属于 OutboundBill。
semi:OutboundEventRecord a owl:Class ;
    rdfs:label "出库记录明细" ;
    rdfs:comment "出库操作的具体执行明细记录（行项目）。物理映射：warehouse_output_record_bill_detail 表（每行对应一个物料/批次的出库行项目，通过 record_bill_id 外键关联出库单主表 warehouse_output_record_bill）。【非 WarehouseEventRecord 子类】：本类是 OutboundBill 的组成行，通过对象属性 semi:containsOutboundDetail（OutboundBill→OutboundEventRecord）建立从属关系。核心关联：(1) recordsBatch → semi:MaterialBatch（batch_no/unique_code）；(2) outboundFromLocation → semi:WarehouseLocation（warehouse_id）；(3) hasBillQty（output_count）、hasRequireQty（require_count）、hasStockQty（quantity）、hasBillTime（gmt_create）；destination 记录出库目标（生产线/部门）。" .

# 7.12a 入库申请事件定义 (InboundRequestEvent)
semi:InboundRequestEvent a owl:Class ;
    rdfs:subClassOf semi:WarehouseEvent ;
    rdfs:label "入库申请事件定义" ;
    rdfs:comment "定义线边仓入库申请操作的规则/类型模板。物料需求方（生产线/部门）向仓库提出入库申请，经审批通过后触发 InboundEvent 执行入库并生成 InboundBill。执行记录层见 semi:InboundRequest。" .

# 7.12 入库申请单 (InboundRequest) — warehouse_input_bill
semi:InboundRequest a owl:Class ;
    rdfs:subClassOf semi:WarehouseEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfWarehouseEvent ;
          owl:allValuesFrom semi:InboundRequestEvent ] ;
    rdfs:label "入库申请单" ;
    semi:isAbstract "false"^^xsd:boolean ;
    rdfs:comment "入库操作的申请单据（申请层）。物理映射：warehouse_input_bill 表（每行代表一次入库申请，审批通过后生成 semi:InboundBill 入库记录单）。核心字段：bill_no（唯一申请单号/UNI）、status（审批状态）、type（入库类型）、reject_reason/reject_reason_remark（拒绝原因）。通过 id → warehouse_input_record_bill.input_bill_id（FK）关联已生成的入库记录单。业务流程：入库申请 → 审批 → 生成 InboundBill → 执行InboundEventRecord。" .

# 7.13 入库申请明细 (InboundRequestDetail) — warehouse_input_bill_detail
# ⚠ 设计注意：InboundRequestDetail 是 InboundRequest 的行项目，不是独立的 WarehouseEventRecord 子类。
#   通过 containsInboundRequestDetail（InboundRequest→InboundRequestDetail）建立从属关系。
semi:InboundRequestDetail a owl:Class ;
    rdfs:label "入库申请明细" ;
    rdfs:comment "入库申请单中的物料/批次申请行项目（行项目，非独立事件记录）。物理映射：warehouse_input_bill_detail 表（每行对应一个物料批次的入库申请行，通过 input_bill_id 外键关联申请单主表 warehouse_input_bill）。核心字段：material_model_code/name、batch_no/unique_code（批次标识）、count（申请数量）、warehouse_id/name（目标库位）、input_bill_no（冗余单号）。" .

# 7.14a 出库申请事件定义 (OutboundRequestEvent)
semi:OutboundRequestEvent a owl:Class ;
    rdfs:subClassOf semi:WarehouseEvent ;
    rdfs:label "出库申请事件定义" ;
    rdfs:comment "定义线边仓出库申请操作的规则/类型模板。生产线/部门提出物料领料申请，经审批通过后触发 OutboundEvent 执行出库并生成 OutboundBill。执行记录层见 semi:OutboundRequest。" .

# 7.14 出库申请单 (OutboundRequest) — warehouse_output_bill
semi:OutboundRequest a owl:Class ;
    rdfs:subClassOf semi:WarehouseEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfWarehouseEvent ;
          owl:allValuesFrom semi:OutboundRequestEvent ] ;
    rdfs:label "出库申请单" ;
    semi:isAbstract "false"^^xsd:boolean ;
    rdfs:comment "出库操作的申请单据（申请层）。物理映射：warehouse_output_bill 表（每行代表一次出库申请，审批通过后生成 semi:OutboundBill 出库记录单）。核心字段：bill_no（唯一申请单号/UNI）、status（审批状态）、type（出库类型）、destination（出库目标/生产线/部门）、output_dept（申请部门）、scan_code（扫码字段）。通过 id → warehouse_output_record_bill.output_bill_id（FK）关联已生成的出库记录单。业务流程：出库申请 → 审批 → 生成 OutboundBill → 执行 OutboundEventRecord。" .

# 7.15 出库申请明细 (OutboundRequestDetail) — warehouse_output_bill_detail
# ⚠ 设计注意：OutboundRequestDetail 是 OutboundRequest 的行项目，不是独立的 WarehouseEventRecord 子类。
#   通过 containsOutboundRequestDetail（OutboundRequest→OutboundRequestDetail）建立从属关系。
semi:OutboundRequestDetail a owl:Class ;
    rdfs:label "出库申请明细" ;
    rdfs:comment "出库申请单中的物料/批次申请行项目（行项目，非独立事件记录）。物理映射：warehouse_output_bill_detail 表（每行对应一个物料批次的出库申请行，通过 output_bill_id 外键关联申请单主表 warehouse_output_bill）。核心字段：material_model_code/name、batch_no/unique_code（批次标识）、output_count（申请出库量）、require_count（申领量）、destination（出库目标）、warehouse_id/name（源库位）、output_bill_no（冗余单号）。" .

### ==========================================
### 8. WMS 对象属性 (WMS Object Properties)
### ==========================================

# 8.1 库存管理事件记录关联属性 (WarehouseEventRecord)
semi:isInstanceOfWarehouseEvent a owl:ObjectProperty ;
    rdfs:domain semi:WarehouseEventRecord ; rdfs:range semi:WarehouseEvent ;
    rdfs:label "库存管理事件执行记录" ;
    rdfs:comment "该库存管理执行记录（WarehouseEventRecord 子类实例）对应的事件类型定义（WarehouseEvent 子类），关联记录到事件规约。与 semi:isInstanceOfEvent（ProductionEventRecord→ProductionEvent）平行。各子类通过 owl:allValuesFrom 约束精化 range：InboundApprovalRecord→InboundApprovalEvent / InboundRequest→InboundRequestEvent / InboundBill→InboundEvent / OutboundRequest→OutboundRequestEvent / OutboundBill→OutboundEvent。" .

# 8.2 MaterialBatch 关联属性
semi:batchOfMaterial a owl:ObjectProperty ;
    rdfs:domain semi:MaterialBatch ; rdfs:range semi:Material ;
    rdfs:label "批次所属物料类型" ;
    rdfs:comment "物料批次实例对应的物料类型（semi:Material 子类），必填。建立批次→物料模型的归属关系，支持'某种物料有哪些批次在库'的反向查询。" .

semi:derivedFromLot a owl:ObjectProperty ;
    rdfs:domain semi:MaterialBatch ; rdfs:range semi:ProductionLot ;
    rdfs:label "源生产批次（结批溯源）" ;
    rdfs:comment "产成品批次结批时关联的源 ProductionLot（在制品批次）。仅 semi:Product 类型的 MaterialBatch 填写此属性（derivedFromLot 的 batchOfMaterial → semi:Product）；辅料/备件/原料的 MaterialBatch 此属性为空。支持从产成品批次反向追溯到生产线上的原始在制批次。" .

# 8.2 WarehouseLocation 关联属性
semi:hasInventory a owl:ObjectProperty ;
    rdfs:domain semi:WarehouseLocation ; rdfs:range semi:Inventory ;
    rdfs:label "当前库存明细" ;
    rdfs:comment "库位持有的库存明细记录集合，一个库位可关联多条 Inventory 记录（每种物料批次对应一条）。" .

semi:hasParentLocation a owl:ObjectProperty ;
    rdfs:domain semi:WarehouseLocation ; rdfs:range semi:WarehouseLocation ;
    rdfs:label "上级库位/仓库节点" ;
    rdfs:comment "通过 warehouse_model.parent_id 表达的行政或逻辑归属层级关系（自引用外键）。顶层仓库节点 parent_id=0，叶节点库位指向其所属的上级区域或仓库节点。支持任意深度的树状层级查询（如：库位 → 区域 → 仓库 → 工厂）。" .

# 8.3 Inventory 关联属性
semi:stockOfMaterial a owl:ObjectProperty ;
    rdfs:domain semi:Inventory ; rdfs:range semi:Material ;
    rdfs:label "库存物料类型" ;
    rdfs:comment "该库存明细记录对应的物料类型（反规范化冗余字段，便于按物料类型直接过滤库存，无需经由 MaterialBatch 跳转）。" .

semi:stockOfBatch a owl:ObjectProperty ;
    rdfs:domain semi:Inventory ; rdfs:range semi:MaterialBatch ;
    rdfs:label "库存批次" ;
    rdfs:comment "该库存明细对应的物料批次实例，是库存追踪的精确粒度锚点（批次粒度）。" .

# 8.4 入库记录关联属性
semi:inboundBatch a owl:ObjectProperty ;
    rdfs:domain semi:InboundEventRecord ; rdfs:range semi:MaterialBatch ;
    rdfs:label "入库物料批次" ;
    rdfs:comment "本次入库操作涉及的物料批次实例（含 hasBatchNo；单件追踪型含 hasBoxNo）。" .

semi:inboundToLocation a owl:ObjectProperty ;
    rdfs:domain semi:InboundEventRecord ; rdfs:range semi:WarehouseLocation ;
    rdfs:label "入库目标库位" ;
    rdfs:comment "本次入库操作的目标存储库位。" .

# 8.5 出库记录关联属性
semi:outboundBatch a owl:ObjectProperty ;
    rdfs:domain semi:OutboundEventRecord ; rdfs:range semi:MaterialBatch ;
    rdfs:label "出库物料批次" ;
    rdfs:comment "本次出库操作涉及的物料批次实例。" .

semi:outboundFromLocation a owl:ObjectProperty ;
    rdfs:domain semi:OutboundEventRecord ; rdfs:range semi:WarehouseLocation ;
    rdfs:label "出库源库位" ;
    rdfs:comment "本次出库操作的源存储库位。" .

# 8.5b 批次位置与库存更新关联属性
semi:storedAtLocation a owl:ObjectProperty ;
    rdfs:domain semi:MaterialBatch ; rdfs:range semi:WarehouseLocation ;
    rdfs:label "批次当前库位" ;
    rdfs:comment "物料批次实例存放在哪个库位（warehouse_inventory.warehouse_id → warehouse_model.id）。建立批次实例←→库位之间的空间位置关系，支持'某批次在哪个库位'和'某库位有哪些批次'双向查询。" .

semi:recordsBatch a owl:ObjectProperty ;
    rdfs:domain semi:OutboundEventRecord ; rdfs:range semi:MaterialBatch ;
    rdfs:label "出库明细关联物料批次" ;
    rdfs:comment "出库明细行通过 batch_no/unique_code+warehouse_id 软关联到 warehouse_inventory 批次快照行（semi:MaterialBatch）。支持出库操作←→批次实例之间的语义连接，支持批次追溯和出库历史查询。" .

semi:updatesInventory a owl:ObjectProperty ;
    rdfs:domain semi:InboundEventRecord ; rdfs:range semi:Inventory ;
    rdfs:label "入库明细更新库存快照" ;
    rdfs:comment "入库记录明细生成后同步更新 warehouse_inventory 库存快照行（semi:Inventory.quantity 字段）。物理映射：warehouse_input_record_bill_detail 通过 batch_no/unique_code+warehouse_id 定位 warehouse_inventory 行。" .

# 8.6 入库单-明细包含关系
semi:containsInboundDetail a owl:ObjectProperty ;
    rdfs:domain semi:InboundBill ; rdfs:range semi:InboundEventRecord ;
    rdfs:label "包含入库明细" ;
    rdfs:comment "入库记录单与入库明细行之间的包含关系（1:N）。物理映射：warehouse_input_record_bill.id → warehouse_input_record_bill_detail.record_bill_id（FK）。一张入库记录单包含一行或多行入库明细，每行对应一个物料/批次的入库行项目。" .

# 8.7 出库单-明细包含关系
semi:containsOutboundDetail a owl:ObjectProperty ;
    rdfs:domain semi:OutboundBill ; rdfs:range semi:OutboundEventRecord ;
    rdfs:label "包含出库明细" ;
    rdfs:comment "出库记录单与出库明细行之间的包含关系（1:N）。物理映射：warehouse_output_record_bill.id → warehouse_output_record_bill_detail.record_bill_id（FK）。一张出库记录单包含一行或多行出库明细，每行对应一个物料/批次的出库行项目。" .

# 8.8 审批记录关联属性
semi:approvalForMaterial a owl:ObjectProperty ;
    rdfs:domain semi:InboundApprovalRecord ; rdfs:range semi:Material ;
    rdfs:label "审批物料类型" ;
    rdfs:comment "本次入库审批对应的物料类型，便于按物料维度查询历史审批记录。" .

semi:triggersInbound a owl:ObjectProperty ;
    rdfs:domain semi:InboundApprovalRecord ; rdfs:range semi:InboundEventRecord ;
    rdfs:label "审批通过触发入库" ;
    rdfs:comment "审批通过(hasApprovalStatus=1)后关联触发的入库执行记录，建立'审批→入库'的操作因果链（对应 warehouse_approval_record → warehouse_input_record_bill_detail 的关联）。" .

# 8.9 入库申请单-明细包含关系
semi:containsInboundRequestDetail a owl:ObjectProperty ;
    rdfs:domain semi:InboundRequest ; rdfs:range semi:InboundRequestDetail ;
    rdfs:label "包含入库申请明细" ;
    rdfs:comment "入库申请单与入库申请明细行之间的包含关系（1:N）。物理映射：warehouse_input_bill.id → warehouse_input_bill_detail.input_bill_id（FK）。" .

# 8.10 入库申请单→入库记录单生成关系
semi:generatesInboundBill a owl:ObjectProperty ;
    rdfs:domain semi:InboundRequest ; rdfs:range semi:InboundBill ;
    rdfs:label "审批通过生成入库记录单" ;
    rdfs:comment "入库申请单审批通过后生成的入库记录单，建立'申请→记录'的因果链。物理映射：warehouse_input_bill.id → warehouse_input_record_bill.input_bill_id（FK）。" .

# 8.11 出库申请单-明细包含关系
semi:containsOutboundRequestDetail a owl:ObjectProperty ;
    rdfs:domain semi:OutboundRequest ; rdfs:range semi:OutboundRequestDetail ;
    rdfs:label "包含出库申请明细" ;
    rdfs:comment "出库申请单与出库申请明细行之间的包含关系（1:N）。物理映射：warehouse_output_bill.id → warehouse_output_bill_detail.output_bill_id（FK）。" .

# 8.12 出库申请单→出库记录单生成关系
semi:generatesOutboundBill a owl:ObjectProperty ;
    rdfs:domain semi:OutboundRequest ; rdfs:range semi:OutboundBill ;
    rdfs:label "审批通过生成出库记录单" ;
    rdfs:comment "出库申请单审批通过后生成的出库记录单，建立'申请→记录'的因果链。物理映射：warehouse_output_bill.id → warehouse_output_record_bill.output_bill_id（FK）。" .

### ==========================================
### 9. WMS 数据属性 (WMS Data Properties)
### ==========================================

# 9.1 WarehouseLocation 数据属性
semi:hasWarehouseCode a owl:DatatypeProperty ;
    rdfs:domain semi:WarehouseLocation ;
    rdfs:range xsd:string ;
    rdfs:label "仓库编码" ;
    rdfs:comment "仓库唯一业务标识码，对应 warehouse_model.code。" .

semi:hasWarehouseName a owl:DatatypeProperty ;
    rdfs:domain semi:WarehouseLocation ;
    rdfs:range xsd:string ;
    rdfs:label "仓库名称" ;
    rdfs:comment "仓库显示名称，对应 warehouse_model.name。" .

semi:hasStorageType a owl:DatatypeProperty ;
    rdfs:domain semi:WarehouseLocation ;
    rdfs:range xsd:string ;
    rdfs:label "存储类型" ;
    rdfs:comment "库位的物理环境约束分类，如：常温、冷藏、氮气柜、避光等。当前系统尚未在数据库中建立存储类型管理字段，暂无物理列映射。" .

semi:hasGeoLocation a owl:DatatypeProperty ;
    rdfs:domain semi:WarehouseLocation ;
    rdfs:range xsd:string ;
    rdfs:label "地理位置" ;
    rdfs:comment "库位在厂区或车间的物理坐标描述（如：A栋2楼东侧货架区）。当前系统无对应数据库字段，暂无物理列映射。" .

# 9.2 MaterialBatch 数据属性
semi:hasBatchNo a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialBatch ;
    rdfs:range xsd:string ;
    rdfs:label "批次号" ;
    rdfs:comment "物料批次的业务标识号。产成品：值等于源 ProductionLot 的批次编号（结批时由系统继承填入）；辅料/备件/原料：值为供应商批次号（进货时录入）。所有 MaterialBatch 实例必填。" .

semi:hasBoxNo a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialBatch ;
    rdfs:range xsd:string ;
    rdfs:label "唯一码" ;
    rdfs:comment "物料实例的物理唯一标识码，对应 warehouse_inventory.unique_code 及 bill_detail.unique_code。适用于物料模型开启了逐件唯一码管理（semi:hasUniqueCodeMgmt=true）的物料批次：产成品对应包装盒号（每箱唯一），备件对应设备序列号，等。物料模型未开启唯一码管理（如辅料/原料）时此属性为空。" .

semi:hasBatchQty a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialBatch ;
    rdfs:range xsd:decimal ;
    rdfs:label "批次数量" ;
    rdfs:comment "该物料批次的总数量（通常为入库时的初始批次量）。" .

# 9.3 Inventory 数据属性
semi:hasStockQty a owl:DatatypeProperty ;
    rdfs:domain semi:Inventory ;
    rdfs:range xsd:decimal ;
    rdfs:label "在库数量" ;
    rdfs:comment "该库存明细记录的当前在库数量（实时快照，随入/出库操作动态更新），对应 warehouse_inventory.qty 或 stock_qty 字段。" .

semi:hasStockUnit a owl:DatatypeProperty ;
    rdfs:domain semi:Inventory ;
    rdfs:range xsd:string ;
    rdfs:label "库存单位" ;
    rdfs:comment "在库数量的计量单位（如片/箱/kg/个），对应 warehouse_inventory.unit 字段。" .

# 9.4 InboundApprovalRecord 数据属性
semi:hasApprovalStatus a owl:DatatypeProperty ;
    rdfs:domain semi:InboundApprovalRecord ;
    rdfs:range xsd:string ;
    rdfs:label "审批状态" ;
    rdfs:comment "入库审批当前状态，对应 warehouse_approval_record.audit_state 字段（字符串类型）。语义枚举：单值表示当前阶段（如 '1'/'2'/'3'），逗号分隔多值（如 '1,2,3'）表示多阶段审批流的已完成节点列表。具体语义枚举见 value_mappings。" .

semi:hasApprovalResult a owl:DatatypeProperty ;
    rdfs:domain semi:InboundApprovalRecord ;
    rdfs:range xsd:string ;
    rdfs:label "审批结论/备注" ;
    rdfs:comment "审批人填写的审批结论或驳回原因文本，对应 warehouse_approval_record.remark 或 result 字段。" .

# 9.5 入出库单据公共数据属性
semi:hasBillNo a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:InboundRequest semi:InboundRequestDetail semi:InboundBill semi:InboundEventRecord
                               semi:OutboundRequest semi:OutboundRequestDetail semi:OutboundBill semi:OutboundEventRecord) ] ;
    rdfs:range xsd:string ;
    rdfs:label "单据编号" ;
    rdfs:comment "入库/出库各层单据的唯一单据号，覆盖申请单、记录单及明细三层。" .

semi:hasBillQty a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:InboundRequest semi:InboundRequestDetail semi:InboundBill semi:InboundEventRecord
                               semi:OutboundRequest semi:OutboundRequestDetail semi:OutboundBill semi:OutboundEventRecord) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "单据数量" ;
    rdfs:comment "入库或出库申请/实际执行的数量。" .

semi:hasBillTime a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:InboundRequest semi:InboundBill semi:InboundEventRecord
                               semi:OutboundRequest semi:OutboundBill semi:OutboundEventRecord) ] ;
    rdfs:range xsd:dateTime ;
    rdfs:label "单据时间" ;
    rdfs:comment "入库或出库申请/操作的时间戳，对应 create_time 字段。" .

### ==========================================
### Section 10  物料质量参数体系（规格-观测模式）
### ==========================================
# 设计模式：两层结构
#   第一层  semi:MaterialParameterSpec  — 物料参数规格模型（参数元数据 + 物料绑定 + 规格约束合一）
#   第二层  semi:InboundInspectionRecord — 物料入库检验参数记录（物料批次实例 × 参数规格 → 实测值）
#
# 说明：参数定义（Parameter Definition）与规格约束（Spec Constraint）在产品设计中共用同一张表
# property_model，不存在独立的参数定义主表。每行 property_model 同时承载：
#   ① 参数元数据（code/name/unit/value_type/group_name）
#   ② 物料关联（rel_id → material.id）
#   ③ 规格约束（value_spec JSON: {max, min, target, tolerance, decimalPlaces}）
#
# 物理映射：
#   MaterialParameterSpec  → property_model
#   InboundInspectionRecord → warehouse_batch_property_value
### ==========================================

# 10.1 物料参数规格模型 (MaterialParameterSpec)
semi:MaterialParameterSpec a owl:Class ;
    rdfs:label "物料参数规格模型" ;
    rdfs:comment "将参数定义与物料规格约束合并为一个内聚对象。每条记录同时表达三层语义：(1) 参数元数据：该参数叫什么（name）、编码（code）、单位（unit）、值类型（value_type）、所属分组（group_name）；(2) 物料绑定：该参数属于哪个（些）物料模型（rel_id → material.id, rel_name 为物料名称冗余）；(3) 规格约束：对于绑定物料，该参数的合格范围（value_spec JSON: {max, min, target, tolerance, decimalPlaces}）。通过 semi:hasParameterSpec 对象属性从 semi:Material 导航到其参数规格集合；通过 semi:hasInspectionRecord 从 semi:InboundInspectionRecord 反向引用。物理映射：property_model 表。" .

# 10.2 物料入库检验参数记录 (InboundInspectionRecord)
semi:InboundInspectionRecord a owl:Class ;
    rdfs:label "物料入库检验参数记录" ;
    rdfs:comment "具体物料批次实例（semi:MaterialBatch）在入库或来料检验采集流程中产生的实际参数测量记录。每条记录是独立的测量事实断言：'批次 B 针对参数规格 S 的实测值是 V_actual'。通过 semi:observesParameter 关联到 semi:MaterialParameterSpec（property_id FK），可直接获取该参数的规格约束（max/min/target）用于自动合格判定。当物料启用了逐件唯一码管理（hasUniqueCodeMgmt=true）时，serial_no 精确到单件，否则粒度为批次整体。物理映射：warehouse_batch_property_value（property_id × inventory_id × batch_no × serial_no × property_value）。注意：此类专用于物料仓库管理域的入库检验参数，与生产过站的量测/制程参数（semi:MeasurementPassRecord → process_measure_data）是两个独立的业务域，请勿混用。" .

### ==========================================
# 10.3 参数体系对象属性
### ==========================================

semi:hasParameterSpec a owl:ObjectProperty ;
    rdfs:domain semi:Material ; rdfs:range semi:MaterialParameterSpec ;
    rdfs:label "物料参数规格集" ;
    rdfs:comment "物料模型拥有的参数规格模型集合（1:N）。physical join: material.id = property_model.rel_id（rel_id 为 text 类型，存储物料 ID）。" .

semi:hasInspectionRecord a owl:ObjectProperty ;
    rdfs:domain semi:MaterialBatch ; rdfs:range semi:InboundInspectionRecord ;
    rdfs:label "批次入库检验参数记录集" ;
    rdfs:comment "物料批次实例在线边仓入库检验流程中产生的实测参数记录集合（1:N）。physical: warehouse_batch_property_value.inventory_id → warehouse_inventory.id（MaterialBatch）。" .

semi:observesParameter a owl:ObjectProperty ;
    rdfs:domain semi:InboundInspectionRecord ; rdfs:range semi:MaterialParameterSpec ;
    rdfs:label "关联的参数规格模型" ;
    rdfs:comment "该条实测记录所对应的参数规格模型，同时携带参数元数据和该物料的规格约束（合格上下限）。physical: warehouse_batch_property_value.property_id → property_model.id。" .

### ==========================================
# 10.4 参数体系数据属性
### ==========================================

# MaterialParameterSpec 数据属性（参数元数据 + 规格约束）
semi:hasParameterCode a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialParameterSpec ;
    rdfs:range xsd:string ;
    rdfs:label "参数编码" ;
    rdfs:comment "参数的唯一业务标识码。物理：property_model.code。" .

semi:hasParameterName a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialParameterSpec ;
    rdfs:range xsd:string ;
    rdfs:label "参数名称" ;
    rdfs:comment "参数的业务显示名称（如：电阻率、直径、TTV、线径）。物理：property_model.name。" .

semi:hasParameterUnit a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialParameterSpec ;
    rdfs:range xsd:string ;
    rdfs:label "参数单位" ;
    rdfs:comment "参数的物理量纲单位（如：Ω·cm、mm、μm）。物理：property_model.unit。" .

semi:hasParameterValueType a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialParameterSpec ;
    rdfs:range xsd:string ;
    rdfs:label "参数值类型" ;
    rdfs:comment "参数的数据类型（varchar/float/int/timestamp 等），用于指导前端采集控件和值合法性校验。物理：property_model.value_type。" .

semi:hasParameterCategory a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialParameterSpec ;
    rdfs:range xsd:string ;
    rdfs:label "参数分组" ;
    rdfs:comment "参数所属的业务分组名称，用于前端按组展示和按类过滤检索。物理：property_model.group_name。" .

semi:hasTargetValue a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialParameterSpec ;
    rdfs:range xsd:string ;
    rdfs:label "规格目标值" ;
    rdfs:comment "该参数的标准目标值（nominal value）。物理：property_model.value_spec->>'$.target'。" .

semi:hasUpperLimit a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialParameterSpec ;
    rdfs:range xsd:string ;
    rdfs:label "规格上限" ;
    rdfs:comment "该参数合格判定的上限阈值（USL）。物理：property_model.value_spec->>'$.max'。" .

semi:hasLowerLimit a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialParameterSpec ;
    rdfs:range xsd:string ;
    rdfs:label "规格下限" ;
    rdfs:comment "该参数合格判定的下限阈值（LSL）。物理：property_model.value_spec->>'$.min'。" .

semi:hasTolerance a owl:DatatypeProperty ;
    rdfs:domain semi:MaterialParameterSpec ;
    rdfs:range xsd:string ;
    rdfs:label "允差" ;
    rdfs:comment "以目标值为基准的对称允差范围（target ± tolerance）。物理：property_model.value_spec->>'$.tolerance'。" .

# InboundInspectionRecord 数据属性
semi:hasActualValue a owl:DatatypeProperty ;
    rdfs:domain semi:InboundInspectionRecord ;
    rdfs:range xsd:string ;
    rdfs:label "实测值" ;
    rdfs:comment "采集到的实际参数测量值（以 xsd:string 兼容数值和文本枚举两种值类型）。物理：warehouse_batch_property_value.property_value。" .

semi:hasRecordSerialNo a owl:DatatypeProperty ;
    rdfs:domain semi:InboundInspectionRecord ;
    rdfs:range xsd:string ;
    rdfs:label "记录件号" ;
    rdfs:comment "逐件测量时关联到的单件唯一码（对应 MaterialBatch.hasBoxNo）。当物料启用了 hasUniqueCodeMgmt=true 时填写，表示该测量值属于批次中的某一具体单件；批次整体测量时为空。物理：warehouse_batch_property_value.serial_no。" .

# ============================================================
# Section 11: 制程/量测参数体系
# ProcessParamGroup（制程参数组）聚合工艺加工过站时采集的设备制程参数；
# MeasurementParamGroup（量测参数组）聚合量测过站时采集的产品质量参数；
# ProcessParam（制程参数定义）是单个制程参数的元数据（→ param_model WHERE param_cat='工艺参数'）；
# MeasurementParam（量测参数定义）是单个量测参数的元数据（→ param_model WHERE param_cat='量测参数'）；
# 两组参数体系与 Section 10 的 MaterialParameterSpec（物料规格属性）语义独立，
# 可通过 paramModelId 建立跨制造-质量维度的分析路径。
# ============================================================

# 11.1 新增类

semi:ProcessParamGroup a owl:Class ;
    rdfs:label "制程参数组" ;
    rdfs:comment "制程参数采集分组，聚合设备加工过站时需要采集的工艺制程参数（如温度、压力、时间），用于过程监控和 SPC 分析。物理表：param_group WHERE param_group_cat='process'。由 semi:usesProcessParamGroup 从工序站点引用（通用制程采集可行域），由 semi:selectedProcessParamGroup 从 ProcessConstraint 引用（产品专属制程卡控配置，1:1选定）。通过 semi:containsProcessParam 聚合多个 semi:ProcessParam 实例。" .

semi:MeasurementParamGroup a owl:Class ;
    rdfs:label "量测参数组" ;
    rdfs:comment "量测参数采集分组，聚合量测过站时需要采集的产品阶段性质量参数（如膜厚、线宽、TTV），用于产品合格判定和工艺分析。物理表：param_group WHERE param_group_cat='measure'。由 semi:usesMeasurementParamGroup 从工序站点引用（通用量测采集可行域），由 semi:selectedMeasurementParamGroup 从 ProcessConstraint 引用（产品专属量测配置，1:1选定）。通过 semi:containsMeasurementParam 聚合多个 semi:MeasurementParam 实例。" .

semi:ProcessParam a owl:Class ;
    rdfs:label "制程参数定义" ;
    rdfs:comment "单个制程参数的元数据定义，包含参数名称、编号、单位等，归属于 semi:ProcessParamGroup。物理表：param_model WHERE param_cat='工艺参数'。param_group 字段（FK → param_group.id）指向所属的制程参数组。由 semi:ProcessParamSpec（产品专属卡控规格实例）通过 semi:constrainsProcessParam 引用，附加该产品在该工序的专属卡控值（target/maxValue/minValue/tolerance/unit）。与 semi:MaterialParameterSpec 独立：前者为制造过程参数，后者为物料交付规格。" .

semi:MeasurementParam a owl:Class ;
    rdfs:label "量测参数定义" ;
    rdfs:comment "单个量测参数的元数据定义，包含参数名称、编号、单位等，归属于 semi:MeasurementParamGroup。物理表：param_model WHERE param_cat='量测参数'。param_group 字段（FK → param_group.id）指向所属的量测参数组。由 semi:MeasurementParamSpec（产品专属合格界限实例）通过 semi:constrainsMeasurementParam 引用，附加该产品专属合格界限及 shipmentDecision（出货判定标志）、isSPCTarget（SPC监控标志）。" .

semi:ProcessParamSpec a owl:Class ;
    rdfs:label "制程参数卡控规格" ;
    rdfs:comment "某产品模型在特定工序对一个制程参数的专属卡控规格实例，内聚参数引用与产品专属上下限值。无独立物理表，数据来源：product_model.main_route 的 $.processes[*].processParamList[*]（EmbeddedJSON，每个数组元素对应一个 ProcessParamSpec 实例）。每个实例通过 semi:constrainsProcessParam 指向具体 semi:ProcessParam 参数定义，并携带该产品在该工序的专属卡控规格值（target/maxValue/minValue/tolerance/unit/samplingRule/collectionMethod）。" .

semi:MeasurementParamSpec a owl:Class ;
    rdfs:label "量测参数卡控规格" ;
    rdfs:comment "某产品模型在特定工序对一个量测参数的专属合格界限规格实例，内聚参数引用、合格界限值及出货/SPC标志。无独立物理表，数据来源：product_model.main_route 的 $.processes[*].measurementParamList[*]（EmbeddedJSON，每个数组元素对应一个 MeasurementParamSpec 实例）。每个实例通过 semi:constrainsMeasurementParam 指向具体 semi:MeasurementParam 参数定义，并携带 target/maxValue/minValue/tolerance/unit/samplingRule/collectionMethod/shipmentDecision/isSPCTarget 等属性。若 isSPCTarget=true，则该量测参数同时出现在 spcParamList（SPC 监控子集）中。" .

# 11.2 对象属性 — 站点级参数组关联（通用能力约束）

semi:usesProcessParamGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:ProcessParamGroup ;
    rdfs:label "工序绑定制程参数组" ;
    rdfs:comment "工序站点（ProcessStation）引用制程参数组（semi:ProcessParamGroup），定义该站点在加工过站时需要采集的设备制程参数范围（通用能力约束）。物理：matrix_routerx_config_process.process_data_group_list（JSON 数组，存储 param_group.id 列表）→ param_group.id WHERE param_group_cat='process'。" .

semi:usesMeasurementParamGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessStation ; rdfs:range semi:MeasurementParamGroup ;
    rdfs:label "工序绑定量测参数组" ;
    rdfs:comment "工序站点（ProcessStation）引用量测参数组（semi:MeasurementParamGroup），定义该站点在量测过站时需要采集的产品质量参数范围（通用能力约束）。物理：matrix_routerx_config_process.measurement_data_group_list（JSON 数组，存储 param_group.id 列表）→ param_group.id WHERE param_group_cat='measure'。" .

semi:containsProcessParam a owl:ObjectProperty ;
    rdfs:domain semi:ProcessParamGroup ; rdfs:range semi:ProcessParam ;
    rdfs:label "制程参数组包含制程参数" ;
    rdfs:comment "制程参数组（ProcessParamGroup）聚合多个制程参数定义（ProcessParam）。物理层通过 param_group.param_models（JSON，格式：{\"id\": \"5,6\"}，逗号分隔的 param_model.id）引用 param_model WHERE param_cat='工艺参数'。JOIN 写法：WHERE FIND_IN_SET(pm.id, JSON_UNQUOTE(JSON_EXTRACT(pg.param_models, '$.id')))。" .

semi:containsMeasurementParam a owl:ObjectProperty ;
    rdfs:domain semi:MeasurementParamGroup ; rdfs:range semi:MeasurementParam ;
    rdfs:label "量测参数组包含量测参数" ;
    rdfs:comment "量测参数组（MeasurementParamGroup）聚合多个量测参数定义（MeasurementParam）。物理层通过 param_group.param_models（JSON，格式：{\"id\": \"5,6\"}，逗号分隔的 param_model.id）引用 param_model WHERE param_cat='量测参数'。JOIN 写法：WHERE FIND_IN_SET(pm.id, JSON_UNQUOTE(JSON_EXTRACT(pg.param_models, '$.id')))。" .

# 11.3 对象属性 — 产品层参数卡控关联（ProcessConstraint 专属）

semi:hasSubRoute a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:Route ;
    rdfs:label "工序挂载子路径" ;
    rdfs:comment "某工序约束节点（ProcessConstraint）在该站点可触发的子工艺路径（抽检/分支路径）。物理：product_model.main_route 的 $.processes[*].subRoute[]（EmbeddedJSON 数组，每项含 id→matrix_routerx_config_route.id、routeName、routeType=3(SPOT_CHECK)、samplingRule、processes[] 子站点约束列表）。子路径是可选配置（0:N），代表产品在该主工序站点根据抽检规则触发的额外检测分支，如表金属检测路径、轮廓仪抽样路径。子路径本身也是完整的 Route 实体，其 processes[] 内嵌与主路径相同结构的 ProcessConstraint 节点。" .

semi:selectedProcessParamGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:ProcessParamGroup ;
    rdfs:label "产品工序选定制程参数组" ;
    rdfs:comment "某产品模型在特定工序选择的制程参数组（1:1，从站点通用能力域中选定唯一一组）。物理：product_model.main_route 的 $.processes[*].processParamGroupId → param_group.id WHERE param_group_cat='process'。代表该产品在该工序从哪个制程参数组中选取参数进行卡控（组的选择是1:1的，参数的选取是1:N的，由 hasProcessParamSpec 承载）。" .

semi:selectedMeasurementParamGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:MeasurementParamGroup ;
    rdfs:label "产品工序选定量测参数组" ;
    rdfs:comment "某产品模型在特定工序选择的量测参数组（1:1，从站点通用能力域中选定唯一一组）。物理：product_model.main_route 的 $.processes[*].measurementParamGroupId → param_group.id WHERE param_group_cat='measure'。代表该产品在该工序从哪个量测参数组中选取参数配置合格界限。" .

semi:hasProcessParamSpec a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:ProcessParamSpec ;
    rdfs:label "工序制程参数卡控规格" ;
    rdfs:comment "ProcessConstraint 持有若干制程参数卡控规格实例（1:N）。物理：product_model.main_route 的 $.processes[*].processParamList[]（EmbeddedJSON 数组，每个数组元素对应一个 ProcessParamSpec 实例）。" .

semi:hasMeasurementParamSpec a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:MeasurementParamSpec ;
    rdfs:label "工序量测参数卡控规格" ;
    rdfs:comment "ProcessConstraint 持有若干量测参数卡控规格实例（1:N）。物理：product_model.main_route 的 $.processes[*].measurementParamList[]（EmbeddedJSON 数组）。" .

semi:constrainsProcessParam a owl:ObjectProperty ;
    rdfs:domain semi:ProcessParamSpec ; rdfs:range semi:ProcessParam ;
    rdfs:label "卡控对应制程参数" ;
    rdfs:comment "ProcessParamSpec 指向其卡控的具体制程参数定义实体。物理：processParamList[*].paramModelId → param_model.id WHERE param_cat='工艺参数'。" .

semi:constrainsMeasurementParam a owl:ObjectProperty ;
    rdfs:domain semi:MeasurementParamSpec ; rdfs:range semi:MeasurementParam ;
    rdfs:label "卡控对应量测参数" ;
    rdfs:comment "MeasurementParamSpec 指向其卡控的具体量测参数定义实体。物理：measurementParamList[*].paramModelId → param_model.id WHERE param_cat='量测参数'。" .

semi:specifiesProductEqpGroup a owl:ObjectProperty ;
    rdfs:domain semi:ProcessConstraint ; rdfs:range semi:EquipmentGroup ;
    rdfs:label "产品工序专属指定设备组" ;
    rdfs:comment "某产品模型在特定工序专属指定必须使用的设备组（区别于 usesEquipmentGroup 所定义的站点级通用可行域）。典型场景：站点通用能力允许 10 台设备，但某特殊产品因工艺敏感性必须限定在指定的若干台上加工。物理：product_model.main_route 的 $.processes[*].productEqpGroupList（EmbeddedJSON，存储 equipment_group 相关标识）。" .

# 11.4 数据属性 — ProcessParamGroup / MeasurementParamGroup（共用属性）

semi:hasParamGroupName a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParamGroup semi:MeasurementParamGroup) ] ;
    rdfs:range xsd:string ;
    rdfs:label "参数组名称" ;
    rdfs:comment "参数组的业务显示名称。物理：param_group.param_group_name。" .

semi:hasParamGroupCat a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParamGroup semi:MeasurementParamGroup) ] ;
    rdfs:range xsd:string ;
    rdfs:label "参数组类别" ;
    rdfs:comment "'process'（制程参数组）或 'measure'（量测参数组），区分两类参数组。物理：param_group.param_group_cat。" .

semi:hasParamGroupDesc a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParamGroup semi:MeasurementParamGroup) ] ;
    rdfs:range xsd:string ;
    rdfs:label "参数组描述" ;
    rdfs:comment "参数组的业务说明文本。物理：param_group.param_group_desc。" .

# 11.5 数据属性 — ProcessParam / MeasurementParam（共用属性，均映射 param_model）

semi:hasParamName a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParam semi:MeasurementParam) ] ;
    rdfs:range xsd:string ;
    rdfs:label "参数名称" ;
    rdfs:comment "参数的业务显示名称（如：温度、压力、膜厚）。物理：param_model.param_name。" .

semi:hasParamCode a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParam semi:MeasurementParam) ] ;
    rdfs:range xsd:string ;
    rdfs:label "参数编号" ;
    rdfs:comment "参数的系统编号（业务标识码）。物理：param_model.param_id。" .

semi:hasParamCat a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParam semi:MeasurementParam) ] ;
    rdfs:range xsd:string ;
    rdfs:label "参数类别" ;
    rdfs:comment "参数的业务分类：ProcessParam 对应'工艺参数'，MeasurementParam 对应'量测参数'。物理：param_model.param_cat（用于 filter_condition 区分两个子类）。" .

semi:hasParamUnit a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParam semi:MeasurementParam) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "参数单位（枚举ID）" ;
    rdfs:comment "参数的物理量纲单位，以整数枚举 ID 存储（需查 sys_paraminfo_module_type 等字典表解码）。物理：param_model.unit（int 类型）。" .

# 11.6 数据属性 — ProcessParamSpec / MeasurementParamSpec（产品专属卡控规格值）
# 物理来源：product_model.main_route 的 $.processes[*].processParamList[*] 或 measurementParamList[*] 各字段

semi:hasSpecTargetValue a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParamSpec semi:MeasurementParamSpec) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "规格目标值" ;
    rdfs:comment "参数的目标控制值（中心值/标称值）。物理：processParamList[*].target 或 measurementParamList[*].target。部分参数可为空（未配置 target 时）。" .

semi:hasSpecMaxValue a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParamSpec semi:MeasurementParamSpec) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "规格上限值" ;
    rdfs:comment "参数的卡控上限（超出则判 NG）。物理：processParamList[*].maxValue 或 measurementParamList[*].maxValue。" .

semi:hasSpecMinValue a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParamSpec semi:MeasurementParamSpec) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "规格下限值" ;
    rdfs:comment "参数的卡控下限（低于则判 NG）。物理：processParamList[*].minValue 或 measurementParamList[*].minValue。" .

semi:hasSpecTolerance a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParamSpec semi:MeasurementParamSpec) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "规格公差" ;
    rdfs:comment "参数的允许偏差量（maxValue - target 或 target - minValue）。物理：processParamList[*].tolerance 或 measurementParamList[*].tolerance。" .

semi:hasSpecUnit a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParamSpec semi:MeasurementParamSpec) ] ;
    rdfs:range xsd:string ;
    rdfs:label "规格单位（字符串）" ;
    rdfs:comment "该规格实例的物理单位，字符串类型（如 '℃'、'μm'、'mm'）。区别于 semi:hasParamUnit（param_model.unit 为整数枚举ID）。物理：processParamList[*].unit 或 measurementParamList[*].unit。" .

semi:hasCollectionMethod a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParamSpec semi:MeasurementParamSpec) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "采集方式" ;
    rdfs:comment "参数数据的采集方式枚举（0=手动录入，1=设备自动采集）。物理：processParamList[*].collectionMethod 或 measurementParamList[*].collectionMethod。" .

semi:hasSpecSamplingRule a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (semi:ProcessParamSpec semi:MeasurementParamSpec) ] ;
    rdfs:range xsd:string ;
    rdfs:label "抽检规则" ;
    rdfs:comment "该参数的抽检策略（字符串枚举，如 '1'=全检、'2'=按频率抽检、'3'=按数量抽检等）。物理：processParamList[*].samplingRule 或 measurementParamList[*].samplingRule。" .

semi:hasShipmentDecision a owl:DatatypeProperty ;
    rdfs:domain semi:MeasurementParamSpec ;
    rdfs:range xsd:boolean ;
    rdfs:label "出货判定标志" ;
    rdfs:comment "是否将该量测参数的结果用作出货判定条件（true=出货判定项）。物理：measurementParamList[*].shipmentDecision（0=否，1=是，映射为 boolean）。仅适用于 MeasurementParamSpec。" .

semi:isSPCTarget a owl:DatatypeProperty ;
    rdfs:domain semi:MeasurementParamSpec ;
    rdfs:range xsd:boolean ;
    rdfs:label "SPC监控标志" ;
    rdfs:comment "该量测参数是否被纳入 SPC（Statistical Process Control）监控子集（true=SPC监控项）。物理判断：若 measurementParamList[*].paramModelId 出现在同一工序节点的 spcParamList[*].paramModelId 中，则 isSPCTarget=true。无直接列存储，由 spcParamList 与 measurementParamList 的 paramModelId 交集推导。仅适用于 MeasurementParamSpec。" .

# 11.7 数据属性 — Route（工艺路径类型）

semi:hasRouteType a owl:DatatypeProperty ;
    rdfs:domain semi:Route ;
    rdfs:range xsd:integer ;
    rdfs:label "路径类型" ;
    rdfs:comment "工艺路径的分类枚举：0=MAIN（主路径，对应 product_model.main_route 的根节点）；3=SPOT_CHECK（抽检/分支子路径，对应 processes[*].subRoute[*] 节点，如表金属检测路径、轮廓仪抽样路径）。物理：matrix_routerx_config_route.route_type（主路径）或 subRoute[*].type.key（子路径 EmbeddedJSON）。" .

semi:hasRouteSamplingRule a owl:DatatypeProperty ;
    rdfs:domain semi:Route ;
    rdfs:range xsd:string ;
    rdfs:label "路径抽检规则" ;
    rdfs:comment "子路径（SPOT_CHECK）的触发抽检规则。物理：subRoute[*].samplingRule（EmbeddedJSON 字段，仅 routeType=3 的子路径有此字段）。" .

