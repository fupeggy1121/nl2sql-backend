semi:hasOutTime a owl:DatatypeProperty ;
    rdfs:domain semi:StationPassRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "出站时间" ;
    rdfs:comment "子批次完成工序离开加工区的时间戳，对应 out_time / exit_time 字段。" .

semi:hasLoadTime a owl:DatatypeProperty ;
    rdfs:domain semi:StationPassRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "上料时间" ;
    rdfs:comment "操作员完成上料（将载具放置到设备进料口）的时间戳。" .

semi:hasUnloadTime a owl:DatatypeProperty ;
    rdfs:domain semi:StationPassRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "下料时间" ;
    rdfs:comment "操作员完成下料（从设备取出载具）的时间戳。" .

semi:hasEquipmentSnapshot a owl:DatatypeProperty ;
    rdfs:domain semi:StationPassRecord ;
    rdfs:range xsd:string ;
    rdfs:label "设备状态快照" ;
    rdfs:comment "过站时刻的设备关键状态快照（JSON），作为因果追溯的设备侧证据链节点，可进一步关联设备履历表展开细节。" .

# 3.14.2 加工过站记录专属属性 (ProcessPassRecord)
semi:hasProcessParamRecord a owl:DatatypeProperty ;
    rdfs:domain semi:ProcessPassRecord ;
    rdfs:range xsd:string ;
    rdfs:label "加工制程参数记录" ;
    rdfs:comment "加工设备采集的关键制程参数快照（JSON），可能是单片逐片数据或批次聚合值（均值/极值等）。是分析工艺漂移和设备异常的核心数据源。" .

# 3.14.3 量测过站记录专属属性 (MeasurementPassRecord)
semi:hasMeasurementResult a owl:DatatypeProperty ;
    rdfs:domain semi:MeasurementPassRecord ;
    rdfs:range xsd:string ;
    rdfs:label "量测结果数据" ;
    rdfs:comment "量测工序采集的质量参数（JSON），含逐片数据及统计聚合值（最大/最小/平均/标准差），表征当前阶段批次整体质量属性。" .

semi:hasSamplingRule a owl:DatatypeProperty ;
    rdfs:domain semi:MeasurementPassRecord ;
    rdfs:range xsd:string ;
    rdfs:label "抽检规则" ;
    rdfs:comment "该量测站点应用的抽检规则标识（如'每批抽n片'），决定量测结果对批次的代表性置信度。" .

# 3.14.4 生产事件记录属性 (ProductionEventRecord)
semi:hasEventType a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "谱系事件类型" ;
    rdfs:comment "批次谱系变更事件类型（整数枚举）：1=拆批、2=并批、12=返工、14=拆父批、16=攒批。对应 matrix_routerx_operation_lot_batch_resume_log.operation_type。完整23种类型枚举见 semi:LotOperationType。" .

semi:hasEventStartTime a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "事件开始时间" ;
    rdfs:comment "生产事件的开始时间戳，对应 matrix_routerx_operation_lot_batch_resume_log.gmt_create。" .

semi:hasEventEndTime a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "事件结束时间" ;
    rdfs:comment "生产事件的结束时间戳。" .

semi:hasOperatorId a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "操作人ID" ;
    rdfs:comment "执行该生产事件的操作人标识，对应 matrix_routerx_operation_lot_batch_resume_log.operator_id。" .

semi:hasLotStatusBefore a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "事件前批次状态" ;
    rdfs:comment "事件执行前的批次状态快照，对应 matrix_routerx_operation_lot_batch_resume_log_detail.before_state。" .

semi:hasLotStatusAfter a owl:DatatypeProperty ;
    rdfs:domain semi:ProductionEventRecord ;
    rdfs:range xsd:string ;
    rdfs:label "事件后批次状态" ;
    rdfs:comment "事件执行后的批次状态快照，对应 matrix_routerx_operation_lot_batch_resume_log_detail.after_state。" .

### ==========================================
### 4. 事件逻辑规约注解属性 (Event Logic Annotation Properties)
### ==========================================
### 设计说明：
###   下列 6 个注解属性构成事件类（XxxEvent）的五维度逻辑规约框架，
###   挂载于具体事件类的类定义上（如 semi:SplitEvent）。
###   语义引擎（Semantic Resolver）扫描 XxxEventRecord 时，
###   追溯 isInstanceOfEvent 所指向的事件类，读取各维度规约，
###   生成物理 SQL/API 调用序列后执行。
###
###   维度一  preCondition        — 准入门禁（验证前置状态）
###   维度二  inputSchema         — 参数规约（外部输入参数集）
###   维度三  transformationLogic — 状态算子（状态跳转执行逻辑）
###   维度四  apiBinding          — 服务绑定（物理 MES 接口）
###   维度五  postCondition       — 约束后验（结果校验）
###   辅助    stateTransitionFunction — 精简的本体对象状态更新指令模板
### ==========================================

semi:preCondition a owl:AnnotationProperty ;
    rdfs:label "准入规则" ;
    rdfs:comment "维度一：事件执行的前置门禁条件，引擎执行前须校验通过。不满足则向用户返回拦截原因，不进入执行流程。格式：领域对象.属性 运算符 期望值。" .

semi:inputSchema a owl:AnnotationProperty ;
    rdfs:label "参数规约" ;
    rdfs:comment "维度二：驱动本事件所需的最小外部输入参数集（JSON Schema 描述）。仅包含业务必要的外部输入；系统自动生成的值（如新批次ID）作为 transformationLogic 的产出变量（$var），不在此列。" .

semi:transformationLogic a owl:AnnotationProperty ;
    rdfs:label "状态算子" ;
    rdfs:comment "维度三：事件触发后的状态跳转逻辑，供语义引擎解析并转化为物理 SQL/API 调用。伪代码约定：LET $var = CALL apiBinding 捕获调用返回值；CREATE/SET/UPDATE 操作本体对象；?param 引用 inputSchema 中的入参。" .

semi:apiBinding a owl:AnnotationProperty ;
    rdfs:label "服务绑定" ;
    rdfs:comment "维度四：本事件绑定的 MES 外部服务接口标识（服务名.方法名）。引擎执行 transformationLogic 中 CALL 指令时调用，返回值（如 generated_lot_id）捕获到对应 $var 变量。" .

semi:postCondition a owl:AnnotationProperty ;
    rdfs:label "约束后验" ;
    rdfs:comment "维度五：事件执行完成后的结果验证条件，确认状态已正确变更。引擎在 API 调用和状态同步完成后执行，不满足则触发回滚或告警。" .

semi:stateTransitionFunction a owl:AnnotationProperty ;
    rdfs:label "状态转换函数" ;
    rdfs:comment "辅助维度：本体对象层面的状态更新指令模板（精简描述），供语义引擎转化为物理 UPDATE/INSERT。格式：UPDATE Target(类名) SET 属性 = EventRecord.属性 [WHERE 条件]。与 transformationLogic 互补，后者描述完整执行序列，本属性聚焦于本体图谱的状态向量变更。" .

### ==========================================
### 5. 生产事件具体化类群 (Specific Production Event Classes)
### ==========================================
### 建模规范：
###   每种操作类型由两个相互绑定的类共同描述：
###   ① XxxEvent    — rdfs:subClassOf semi:ProductionEvent
###       挂载 5 维度逻辑规约注解，是操作的静态规则/类型模板。
###   ② XxxEventRecord — rdfs:subClassOf semi:ProductionEventRecord
###       存储一次具体执行的实例数据；通过
###       [ owl:Restriction; owl:onProperty isInstanceOfEvent;
###         owl:allValuesFrom XxxEvent ]
###       将记录锁定到对应规则定义，使引擎可从记录追溯到完整规约。
### ==========================================

# 5.1 拆批事件定义 (SplitEvent)
semi:SplitEvent a owl:Class ;
    rdfs:subClassOf semi:ProductionEvent ;
    rdfs:label "拆批事件定义" ;
    rdfs:comment "定义拆批（Split）操作的规则/类型模板。将源批次中的指定晶圆析出，由 MES 系统自动生成新批次 ID。拆批不涉及物理设备加工，仅执行批次谱系切割与 Wafer 归属迁移。执行记录层见 semi:SplitEventRecord。" ;
    # 维度一：准入规则 — 源批次须处于待加工状态且晶圆数量可拆
    semi:preCondition "ParentLot.status == 0 && ParentLot.waferCount > 1" ;
    # 注：status=0 对应 matrix_routerx_operation_lot.status=0（待加工/待进站），整数枚举。
    # 维度二：参数规约 — 仅需外部传入源批次ID与待拆晶圆列表；新批次ID由系统生成
    semi:inputSchema "{ parentLotId: string, splitWaferList: string[] }" ;
    # 维度三：状态算子 — 调用 API 取得新批次ID，创建新批次+初始Sublot、迁移Wafer归属、建立父子谱系
    semi:transformationLogic "LET $newId = CALL apiBinding; CREATE semi:ProductionLot($newId); LET $newSublotId = $newId.initialSublot; CREATE semi:Sublot($newSublotId); SET $newId.containsSublot = $newSublotId; SET $newId.hasParentLot = ?parentLotId; UPDATE semi:Wafer SET belongsToLot = $newId, belongsToSublot = $newSublotId WHERE id IN ?splitWaferList" ;
    # 维度四：服务绑定 — 调用 MES 核心服务拆批接口，接口返回值含系统生成的新批次ID
    semi:apiBinding "MES_CORE_SERVICE.executeSplitAction" ;
    # 维度五：约束后验 — 确认新批次已实例化，源批次数量已正确扣减
    semi:postCondition "checkExists($newId) && ParentLot.qty == (prevQty - splitCount)" ;
    # 辅助：状态转换函数 — 被迁移晶圆同时更新 Lot 和 Sublot 两个归属指针
    semi:stateTransitionFunction "UPDATE Target(Wafer) SET belongsToLot = EventRecord.producesLot, belongsToSublot = EventRecord.producesSublot WHERE Wafer.id IN EventRecord.affectsWafer" .

# 5.2 拆批执行记录 (SplitEventRecord)
semi:SplitEventRecord a owl:Class ;
    rdfs:subClassOf semi:ProductionEventRecord ,
        [ a owl:Restriction ;
          owl:onProperty semi:isInstanceOfEvent ;
          owl:allValuesFrom semi:SplitEvent ] ;
    rdfs:label "拆批记录" ;
    rdfs:comment "拆批操作的具体执行记录实例。核心关联：(1) isInstanceOfEvent → semi:SplitEvent，将记录锁定到拆批规则定义，引擎据此追溯 5 维规约生成物理执行序列；(2) actsOnLot → 源批次（被拆的父批次）；(3) producesLot → MES 系统自动生成的新 ProductionLot（子批次），是拆批操作的核心产出；(4) producesSublot → 与 producesLot 同步创建的初始 Sublot，被迁移晶圆的 belongsToSublot 指向此 Sublot，保证 Wafer→Sublot→atStation 路径仍可导航；(5) affectsWafer → 被迁移的具体晶圆实例列表，支持逐片血缘追溯。物理层三联写入：matrix_routerx_operation_lot_batch_resume_log（主事件记录，operation_type=1）+ matrix_routerx_operation_lot_batch_resume_log_detail（拆批前后批次状态快照）+ matrix_routerx_operation_lot_batch_resume_wafer_detail_log（逐片Wafer迁移明细）。" .

### ==========================================
### 6. 操作类型枚举 (LotOperationType Enumeration)
### ==========================================
### 对应物理层 matrix_routerx_operation_lot_batch_resume_log.operation_type 字段整数枚举。
### 完整枚举见 mapping_prod.json value_mappings.semi:LotOperationType。

semi:hasState a owl:DatatypeProperty ;
    rdfs:domain semi:LotOperationType ;
    rdfs:range xsd:integer ;
    rdfs:label "整数枚举值" ;
    rdfs:comment "LotOperationType 实例对应的整数编码，与数据库 operation_type 字段值一一对应。" .

semi:LotOperationType a owl:Class ;
    rdfs:label "批次操作类型" ;
    rdfs:comment "批次操作记录类型枚举（整数编码）。对应 matrix_routerx_operation_lot_batch_resume_log.operation_type 字段。取值范围 1-23，完整高分辨率映射见 mapping_prod.json semi:LotOperationType。谱系变更类（is_genealogy_event=true）：1=拆批、2=并批、12=返工、14=拆父批、16=攒批。过站动作类：8=进站、9=出站、10=退回、11=跳站、20=实验跳站。批次生命周期类：19=开批、22=取消开批、23=批次完结。" .

semi:SplitOp          a semi:LotOperationType ; rdfs:label "1-拆批操作"          ; semi:hasState 1 .
semi:MergeLotsOp      a semi:LotOperationType ; rdfs:label "2-并批操作"          ; semi:hasState 2 .
semi:CarrierTransOp   a semi:LotOperationType ; rdfs:label "3-倒篮操作"          ; semi:hasState 3 .
semi:HoldOp           a semi:LotOperationType ; rdfs:label "4-批次扣留"          ; semi:hasState 4 .
semi:ReleaseOp        a semi:LotOperationType ; rdfs:label "5-批次释放"          ; semi:hasState 5 .
semi:NGRecordOp       a semi:LotOperationType ; rdfs:label "6-不良录入"          ; semi:hasState 6 .
semi:CancelNGOp       a semi:LotOperationType ; rdfs:label "7-取消不良"          ; semi:hasState 7 .
semi:CheckInOp        a semi:LotOperationType ; rdfs:label "8-批次进站"          ; semi:hasState 8 .
semi:CheckOutOp       a semi:LotOperationType ; rdfs:label "9-批次出站"          ; semi:hasState 9 .
semi:ReturnOp         a semi:LotOperationType ; rdfs:label "10-批次退回"         ; semi:hasState 10 .
semi:SkipOp           a semi:LotOperationType ; rdfs:label "11-批次跳站"         ; semi:hasState 11 .
semi:ReworkOp         a semi:LotOperationType ; rdfs:label "12-返工操作"         ; semi:hasState 12 .
semi:CancelReworkOp   a semi:LotOperationType ; rdfs:label "13-取消返工"         ; semi:hasState 13 .
semi:SplitParentOp    a semi:LotOperationType ; rdfs:label "14-拆父批操作"       ; semi:hasState 14 .
semi:SwitchSubRouteOp a semi:LotOperationType ; rdfs:label "15-切换子路径"       ; semi:hasState 15 .
semi:AccumulateOp     a semi:LotOperationType ; rdfs:label "16-攒批操作"         ; semi:hasState 16 .
semi:CarrierChangeOp  a semi:LotOperationType ; rdfs:label "17-片篮更换"         ; semi:hasState 17 .
semi:CreateLocalLotOp a semi:LotOperationType ; rdfs:label "18-本地批次创建"     ; semi:hasState 18 .
semi:OpenLotOp        a semi:LotOperationType ; rdfs:label "19-开批"             ; semi:hasState 19 .
semi:ExpSkipOp        a semi:LotOperationType ; rdfs:label "20-实验跳站"         ; semi:hasState 20 .
semi:CancelLocalLotOp a semi:LotOperationType ; rdfs:label "21-取消本地批次创建" ; semi:hasState 21 .
semi:CancelOpenLotOp  a semi:LotOperationType ; rdfs:label "22-取消开批"         ; semi:hasState 22 .
semi:CompleteLotOp    a semi:LotOperationType ; rdfs:label "23-批次完结"         ; semi:hasState 23 .

