  "business_rules": [
    {
      "rule_id": "BR-001",
      "name": "WIP统计口径",
      "description": "WIP（在制品）以wafer为统计粒度，不以lot为单位。正确SQL：SELECT p.name, COUNT(DISTINCT w.id) AS wip_wafer_count FROM matrix_routerx_operation_lot_wafer w JOIN matrix_routerx_operation_lot lot ON w.lot_id = lot.id JOIN matrix_routerx_config_process p ON lot.process_id = p.id WHERE lot.status = 50 GROUP BY p.id, p.name。lot.status=50 表示加工中批次；lot.process_id 关联当前所在站点。process_status 是 status=50 下的加工子状态（0待进站/50已进站/100执行中/150待出站/200已出站），统计WIP时通常不需要过滤process_status。",
      "applies_to_classes": [
        "semi:Wafer",
        "semi:ProductionLot",
        "semi:ProcessStation"
      ]
    },
    {
      "rule_id": "BR-002",
      "name": "Route嵌套工序解析",
      "description": "routerx_router_config.processes 是jsonb数组，内含有序process_id列表，需 JSON_TABLE 或应用层解析生成有序工序列。查询'某路线包含哪些工序'时需 JSON_EXTRACT 展开。",
      "applies_to_classes": [
        "semi:Route",
        "semi:ProcessStation"
      ]
    },
    {
      "rule_id": "BR-003",
      "name": "产品→产品模型的两跳关联",
      "description": "matrix_routerx_operation_lot 记录的 product_id 指向 product 表（产品实例），而非 product_model。查询产品模型时需两跳：matrix_routerx_operation_lot.product_id→product.id→product.product_model_id→product_model.id。",
      "applies_to_classes": [
        "semi:ProductionLot",
        "semi:Product",
        "semi:ProductModel"
      ]
    },
    {
      "rule_id": "BR-004",
      "name": "Carrier与批次的关联粒度",
      "description": "MySQL中carrier与批次关联为批次(lot)粒度，非晶圆槽位粒度。carrier.lot_code和carrier.sub_lot_code冗余存储关联批次。无wafer_carrier_contents 等槽位明细表。",
      "applies_to_classes": [
        "semi:Carrier",
        "semi:ProductionLot"
      ]
    }
  ]
}