{
  "version": "2026-V3",
  "customer": "Prod_cc_semi_mvp",
  "description": "半导体CIM本体→MySQL本地库物理表映射字典（TTL-first，v3全量对齐semi-cim-ontology.ttl）",
  "object_mappings": [
    {
      "logic_class": "semi:Wafer",
      "physical_table": "matrix_routerx_operation_lot_wafer",
      "primary_key": null,
      "label_cn": "晶圆",
      "display_column": "wafer_code",
      "properties": {},
      "key_columns": [
        "id",
        "wafer_code",
        "carrier_code",
        "slot_no",
        "lot_id",
        "sub_lot_id",
        "flags",
        "status",
        "level",
        "ng_code",
        "mark",
        "create_user_id",
        "update_user_id",
        "create_time",
        "update_time",
        "extra",
        "create_user",
        "gmt_create",
        "update_user",
        "gmt_update",
        "deleted",
        "trace_id",
        "sequence",
        "block_id"
      ],
      "note": "MySQL生产执行层晶圆级跟踪表，生产流转以批次(lot)为最小管理单元，wafer在生产流转节点中规属于某个特定生产批次。晶圆实体信息在仓库域：warehouse_approval_wafer（入库）、warehouse_approval_wafer_record（入库记录）"
    },
    {
      "logic_class": "semi:ProductionLot",
      "physical_table": "matrix_routerx_operation_lot",
      "primary_key": "id",
      "label_cn": "生产批次",
      "display_column": "current_lot_code",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "current_lot_code",
        "parent_id",
        "parent_lot_code",
        "product_snapshot_id",
        "product_id",
        "product_code",
        "recipe_id",
        "recipe_code",
        "main_router_id",
        "sub_routers",
        "process_id",
        "process_status",
        "process_route_id",
        "status",
        "carrier_code",
        "wafer_statistics",
        "equipment_id",
        "equipment_code",
        "chamber",
        "type",
        "create_user_id",
        "update_user_id",
        "create_time",
        "update_time",
        "extra",
        "create_user",
        "gmt_create",
        "update_user",
        "gmt_update",
        "deleted",
        "trace_id",
        "bind_production_scheduling",
        "order_id"
      ]
    },
    {
      "logic_class": "semi:Sublot",
      "physical_table": "matrix_routerx_operation_lot",
      "primary_key": "id",
      "label_cn": "子批次",
      "display_column": "current_lot_code",
      "filter_condition": "parent_id != 0",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "current_lot_code",
        "parent_id",
        "parent_lot_code",
        "product_id",
        "process_id",
        "process_status",
        "status",
        "carrier_code",
        "gmt_create"
      ],
      "note": "Sublot与ProductionLot共用同一张物理表 matrix_routerx_operation_lot，通过 parent_id 区分：parent_id=0 为主批次(ProductionLot)，parent_id!=0 为子批次(Sublot)，值为所属主批次的id。加工以子批次为单位，process_id 指向当前所处工艺站点。"
    },
    {
      "logic_class": "semi:ProcessStation",
      "physical_table": "matrix_routerx_config_process",
      "primary_key": "id",
      "label_cn": "工艺站点(工序)",
      "display_column": "name",
      "properties": {},
      "key_columns": [
        "id",
        "name",
        "code",
        "type",
        "description",
        "version",
        "equipment_group_list",
        "recipe_group_id",
        "process_data_group_list",
        "measurement_data_group_list",
        "load_carrier_group_id",
        "unload_carrier_group_id",
        "gmt_create"
      ]
    },
    {
      "logic_class": "semi:Equipment",
      "physical_table": "equipment",
      "primary_key": "id",
      "label_cn": "设备",
      "display_column": "name",
      "properties": {
        "semi:hasState": "status",
        "semi:isQualified": null
      },
      "key_columns": [
        "id",
        "name",
        "code",
        "status",
        "classify_id",
        "description",
        "station_id",
        "gmt_create"
      ],
      "note": "status: 0=CLOSE(停用), 1=OPEN(启用)。sys_eqpinfo_tree 是设备树结构表，用于层级展示，不是设备实体表。"
    },
    {
      "logic_class": "semi:Carrier",
      "physical_table": "carrier",
      "primary_key": "id",
      "label_cn": "载具",
      "display_column": "code",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "code",
        "status",
        "smif_pod_code",
        "sub_lot_code",
        "lot_code",
        "gmt_create",
        "gmt_update"
      ]
    },
    {
      "logic_class": "semi:Route",
      "physical_table": "routerx_router_config",
      "primary_key": "id",
      "label_cn": "工艺路径",
      "display_column": "name",
      "properties": {},
      "key_columns": [
        "id",
        "name",
        "code",
        "description",
        "route_type",
        "processes",
        "gateways",
        "flows",
        "version_n",
        "gmt_create",
        "gmt_update"
      ],
      "note": "processes/gateways/flows 为jsonb字段，嵌入工序节点的有序引用（process_id列表）。"
    },
    {
      "logic_class": "semi:ProductModel",
      "physical_table": "product_model",
      "primary_key": "id",
      "label_cn": "产品模型",
      "display_column": "name",
      "properties": {
        "semi:hasState": "product_status"
      },
      "key_columns": [
        "id",
        "name",
        "code",
        "material_id",
        "product_status",
        "version_n",
        "route_id",
        "recipe_id",
        "gmt_create",
        "gmt_update"
      ],
      "note": "product_status: 0=草稿, 1=待审核, 2=激活/在产。material_id→material.id 关联物料主数据；route_id→routerx_router_config.id 关联工艺路线。"
    },
    {
      "logic_class": "semi:ProductionOrder",
      "physical_table": "production_scheduling",
      "primary_key": "id",
      "label_cn": "生产工单/排程",
      "display_column": "schedule_no",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "schedule_no",
        "classify_id",
        "classify_type",
        "status",
        "product_id",
        "product_code",
        "total_qty",
        "plan_start_time",
        "plan_end_time",
        "gmt_create"
      ]
    },
    {
      "logic_class": "semi:BOM",
      "physical_table": "product_bom",
      "primary_key": "id",
      "label_cn": "物料清单(BOM)",
      "display_column": "name",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "name",
        "code",
        "material_id",
        "status",
        "version_n",
        "gmt_create",
        "gmt_update"
      ],
      "note": "status: 0=失效, 1=生效。material_id→material.id 关联产品物料。product_bom_material 是BOM下的物料明细行表。"
    },
    {
      "logic_class": "semi:Recipe",
      "physical_table": "recipe_manage",
      "primary_key": "id",
      "label_cn": "配方",
      "display_column": "name",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "name",
        "code",
        "status",
        "description",
        "equipment_list",
        "version_n",
        "gmt_create",
        "gmt_update"
      ],
      "note": "equipment_list 为jsonb数组，记录该配方可运行的设备ID列表。recipe_group_id 在 matrix_routerx_config_process 中引用配方组。"
    },
    {
      "logic_class": "semi:Material",
      "physical_table": "material",
      "primary_key": "id",
      "label_cn": "物料主数据",
      "display_column": "name",
      "properties": {},
      "key_columns": [
        "id",
        "name",
        "code",
        "material_type",
        "material_type_id",
        "spec",
        "unit",
        "classify_id",
        "status",
        "gmt_create"
      ],
      "note": "通用物料主数据表，通过 material_type 区分子类（原料/辅料/备件等）。"
    },
    {
      "logic_class": "semi:RawMaterial",
      "physical_table": "material",
      "primary_key": "id",
      "label_cn": "原料",
      "display_column": "name",
      "filter_condition": "material_type IN ('raw', 'wafer', '原料', '硅片')",
      "properties": {},
      "key_columns": [
        "id",
        "name",
        "code",
        "material_type",
        "spec",
        "unit",
        "classify_id",
        "status"
      ],
      "note": "使用 material 表，通过 material_type 筛选原料类型行。具体枚举值需对照实际数据库中的 material_type 字段值确认。"
    },
    {
      "logic_class": "semi:Auxiliary",
      "physical_table": "accy_model",
      "primary_key": "id",
      "label_cn": "辅料主数据",
      "display_column": "name",
      "properties": {
        "semi:hasState": "status"
      },
      "key_columns": [
        "id",
        "name",
        "code",
        "status",
        "accy_type",
        "spec",
        "unit",
        "classify_id",
        "gmt_create"
      ],
      "note": "accy_model 是辅料主数据定义表（型号/规格）。accy_accessory 是辅料实体上机记录，status:0=待上机,1=上机中,2=退库待确认,3=已退库。"
    },
    {
      "logic_class": "semi:SparePart",
      "physical_table": "material",
      "primary_key": "id",
      "label_cn": "备件",
      "display_column": "name",
      "filter_condition": "material_type IN ('spare_part', 'spare', '备件')",
      "properties": {},
      "key_columns": [
        "id",
        "name",
        "code",
        "material_type",
        "spec",
        "unit",
        "classify_id",
        "status"
      ],
      "note": "使用 material 表，通过 material_type 筛选备件类型行。如存在独立备件表则优先使用。"
    },
    {
      "logic_class": "semi:ProcessConstraint",
      "physical_table": null,
      "primary_key": null,
      "label_cn": "工艺约束",
      "display_column": null,
      "virtual": true,
      "properties": {},
      "note": "中间类。在MySQL中约束信息分散：product_model 中的 recipe_id（工序默认配方），matrix_routerx_config_process 中的 equipment_group_list/recipe_group_id。无单独工艺约束表。",
      "key_columns": []
    },
    {
      "logic_class": "semi:Product",
      "physical_table": "product",
      "primary_key": "id",
      "label_cn": "产品",
      "display_column": "name",
      "properties": {},
      "key_columns": [
        "id",
        "name",
        "code",
        "material_id",
        "product_model_id",
        "status",
        "gmt_create"
      ],
      "note": "product 是具体的产品实体或型号记录。通过 product_model_id 关联 product_model（semi:ProductModel）。routerx_lot.product_id → product.id。"
    },
    {
      "logic_class": "semi:Action",
      "physical_table": "routerx_lot_log",
      "primary_key": "id",
      "label_cn": "生产动作/操作日志",
      "display_column": "operation_type",
      "properties": {},
      "key_columns": [
        "id",
        "lot_id",
        "lot_code",
        "operation_type",
        "station_id",
        "equipment_id",
        "product_id",
        "operator_id",
        "before_state",
        "after_state",
        "gmt_create"
      ],
      "note": "批次流水表，记录批次进站/出站/拆批/并批/Hold/Release等所有操作历史。追加写入不可变。"
    }
  ],
  "relation_mappings": [
    {
      "logic_relation": "semi:belongsToLot",
      "description": "Wafer 属于哪个 ProductionLot",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "matrix_routerx_operation_lot_wafer",
        "source_key": "lot_id",
        "target_key": "id",
        "target_table": "matrix_routerx_operation_lot"
      }
    },
    {
      "logic_relation": "semi:belongsToSublot",
      "description": "Wafer 属于哪个 Sublot（子批次）",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "matrix_routerx_operation_lot_wafer",
        "source_key": "sub_lot_id",
        "target_table": "matrix_routerx_operation_lot",
        "target_key": "id",
        "note": "matrix_routerx_operation_lot_wafer.sub_lot_id → matrix_routerx_operation_lot.id（WHERE parent_id != 0）"
      }
    },
    {
      "logic_relation": "semi:locatedInSlot",
      "description": "Wafer 位于哪个 Carrier 槽位 — 虚拟关系",
      "strategy": "Virtual",
      "join_logic": {
        "note": "Wafer在MySQL生产执行层为虚拟类。Carrier与批次关联：carrier.lot_code = routerx_lot.lot_code（批次整体粒度）。"
      }
    },
    {
      "logic_relation": "semi:atStation",
      "description": "Sublot 当前所处工艺站点（加工以子批次为单位）",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "matrix_routerx_operation_lot",
        "source_key": "process_id",
        "target_table": "matrix_routerx_config_process",
        "target_key": "id",
        "note": "Sublot与ProductionLot同表，process_id 存储当前所处站点。路径：Wafer.sub_lot_id → lot.id（Sublot）→ lot.process_id → process.id（ProcessStation）"
      }
    },
    {
      "logic_relation": "semi:currentlyFollowsModel",
      "description": "Lot 当前遵循的 ProductModel — 通过 product→product_model",
      "strategy": "Indirect",
      "join_logic": {
        "path": [
          {
            "from_table": "matrix_routerx_operation_lot",
            "from_key": "product_id",
            "to_table": "product",
            "to_key": "id"
          },
          {
            "from_table": "product",
            "from_key": "product_model_id",
            "to_table": "product_model",
            "to_key": "id"
          }
        ],
        "note": "matrix_routerx_operation_lot.product_id → product.id → product.product_model_id → product_model.id"
      }
    },
    {
      "logic_relation": "semi:currentlyOnRoute",
      "description": "Lot 当前所走工艺路径",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "matrix_routerx_operation_lot",
        "source_key": "process_route_id",
        "target_table": "routerx_router_config",
        "target_key": "id",
        "note": "matrix_routerx_operation_lot.process_route_id → routerx_router_config.id"
      }
    },
    {
      "logic_relation": "semi:basedOnOrder",
      "description": "Lot(批次) 基于哪个 ProductionOrder(排程工单) 创建",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "matrix_routerx_operation_lot",
        "source_key": "order_id",
        "target_table": "production_scheduling",
        "target_key": "id",
        "note": "matrix_routerx_operation_lot.order_id → production_scheduling.id"
      }
    },
    {
      "logic_relation": "semi:definesRequirementFor",
      "description": "ProductionOrder(排程) 定义了哪个 ProductModel",
      "strategy": "Indirect",
      "join_logic": {
        "path": [
          {
            "from_table": "production_scheduling",
            "from_key": "product_id",
            "to_table": "product",
            "to_key": "id"
          },
          {
            "from_table": "product",
            "from_key": "product_model_id",
            "to_table": "product_model",
            "to_key": "id"
          }
        ]
      }
    },
    {
      "logic_relation": "semi:containsSublot",
      "description": "Lot(批次) 包含哪些 Sublot(local_production_batch)",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "matrix_routerx_operation_lot",
        "source_key": "id",
        "target_table": "local_production_batch",
        "target_key": "lot_id"
      }
    },
    {
      "logic_relation": "semi:isCarriedBy",
      "description": "批次由哪个 Carrier(载具) 承载",
      "strategy": "Denormalized",
      "join_logic": {
        "source_table": "carrier",
        "source_key": "lot_code",
        "target_table": "matrix_routerx_operation_lot",
        "target_key": "current_lot_code",
        "note": "carrier.lot_code 冗余存储关联的批次号。matrix_routerx_operation_lot.current_lot_code 为批次号。批次粒度关联，非晶圆粒度。"
      }
    },
    {
      "logic_relation": "semi:usesRoute",
      "description": "ProductModel 使用哪条 Route(工艺路径)",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "product_model",
        "source_key": "route_id",
        "target_table": "routerx_router_config",
        "target_key": "id"
      }
    },
    {
      "logic_relation": "semi:consistsOfStation",
      "description": "Route 包含哪些 ProcessStation(工序)，有序嵌入JSON",
      "strategy": "EmbeddedJSON",
      "join_logic": {
        "source_table": "routerx_router_config",
        "jsonb_column": "processes",
        "inner_key": "process_id",
        "target_table": "matrix_routerx_config_process",
        "target_key": "id",
        "note": "routerx_router_config.processes 是jsonb数组，每项含 process_id 引用 matrix_routerx_config_process.id，顺序即工序序列。"
      }
    },
    {
      "logic_relation": "semi:requiresEquipment",
      "description": "ProcessStation 要求哪些 Equipment(设备) 执行",
      "strategy": "EmbeddedJSON",
      "join_logic": {
        "source_table": "matrix_routerx_config_process",
        "jsonb_column": "equipment_group_list",
        "target_table": "equipment",
        "target_key": "classify_id",
        "note": "equipment_group_list 是jsonb数组，存储设备分类组ID，通过 equipment.classify_id 关联。"
      }
    },
    {
      "logic_relation": "semi:hostsRecipe",
      "description": "Equipment 关联哪个 Recipe(配方)",
      "strategy": "EmbeddedJSON",
      "join_logic": {
        "source_table": "recipe_manage",
        "jsonb_column": "equipment_list",
        "target_table": "equipment",
        "target_key": "id",
        "note": "反向：recipe_manage.equipment_list jsonb数组记录可运行该配方的设备ID。正向：equipment→recipe关联需通过 matrix_routerx_config_process.recipe_group_id 或 product_model.recipe_id 间接推导。"
      }
    },
    {
      "logic_relation": "semi:hasBOM",
      "description": "ProductModel 关联哪个 BOM",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "product_model",
        "source_key": "material_id",
        "target_table": "product_bom",
        "target_key": "material_id",
        "note": "product_model.material_id 与 product_bom.material_id 通过相同物料ID关联，同时过滤 product_bom.status=1(生效)"
      }
    },
    {
      "logic_relation": "semi:consumesRawMaterial",
      "description": "BOM 消耗哪些原料 — 通过 product_bom_material 明细行",
      "strategy": "JoinTable",
      "join_logic": {
        "bridge_table": "product_bom_material",
        "source_table": "product_bom",
        "source_pk": "id",
        "source_key": "bom_id",
        "target_table": "material",
        "target_pk": "id",
        "target_key": "material_id",
        "filter_condition": "material.material_type IN ('raw', 'wafer', '原料')",
        "note": "product_bom_material 连接bom与物料，通过 material.material_type 筛选原料类型"
      }
    },
    {
      "logic_relation": "semi:consumesAuxiliary",
      "description": "BOM 消耗哪些辅料 — 通过 product_bom_material 关联 accy_model",
      "strategy": "JoinTable",
      "join_logic": {
        "bridge_table": "product_bom_material",
        "source_table": "product_bom",
        "source_pk": "id",
        "source_key": "bom_id",
        "target_table": "accy_model",
        "target_pk": "id",
        "target_key": "material_id",
        "note": "若辅料主数据在 material 表则使用 material_type筛选；若在 accy_model 则通过 material_id 关联。"
      }
    },
    {
      "logic_relation": "semi:requiresSparePart",
      "description": "Equipment 需要哪些备件 — 通过 material 表筛选备件类型",
      "strategy": "Virtual",
      "join_logic": {
        "note": "MySQL中设备与备件的直接关联关系未明确定义。可通过 material 表 material_type='spare_part' 以及设备维修记录间接推导，暂标记为虚拟关系。"
      }
    },
    {
      "logic_relation": "semi:hasConstraint",
      "description": "ProductModel 注入 ProcessConstraint — 通过 product_model 配置字段",
      "strategy": "Virtual",
      "join_logic": {
        "note": "MySQL中工艺约束嵌入在 product_model（含route_id/recipe_id）和 matrix_routerx_config_process（含equipment_group_list/recipe_group_id）中。ProcessConstraint是虚拟中间类，无独立表。"
      }
    },
    {
      "logic_relation": "semi:appliesAtStation",
      "description": "ProcessConstraint 应用于哪个 ProcessStation",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "matrix_routerx_config_process",
        "source_key": "id",
        "target_table": "matrix_routerx_config_process",
        "target_key": "id",
        "note": "ProcessConstraint在MySQL中直接体现为 matrix_routerx_config_process 行本身，无需跨表JOIN。"
      }
    },
    {
      "logic_relation": "semi:specifiesRecipe",
      "description": "ProcessConstraint 在该工序指定 Recipe",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "matrix_routerx_config_process",
        "source_key": "recipe_group_id",
        "target_table": "recipe_manage",
        "target_key": "id",
        "note": "matrix_routerx_config_process.recipe_group_id → recipe_manage.id，指定此工序使用的配方组。"
      }
    },
    {
      "logic_relation": "semi:isDefinedBy",
      "description": "Product(产品实例) 由 ProductModel 定义",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "product",
        "source_key": "product_model_id",
        "target_table": "product_model",
        "target_key": "id"
      }
    },
    {
      "logic_relation": "semi:anchoredAtStation",
      "description": "BOM 物料消耗锚定到哪个 ProcessStation",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "product_bom_material",
        "source_key": "station_id",
        "target_table": "matrix_routerx_config_process",
        "target_key": "id",
        "note": "若 product_bom_material 含 station_id 字段则直接关联；否则此关系虚拟（待确认字段）。"
      }
    },
    {
      "logic_relation": "semi:hasInput",
      "description": "Action(操作日志) 的输入 Lot",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "routerx_lot_log",
        "source_key": "lot_id",
        "target_table": "matrix_routerx_operation_lot",
        "target_key": "id"
      }
    },
    {
      "logic_relation": "semi:hasOutput",
      "description": "Action(操作日志) 的输出结果 — 状态变迁记录",
      "strategy": "Denormalized",
      "join_logic": {
        "source_table": "routerx_lot_log",
        "output_field": "after_state",
        "note": "routerx_lot_log.after_state 记录操作后批次的新状态；before_state 记录操作前状态。"
      }
    },
    {
      "logic_relation": "semi:modifiesStateVector",
      "description": "Action(操作日志) 修改 Lot 状态向量",
      "strategy": "ForeignKey",
      "join_logic": {
        "source_table": "routerx_lot_log",
        "source_key": "lot_id",
        "target_table": "matrix_routerx_operation_lot",
        "target_key": "id",
        "note": "routerx_lot_log记录的每条操作行为都对应 matrix_routerx_operation_lot 的状态跳转（status变化）"
      }
    },
    {
      "logic_relation": "semi:hasParentLot",
      "description": "Lot 的父批次(溯源递归)",
      "strategy": "Recursive",
      "join_logic": {
        "table": "matrix_routerx_operation_lot",
        "self_key": "id",
        "parent_key": "parent_id",
        "max_depth": 20,
        "note": "需要 WITH RECURSIVE CTE（MySQL 8.0+支持）; parent_lot_id 为自引用外键（如不存在则此关系虚拟，需确认字段）。"
      }
    }
  ],
